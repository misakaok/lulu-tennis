<view class="page dp-page">
  <view wx:if="{{error}}" class="card dp-err">
    <image class="empty-art" src="/images/art-net.png" mode="aspectFit" />
    <view class="dp-err-t">{{error}}</view>
    <view class="btn-line small" hover-class="tap-on" bindtap="goBack">返回活动</view>
  </view>

  <block wx:elif="{{ready}}">
    <!-- 分组类活动可切换「完整版 / 精简版」 -->
    <view wx:if="{{hasGroups}}" class="seg dp-seg has-thumb">
      <view class="seg-track"><view class="seg-thumb" style="width:50%;transform:translateX({{compact ? 100 : 0}}%)" /></view>
      <view class="seg-item {{!compact ? 'on' : ''}}" data-v="0" bindtap="setCompact">完整版（含组内对阵）</view>
      <view class="seg-item {{compact ? 'on' : ''}}" data-v="1" bindtap="setCompact">精简版（仅看排名）</view>
    </view>

    <!-- 顶部操作条（放在画布上方，避免原生画布遮挡按钮） -->
    <view class="dp-bar">
      <view class="btn-line dp-btn {{canSave ? '' : 'disabled'}}" hover-class="tap-on" bindtap="previewPoster">全屏预览</view>
      <view class="btn-primary dp-btn {{canSave ? '' : 'disabled'}}" hover-class="tap-on" bindtap="savePoster">保存到相册</view>
    </view>

    <view class="dp-hint">
      <text class="dp-h-t">{{drawTitle}} · {{statusText}}</text>
    </view>

    <!-- 高清画布预览区（高度按实际内容精准自适应） -->
    <view class="dp-stage" style="height:{{cvH}}rpx" bindtap="previewPoster">
      <!-- 两块画布轮流用：上面那块显示着，新版在下面被盖住的那块画好再换上来（不盖「生成中」遮罩、不淡出淡入，切换完全不闪） -->
      <canvas type="2d" id="dp-cv-0" class="dp-cv {{front === 0 ? 'front' : 'back'}}" style="height:{{cvHs[0]}}rpx"></canvas>
      <canvas type="2d" id="dp-cv-1" class="dp-cv {{front === 1 ? 'front' : 'back'}}" style="height:{{cvHs[1]}}rpx"></canvas>
    </view>

    <!-- 滑到最底也能顺手保存 -->
    <view class="btn-primary dp-foot-btn {{canSave ? '' : 'disabled'}}" hover-class="tap-on" bindtap="savePoster">保存到相册发群</view>
  </block>
</view>
