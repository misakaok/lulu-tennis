.dp-page { padding: 24rpx 32rpx 64rpx; }

.dp-err { text-align: center; padding: 64rpx 36rpx; }
.dp-err-t { font-size: 27rpx; color: #5C5C76; line-height: 1.5; }

.dp-seg { margin-bottom: 18rpx; }

.dp-bar { display: flex; margin-bottom: 18rpx; }
.dp-btn { flex: 1; height: 80rpx; line-height: 80rpx; font-size: 28rpx; }
.btn-line.dp-btn { line-height: 74rpx; margin-right: 18rpx; }

.dp-hint { display: flex; align-items: baseline; justify-content: space-between; margin: 0 4rpx 14rpx; }
.dp-h-t { flex: 1; min-width: 0; font-size: 24rpx; font-weight: 700; color: #4F4F7D; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin-right: 12rpx; }
.dp-h-s { flex: none; font-size: 20rpx; color: #84849E; }

.dp-stage {
  position: relative; width: 686rpx; border-radius: 28rpx; overflow: hidden;
  background: #ECECF6;
  box-shadow: 0 8rpx 22rpx rgba(84, 84, 146, 0.12), 0 22rpx 46rpx rgba(84, 84, 146, 0.14);
}
.dp-cv { width: 686rpx; display: block; }
/* 切换完整版 / 精简版：淡出 0.14s（页面等 FADE_MS 再重画），画好淡入 0.22s；只动 opacity */
.dp-cv-wrap { opacity: 1; transition: opacity 0.22s cubic-bezier(0.22, 1, 0.36, 1); }
.dp-cv-wrap.fade { opacity: 0; transition-duration: 0.14s; }

.dp-foot-btn { margin-top: 26rpx; }
