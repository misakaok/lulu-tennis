.hero {
  position: relative; overflow: hidden; border-radius: 36rpx; padding: 30rpx 28rpx 26rpx; margin-bottom: 24rpx; color: #fff;
  background: linear-gradient(148deg, #A6A6CE 0%, #8484B6 100%);
  box-shadow: 0 16rpx 36rpx rgba(110, 110, 163, 0.28), inset 0 1rpx 0 rgba(255, 255, 255, 0.4);
}
.hero-top { display: flex; align-items: center; justify-content: space-between; font-size: 22rpx; opacity: 0.9; }
.hero-k { font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 400rpx; }
.hero-s { font-size: 20rpx; opacity: 0.82; }
.hero-main { display: flex; align-items: center; margin-top: 24rpx; }
.hm-col { flex: 1; text-align: center; }
.hm-bl { border-left: 1rpx solid rgba(255, 255, 255, 0.2); }
.hm-lbl { font-size: 22rpx; opacity: 0.88; }
.hm-val { margin-top: 6rpx; font-size: 64rpx; font-weight: 900; line-height: 1.05; letter-spacing: -0.03em; }
.hm-y { font-size: 34rpx; font-weight: 700; margin-right: 4rpx; opacity: 0.9; }
.hero-foot {
  margin-top: 22rpx; padding: 12rpx 18rpx; border-radius: 20rpx; text-align: center; font-size: 22rpx;
  background: rgba(56, 54, 108, 0.16); border: 1rpx solid rgba(255, 255, 255, 0.22);
}

.row { display: flex; align-items: center; justify-content: space-between; }
.f-row { display: flex; align-items: center; justify-content: space-between; padding: 18rpx 0; }
.f-row + .f-row { border-top: 1rpx solid #F0F0F7; }
.f-row:last-child { padding-bottom: 0; }
.f-l { font-size: 27rpx; font-weight: 600; color: #323252; }
.f-in-w { display: flex; align-items: center; background: #F5F5FA; border-radius: 16rpx; padding: 0 18rpx; height: 68rpx; width: 220rpx; box-sizing: border-box; }
.f-y { font-size: 26rpx; font-weight: 700; color: #84849E; margin-right: 6rpx; }
.f-in { flex: 1; min-width: 0; text-align: right; font-size: 32rpx; font-weight: 800; color: #2E2E4A; }
.f-ph { color: #B8B8CE; font-weight: 400; font-size: 24rpx; }

.can-row { margin: 4rpx 0 14rpx; }
.can-k { display: block; font-size: 21rpx; color: #84849E; margin-bottom: 10rpx; }
.can-list { display: flex; margin: 0 -5rpx; }
.can { flex: 1; margin: 0 5rpx; height: 54rpx; line-height: 54rpx; text-align: center; border-radius: 14rpx; font-size: 22rpx; font-weight: 600; color: #6E6EA3; background: #F3F3F9; }
.can.on { background: #C9E33A; color: #2E3600; font-weight: 800; }

.p-row { display: flex; align-items: center; justify-content: space-between; padding: 16rpx 0; }
.p-row + .p-row { border-top: 1rpx solid #F0F0F7; }
.p-row:last-child { padding-bottom: 0; }
.p-t { font-size: 27rpx; font-weight: 700; color: #323252; }
.p-s { margin-top: 4rpx; font-size: 21rpx; color: #84849E; }
.stepper { display: flex; align-items: center; }
.st-b { width: 60rpx; height: 60rpx; line-height: 58rpx; text-align: center; border-radius: 16rpx; font-size: 32rpx; font-weight: 700; color: #6E6EA3; background: #EFEFF7; }
.st-in { width: 76rpx; height: 60rpx; text-align: center; font-size: 32rpx; font-weight: 800; color: #2E2E4A; }

.m-row { margin-top: 16rpx; padding-top: 18rpx; border-top: 1rpx solid #F0F0F7; }
.m-l { display: block; font-size: 23rpx; color: #70708C; margin-bottom: 12rpx; }
.m-seg { margin-top: 0; }

.bill-box {
  padding: 20rpx 22rpx; border-radius: 18rpx; background: #F7F7FC;
  font-size: 24rpx; line-height: 1.7; color: #3A3A58; white-space: pre-wrap;
}
.foot-tip { margin-top: 20rpx; text-align: center; font-size: 21rpx; color: #84849E; }
