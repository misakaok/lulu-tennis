.hero {
  border-radius: 36rpx; padding: 30rpx 26rpx 26rpx; margin-bottom: 24rpx; color: #fff;
  background: linear-gradient(148deg, #A6A6CE 0%, #8484B6 100%);
  box-shadow: 0 16rpx 36rpx rgba(110, 110, 163, 0.28), inset 0 1rpx 0 rgba(255, 255, 255, 0.4);
}
.hero-top { display: flex; align-items: center; justify-content: space-between; }
.hero-k { font-size: 23rpx; font-weight: 700; opacity: 0.92; }
.hero-tag { padding: 4rpx 16rpx; border-radius: 16rpx; font-size: 21rpx; font-weight: 800; background: #C9E33A; color: #2E3600; }
.hero-grid { display: flex; margin-top: 24rpx; }
.hg { flex: 1; text-align: center; }
.hg-bl { border-left: 1rpx solid rgba(255, 255, 255, 0.2); }
.hg-n { font-size: 46rpx; font-weight: 900; line-height: 1.08; }
.hg-u { font-size: 22rpx; font-weight: 700; margin-left: 3rpx; opacity: 0.88; }
.hg-l { margin-top: 6rpx; font-size: 20rpx; opacity: 0.88; }
.hero-feel {
  margin-top: 22rpx; padding: 12rpx 18rpx; border-radius: 18rpx; text-align: center; font-size: 22rpx; line-height: 1.5;
  background: rgba(56, 54, 108, 0.16); border: 1rpx solid rgba(255, 255, 255, 0.22);
}

/* 纯矢量俯视球拍配重示意图 */
.diag-card { padding: 24rpx; }
.diag-wrap { position: relative; height: 210rpx; }
.diag-rk {
  position: absolute; left: 50%; top: 50%; width: 420rpx; height: 140rpx; margin: -70rpx 0 0 -210rpx;
  background: url("data:image/svg+xml;base64,") center / 100% 100% no-repeat;
}
.spot {
  position: absolute; padding: 4rpx 14rpx; border-radius: 14rpx; font-size: 20rpx; font-weight: 700;
  color: #70708C; background: #EFEFF7; border: 1rpx solid rgba(132, 132, 182, 0.22); white-space: nowrap;
}
.spot.on { background: #C9E33A; color: #2E3600; border-color: #A4BE18; box-shadow: 0 4rpx 12rpx rgba(164, 190, 24, 0.28); }
.s-top { left: 26rpx; top: 84rpx; }
.s-left { left: 176rpx; top: 8rpx; }
.s-right { left: 162rpx; bottom: 8rpx; }
.s-throat { left: 312rpx; top: 84rpx; }
.s-handle { right: 20rpx; top: 18rpx; }

.row { display: flex; align-items: center; justify-content: space-between; }
.ps-row { display: flex; margin: 0 -5rpx 18rpx; }
.ps { flex: 1; margin: 0 5rpx; height: 56rpx; line-height: 56rpx; text-align: center; border-radius: 14rpx; font-size: 21rpx; font-weight: 700; color: #6E6EA3; background: #F3F3F9; }
.ps.on { background: #8484B6; color: #fff; }
.b-grid { display: flex; margin: 0 -8rpx; }
.b-item { flex: 1; margin: 0 8rpx; padding: 14rpx 18rpx; border-radius: 18rpx; background: #F6F6FB; }
.b-l { display: block; font-size: 21rpx; color: #70708C; }
.b-in { margin-top: 6rpx; font-size: 34rpx; font-weight: 900; color: #2E2E4A; height: 48rpx; }

.sp-row { display: flex; align-items: center; justify-content: space-between; padding: 18rpx 0; }
.sp-row + .sp-row { border-top: 1rpx solid #F0F0F7; }
.sp-row:last-child { padding-bottom: 0; }
.sp-m { flex: 1; min-width: 0; margin-right: 12rpx; }
.sp-t { font-size: 26rpx; font-weight: 700; color: #2E2E4A; }
.sp-s { margin-top: 4rpx; font-size: 20rpx; color: #84849E; line-height: 1.4; }
.sp-ctrl { flex: none; display: flex; align-items: center; }
.sp-b { width: 54rpx; height: 54rpx; line-height: 54rpx; text-align: center; border-radius: 14rpx; font-size: 22rpx; font-weight: 800; color: #6E6EA3; background: #EFEFF7; }
.sp-b.hi { margin-left: 8rpx; background: #E9F5BE; color: #3D5600; }
.sp-v { width: 72rpx; text-align: center; font-size: 26rpx; font-weight: 800; color: #2E2E4A; }
