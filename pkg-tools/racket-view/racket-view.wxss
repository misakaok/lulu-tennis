.state { text-align: center; color: #84849E; font-size: 26rpx; padding: 120rpx 0; }
.state-card { text-align: center; padding: 50rpx 30rpx; }
.state-t { font-size: 28rpx; font-weight: 700; color: #4F4F7D; margin-bottom: 28rpx; }
.retry { width: 240rpx; margin: 0 auto; }

.hero { border-radius: 36rpx; padding: 30rpx 30rpx 24rpx; margin-bottom: 24rpx; color: #fff; background: linear-gradient(150deg, #A3A3CB, #8484B6); box-shadow: 0 12rpx 28rpx rgba(133, 133, 184, 0.3); }
.hero-top { display: flex; align-items: center; }
.hero-no { font-size: 24rpx; font-weight: 800; background: rgba(255, 255, 255, 0.22); border-radius: 12rpx; padding: 2rpx 14rpx; }
.hero-st { margin-left: 14rpx; font-size: 22rpx; opacity: 0.9; }
.hero-name { font-size: 44rpx; font-weight: 800; margin-top: 12rpx; }
.hero-sub { display: flex; flex-wrap: wrap; align-items: center; font-size: 22rpx; opacity: 0.92; margin-top: 8rpx; }
.hero-tag { margin-left: 12rpx; background: rgba(255, 255, 255, 0.18); border-radius: 12rpx; padding: 0 12rpx; }
.hero-row { display: flex; margin-top: 24rpx; padding-top: 18rpx; border-top: 1rpx solid rgba(255, 255, 255, 0.3); }
.hc { flex: 1; text-align: center; }
.hc-n { font-size: 38rpx; font-weight: 800; }
.hc-l { font-size: 21rpx; opacity: 0.88; margin-top: 2rpx; }

.acts { display: flex; margin-bottom: 24rpx; }
.act { flex: 1; }
.act + .act { margin-left: 20rpx; }
.acts .btn-primary { height: 84rpx; line-height: 84rpx; font-size: 28rpx; }

.none { font-size: 24rpx; color: #84849E; padding: 12rpx 0; line-height: 1.6; }
.rm { display: flex; align-items: center; padding: 16rpx 0; font-size: 25rpx; }
.rm + .rm { border-top: 1rpx solid #F2F2F8; } /* 分隔线只画在两行之间，第一行上面不画（见 tests/review-surface.test.js） */
.rm:last-child { padding-bottom: 0; } /* 卡片最后一行：下边距不叠在卡片内边距上（否则底部比顶部多出一截留白） */
.rm-l { width: 110rpx; font-weight: 700; flex: none; }
.rm-e { color: #70708C; font-size: 22rpx; flex: none; width: 140rpx; }
.rm-d { flex: 1; color: #5C5C76; font-size: 22rpx; }
.rm-s { flex: none; }

.tl-seg { margin-bottom: 14rpx; }
.tl-i { display: flex; padding: 16rpx 0; }
.tl-i + .tl-i { border-top: 1rpx solid #F2F2F8; } /* 分隔线只画在两行之间，第一行上面不画（见 tests/review-surface.test.js） */
.tl-i:last-child { padding-bottom: 0; } /* 卡片最后一行：下边距不叠在卡片内边距上（否则底部比顶部多出一截留白） */
.tl-dot { width: 18rpx; height: 18rpx; border-radius: 50%; margin: 10rpx 18rpx 0 4rpx; flex: none; background: #B9B9DA; }
.tl-dot.string { background: #8484B6; }
.tl-b { flex: 1; min-width: 0; }
.tl-top { display: flex; align-items: center; font-size: 22rpx; color: #70708C; }
.tl-k { margin-left: 12rpx; color: #6E6EA3; font-weight: 600; }
.tl-cost { margin-left: auto; color: #5C5C76; font-weight: 700; }
.tl-t { font-size: 27rpx; font-weight: 700; margin-top: 4rpx; color: #2E2E4A; }
.tl-s { font-size: 23rpx; color: #5C5C76; margin-top: 2rpx; }
.tl-feel { margin-left: 14rpx; color: #8484B6; letter-spacing: 2rpx; }
.tl-tags { display: flex; flex-wrap: wrap; margin-top: 4rpx; }
.tl-tag { font-size: 20rpx; color: #70708C; margin-right: 12rpx; }
.hero-head { display: flex; align-items: center; }
.hero-info { flex: 1; min-width: 0; }
/* 球线使用时长（使用记录） */
.pl-head { display: flex; align-items: center; justify-content: space-between; }
.pl-top { display: flex; align-items: flex-end; justify-content: space-between; }
.pl-n { display: flex; align-items: baseline; }
.pl-big { font-size: 56rpx; font-weight: 800; color: #2E2E4A; line-height: 1; }
.pl-u { font-size: 24rpx; color: #5C5C76; margin-left: 8rpx; }
.pl-goal { font-size: 24rpx; color: #70708C; margin-left: 12rpx; }
.pl-bar { height: 14rpx; border-radius: 7rpx; background: #EFEFF6; margin-top: 18rpx; overflow: hidden; }
.pl-fill { height: 100%; border-radius: 7rpx; background: #A3A3CB; }
.pl-fill.soon { background: #E0B34A; }
.pl-fill.over { background: #b34d4d; }
.pl-s { font-size: 22rpx; color: #70708C; margin-top: 10rpx; line-height: 1.5; }
.pl-list { margin-top: 10rpx; }
.pl-i { display: flex; align-items: center; padding: 16rpx 0; font-size: 25rpx; }
.pl-i + .pl-i { border-top: 1rpx solid #F2F2F8; } /* 分隔线只画在两行之间，第一行上面不画（见 tests/review-surface.test.js） */
.pl-i:last-child { padding-bottom: 0; } /* 卡片最后一行：下边距不叠在卡片内边距上 */
.pl-i.old { color: #84849E; }
.pl-d { width: 200rpx; color: #5C5C76; }
.pl-i.old .pl-d { color: #84849E; }
.pl-m { flex: 1; font-weight: 700; }
.pl-o { font-size: 21rpx; color: #84849E; }
.pl-more { margin-top: 20rpx; }
/* 记一次打球的弹层（同活动详情的单场安排弹层） */
.sheet-mask { position: fixed; left: 0; right: 0; top: 0; bottom: 0; background: rgba(30, 30, 50, 0.45); z-index: 20; }
.sheet { position: fixed; left: 0; right: 0; bottom: 0; z-index: 21; background: #fff; border-radius: 32rpx 32rpx 0 0; padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom)); }
.sheet-t { font-size: 32rpx; font-weight: 800; color: #2E2E4A; }
.sheet-s { margin: 6rpx 0 16rpx; font-size: 24rpx; color: #70708C; }
.sheet-row { display: flex; align-items: center; justify-content: space-between; height: 92rpx; border-top: 1rpx solid #F2F2F8; }
.sheet-pick { font-size: 28rpx; color: #2E2E4A; }
.sheet-note { margin-top: 12rpx; font-size: 22rpx; color: #84849E; line-height: 1.5; }
.sheet-acts { display: flex; margin: 24rpx -8rpx 0; }
.sheet-a { flex: 1; margin: 0 8rpx; height: 84rpx; border-radius: 42rpx; font-size: 28rpx; }
.pl-in-r { display: flex; align-items: center; }
.pl-in { width: 200rpx; text-align: right; font-size: 30rpx; font-weight: 700; color: #2E2E4A; }
.pl-ph { color: #B7B7CC; font-weight: 400; }
.pl-unit { margin-left: 8rpx; font-size: 26rpx; color: #70708C; }
.qk { display: flex; flex-wrap: wrap; margin-top: 8rpx; }
.qk-i { font-size: 25rpx; color: #5C5C76; background: #F4F4F9; border: 2rpx solid transparent; border-radius: 30rpx; padding: 10rpx 24rpx; margin: 0 14rpx 14rpx 0; }
.qk-i.on { color: #6E6EA3; background: #EFEFF6; border-color: #A3A3CB; font-weight: 700; }
.hero-ph { width: 168rpx; height: 168rpx; border-radius: 28rpx; margin-left: 20rpx; background: rgba(255, 255, 255, 0.92); }
