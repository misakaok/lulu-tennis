page { background: #F0F0F7 linear-gradient(180deg, #ECECF7 0%, #F0F0F7 480rpx) no-repeat; background-size: 100% 480rpx; }
.page { position: relative; z-index: 0; }
.page::before {
  content: ''; position: absolute; left: 0; right: 0; top: 0; height: 220rpx; pointer-events: none; z-index: -1;
  border-radius: 0 0 50% 50% / 0 0 42rpx 42rpx;
  background: linear-gradient(180deg, #A3A3CB 0%, #C4C4E1 18%, #E2E2F2 68%, #ECECF7 100%);
}
.top-seg { margin-bottom: 18rpx; }

.hero {
  position: relative; overflow: hidden;
  border-radius: 36rpx; padding: 28rpx 28rpx 26rpx; margin-bottom: 22rpx; color: #fff;
  background: linear-gradient(148deg, #A6A6CE 0%, #8484B6 100%);
  box-shadow: 0 16rpx 36rpx rgba(110, 110, 163, 0.28);
}
.hero::before {
  content: ''; position: absolute; left: 0; right: 0; top: 0; bottom: 0;
  border-radius: inherit; pointer-events: none; z-index: 0;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.14) 0%, rgba(255, 255, 255, 0) 46%, rgba(56, 54, 108, 0.16) 100%);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.44), inset 0 0 0 1rpx rgba(255, 255, 255, 0.18);
}
.hero-in { position: relative; z-index: 1; }
.hero-top { display: flex; align-items: center; justify-content: space-between; }
.hero-k { font-size: 24rpx; font-weight: 800; opacity: 0.94; }
.hero-btn {
  padding: 6rpx 18rpx; border-radius: 999rpx; font-size: 21rpx; font-weight: 700; color: #fff;
  background: rgba(255, 255, 255, 0.20); border: 1rpx solid rgba(255, 255, 255, 0.36);
}
.hero-badge { padding: 4rpx 16rpx; border-radius: 16rpx; font-size: 20rpx; font-weight: 800; background: #C9E33A; color: #2E3600; }
.hero-grid {
  display: flex; margin-top: 20rpx; padding: 16rpx 0; border-radius: 22rpx;
  background: rgba(56, 54, 108, 0.16); border: 1rpx solid rgba(255, 255, 255, 0.22);
}
.hg { flex: 1; text-align: center; }
.hg-bl { border-left: 1rpx solid rgba(255, 255, 255, 0.18); }
.hg-n { font-size: 40rpx; font-weight: 900; line-height: 1.1; }
.hg-n.hi { color: #E2F86A; }
.hg-l { margin-top: 4rpx; font-size: 20rpx; opacity: 0.86; }
.hero-note { margin-top: 14rpx; font-size: 21rpx; line-height: 1.5; color: rgba(255, 255, 255, 0.92); }

.row-t { display: flex; align-items: baseline; justify-content: space-between; }
.sub-t { font-size: 21rpx; color: #6E6EA3; font-weight: 600; }
.muted { padding: 24rpx 0; text-align: center; font-size: 23rpx; color: #84849E; }

/* 1. 球线寿命窗口对比 */
.win-grid { display: flex; margin: 0 -8rpx; }
.win-box { flex: 1; margin: 0 8rpx; padding: 20rpx 18rpx; border-radius: 22rpx; text-align: center; background: #F7F7FC; }
.win-box.fresh { background: linear-gradient(160deg, #F6FCE1 0%, #F7F7FC 100%); border: 1rpx solid rgba(164, 190, 24, 0.26); }
.win-box.worn { border: 1rpx solid #EAEAF4; }
.wb-tag { font-size: 21rpx; font-weight: 700; color: #5C5C76; }
.wb-rate { margin-top: 8rpx; font-size: 44rpx; font-weight: 900; color: #2E2E4A; line-height: 1.1; }
.win-box.fresh .wb-rate { color: #4A6400; }
.wb-sub { margin-top: 8rpx; font-size: 20rpx; color: #70708C; }
.tip-line { margin-top: 14rpx; font-size: 20rpx; color: #84849E; line-height: 1.5; }

/* 各球拍表现 */
.rk-row { display: flex; align-items: center; padding: 18rpx 0; }
.rk-row + .rk-row { border-top: 1rpx solid #F2F2F8; }
.rk-row:last-child { padding-bottom: 0; }
.rk-row.off { opacity: 0.62; }
.rk-ico { width: 84rpx; height: 84rpx; border-radius: 18rpx; margin-right: 16rpx; background: #F5F5FC; flex: none; }
.rk-m { flex: 1; min-width: 0; margin-right: 12rpx; }
.rk-t { display: flex; align-items: center; }
.rk-no { padding: 2rpx 10rpx; border-radius: 8rpx; font-size: 19rpx; font-weight: 700; color: #6E6EA3; background: #EFEFF7; margin-right: 8rpx; flex: none; }
.rk-nm { font-size: 26rpx; font-weight: 800; color: #2E2E4A; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.rk-s { margin-top: 5rpx; font-size: 21rpx; color: #5C5C76; }
.rk-s.dim { color: #84849E; font-size: 20rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.rk-r { flex: none; text-align: right; }
.rk-rate { display: block; font-size: 34rpx; font-weight: 900; color: #4F4F7D; line-height: 1.05; }
.rk-rate.none { color: #C2C2D6; font-weight: 600; }
.rk-pl { display: block; margin-top: 4rpx; font-size: 20rpx; color: #84849E; }

/* 球线表 */
.st-row { display: flex; align-items: center; padding: 16rpx 0; }
.st-row + .st-row { border-top: 1rpx solid #F2F2F8; }
.st-row:last-child { padding-bottom: 0; }
.st-m { flex: 1; min-width: 0; margin-right: 12rpx; }
.st-nm { font-size: 25rpx; font-weight: 700; color: #2E2E4A; }
.st-sub { margin-top: 4rpx; font-size: 20rpx; color: #70708C; }
.st-r { flex: none; text-align: right; }
.st-rate { display: block; font-size: 30rpx; font-weight: 900; color: #4F4F7D; }
.st-rate.none { color: #C2C2D6; font-weight: 600; }
.st-pl { display: block; font-size: 19rpx; color: #84849E; }

/* 2. 双拍对比 */
.cmp-pair { display: flex; align-items: center; }
.cmp-side { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: center; }
.cmp-badge { padding: 3rpx 16rpx; border-radius: 12rpx; font-size: 20rpx; font-weight: 800; color: #fff; background: #8484B6; }
.cmp-badge.b { background: #5E7A00; }
.cmp-art { width: 124rpx; height: 124rpx; margin: 12rpx 0 8rpx; border-radius: 24rpx; background: #F7F7FC; }
.cmp-nm { max-width: 240rpx; font-size: 24rpx; font-weight: 800; color: #2E2E4A; text-align: center; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.cmp-picks { display: flex; margin-top: 10rpx; }
.cp-btn { margin: 0 4rpx; padding: 6rpx 16rpx; border-radius: 14rpx; font-size: 20rpx; font-weight: 700; color: #6E6EA3; background: #EFEFF8; transition: transform 0.14s ease, opacity 0.14s ease; }
.cmp-vs { flex: none; width: 58rpx; text-align: center; font-size: 26rpx; font-weight: 900; color: #B6B6CE; }

.cmp-table { margin-top: 22rpx; padding-top: 8rpx; border-top: 1rpx solid #EFEFF6; }
.ct-row { display: flex; align-items: center; padding: 14rpx 0; }
.ct-row + .ct-row { border-top: 1rpx solid #F2F2F8; }
.ct-row:last-child { padding-bottom: 0; }
.ct-v { width: 140rpx; flex: none; font-size: 26rpx; font-weight: 800; color: #4F4F7D; }
.ct-v.right { text-align: right; }
.ct-v.hi { color: #4A6400; }
.ct-mid { flex: 1; text-align: center; }
.ct-k { display: block; font-size: 22rpx; font-weight: 700; color: #2E2E4A; }
.ct-d { display: block; margin-top: 2rpx; font-size: 19rpx; color: #84849E; }
.cmp-tips { margin-top: 18rpx; padding: 14rpx 18rpx; border-radius: 18rpx; background: #F6F6FC; }
.cmp-tip { font-size: 21rpx; color: #5C5C76; line-height: 1.55; }

.ed-cols { display: flex; margin: 0 -10rpx; }
.ed-col { flex: 1; min-width: 0; margin: 0 10rpx; padding: 16rpx; border-radius: 20rpx; background: #F7F7FC; }
.ed-hd { font-size: 22rpx; font-weight: 800; color: #6E6EA3; margin-bottom: 10rpx; }
.ed-hd.b { color: #587400; }
.ed-f, .ed-lead { display: flex; align-items: center; justify-content: space-between; padding: 10rpx 0; }
.ed-l { font-size: 21rpx; color: #70708C; }
.ed-in { width: 116rpx; height: 54rpx; padding: 0 12rpx; border-radius: 12rpx; background: #fff; border: 1rpx solid #E6E6F2; box-sizing: border-box; text-align: right; font-size: 25rpx; font-weight: 800; color: #2E2E4A; }
.ed-pk { display: inline-block; padding: 6rpx 14rpx; border-radius: 12rpx; background: #fff; border: 1rpx solid #E6E6F2; font-size: 22rpx; font-weight: 700; color: #4F4F7D; }
.ld-c { display: flex; align-items: center; }
.ld-b { width: 48rpx; height: 48rpx; line-height: 48rpx; text-align: center; border-radius: 12rpx; background: #EAEAF6; color: #4F4F7D; font-weight: 800; font-size: 26rpx; transition: transform 0.14s ease, opacity 0.14s ease; }
.ld-v { min-width: 56rpx; text-align: center; font-size: 23rpx; font-weight: 800; color: #2E2E4A; }

/* 3. 磅数参考 */
.ten-big { display: flex; align-items: baseline; justify-content: center; margin-top: 18rpx; }
.ten-n { font-size: 80rpx; font-weight: 900; line-height: 1; color: #E2F86A; }
.ten-u { margin-left: 10rpx; font-size: 26rpx; font-weight: 700; opacity: 0.88; }
.ten-split { margin-top: 10rpx; text-align: center; font-size: 24rpx; font-weight: 700; color: #fff; }
.ten-notes {
  margin-top: 18rpx; padding: 14rpx 18rpx; border-radius: 18rpx;
  background: rgba(56, 54, 108, 0.18); border: 1rpx solid rgba(255, 255, 255, 0.22);
}
.ten-note { font-size: 21rpx; line-height: 1.55; color: rgba(255, 255, 255, 0.92); }
.t-sec + .t-sec { margin-top: 22rpx; padding-top: 18rpx; border-top: 1rpx solid #F2F2F8; }
.t-lbl { font-size: 24rpx; font-weight: 800; color: #323252; margin-bottom: 12rpx; }
.pills { display: flex; flex-wrap: wrap; margin: 0 -6rpx -10rpx; }
.pill {
  margin: 0 6rpx 10rpx; padding: 12rpx 22rpx; border-radius: 16rpx; font-size: 22rpx; font-weight: 600;
  color: #5C5C76; background: #F3F3F9; border: 2rpx solid transparent;
  transition: transform 0.14s ease, background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
}
.pill.on { background: #F1F1F8; border-color: #A3A3CB; color: #4F4F7D; font-weight: 800; }
