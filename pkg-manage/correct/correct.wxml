<view class="page">
  <view wx:if="{{loading}}" class="muted"></view>
  <view wx:elif="{{error}}" class="empty"><image class="empty-art" src="/images/art-ball.png" mode="aspectFit" /><view>{{error}}</view></view>
  <block wx:else>
    <view class="card">
      <view class="c-vs">{{aLabel}} <text class="c-x">vs</text> {{bLabel}}</view>
      <view class="c-cur">原比分：{{current}}</view>
      <view class="c-rule">本场规则：{{ruleText}}（自动沿用）</view>
    </view>
    <view class="card">
      <view class="card-title">{{mode === 'edit' ? '修改后的比分' : '正确的比分'}}</view>
      <score-sets set-games="{{setGames}}" no-ad="{{noAd}}" best-of="{{bestOf}}" a-label="{{aLabel}}" b-label="{{bLabel}}" init="{{init}}" bind:change="onSets" />
      <view class="result {{check.ok ? 'ok' : ''}}">{{check.msg}}</view>
    </view>
    <view wx:if="{{mode === 'request'}}" class="card">
      <view class="card-title">修改原因<text class="sub">必选，对方和活动发起人会看到</text></view>
      <view class="c-reasons">
        <view wx:for="{{reasons}}" wx:key="*this" class="c-reason {{reason === item ? 'on' : ''}}" data-v="{{item}}" bindtap="onReason">{{item}}</view>
      </view>
    </view>
    <view class="note">{{mode === 'edit' ? '改完后直接生效，战绩、排名和水平分随之更新。' : mode === 'admin' ? '管理员更正后新比分直接生效，不需要双方再确认，战绩、排名、水平分和活动后面的对阵随之更新；这场待处理的改分申请会失效。' : '对方同意后才生效，拒绝则保留原比分；活动比赛也可以由发起人裁定。处理之前，正式战绩、排名和后面的对阵都不会变。'}}</view>
    <view class="btn-primary {{check.ok && !submitting ? '' : 'disabled'}}" hover-class="tap-on" bindtap="submit">{{submitting ? '提交中…' : (mode === 'edit' ? '保存修改' : mode === 'admin' ? '确认更正' : '提交修改申请')}}</view>
  </block>
</view>
