.hero { display: flex; align-items: center; margin-bottom: 24rpx; padding: 30rpx 0 30rpx 32rpx; border-radius: 36rpx; color: #fff; background: linear-gradient(150deg, #A3A3CB, #8484B6); box-shadow: 0 12rpx 28rpx rgba(133, 133, 184, 0.3); overflow: hidden; }
.hero-main { flex: 1; min-width: 0; }
.hero-k { font-size: 22rpx; opacity: 0.85; }
.hero-t { margin-top: 8rpx; font-size: 34rpx; font-weight: 800; line-height: 1.35; }
.hero-s { margin-top: 8rpx; font-size: 24rpx; opacity: 0.92; }
.hero-art { flex: none; width: 210rpx; height: 148rpx; margin: -10rpx -14rpx -10rpx 8rpx; }
.dup-bar { display: flex; align-items: center; justify-content: space-between; padding: 20rpx 24rpx; }
.dup-m { flex: 1; min-width: 0; margin-right: 16rpx; }
.dup-t { font-size: 25rpx; font-weight: 800; color: #4F4F7D; }
.dup-s { margin-top: 4rpx; font-size: 21rpx; color: #70708C; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.field { margin-top: 26rpx; }
.field.first { margin-top: 0; }
.field .label { display: block; margin-bottom: 14rpx; }
.title-in { height: 80rpx; background: #F7F7FB; border-radius: 18rpx; padding: 0 22rpx; font-size: 30rpx; font-weight: 600; }

/* 选项按文字宽度排，放不下就换行（「1 组（大循环）」这类长文字不会被截断） */
.pills { display: flex; flex-wrap: wrap; margin: 0 -8rpx -16rpx; }
.pill { flex: 1 0 auto; box-sizing: border-box; min-width: 110rpx; padding: 0 20rpx; white-space: nowrap; margin: 0 8rpx 16rpx; height: 72rpx; line-height: 72rpx; text-align: center; border-radius: 18rpx; background: #F2F2F8; font-size: 26rpx; color: #5C5C76; }
/* 选中样式和上面的分段选择（.seg-item.on）一致：淡紫字、浅底，不用深紫实心块 */
.pill { border: 2rpx solid transparent; }
.pill.on { background: #F1F1F8; border-color: #A3A3CB; color: #6E6EA3; font-weight: 700; }

.row { display: flex; justify-content: space-between; align-items: center; }
.links .btn-line { margin-left: 16rpx; }

.chips { display: flex; flex-wrap: wrap; margin: 0 -8rpx; }
.chip { padding: 12rpx 24rpx; margin: 8rpx; border-radius: 30rpx; background: #F2F2F8; font-size: 26rpx; color: #3A3A52; display: flex; align-items: center; }
.chip.on { background: #6E6EA3; color: #fff; }
.chip.seedable { background: #fff; border: 2rpx solid #E3E3EF; }
.chip.seeded { background: #6E6EA3; border-color: #6E6EA3; color: #fff; font-weight: 700; }
.badge { width: 34rpx; height: 34rpx; line-height: 34rpx; border-radius: 50%; background: #fff; color: #6E6EA3; font-weight: 700; font-size: 20rpx; text-align: center; margin-right: 10rpx; }
.muted { color: #84849E; font-size: 24rpx; padding: 8rpx; }
.muted.small { font-size: 22rpx; margin-top: 10rpx; }

.info { margin-top: 18rpx; padding: 16rpx 18rpx; border-radius: 14rpx; background: #F7F7FB; color: #70708C; font-size: 24rpx; }
.info.ok { background: #F1F1F8; color: #6E6EA3; font-weight: 600; }

.seed-list { margin-top: 14rpx; background: #F1F1F8; border-radius: 16rpx; padding: 6rpx 20rpx; }
.seed-row { display: flex; align-items: center; height: 64rpx; }
.seed-row + .seed-row { border-top: 1rpx solid #E3E3EF; }
.seed-no { width: 150rpx; font-size: 24rpx; color: #6E6EA3; font-weight: 700; }
.seed-name { flex: 1; font-size: 28rpx; font-weight: 600; }

.preview { margin-top: 36rpx; }
.manual-start { margin-top: 16rpx; text-align: center; }
.manual-row { display: flex; align-items: center; gap: 16rpx; min-height: 70rpx; }
.manual-no { width: 98rpx; flex: none; font-size: 24rpx; color: #6E6EA3; }
.manual-name { flex: 1; min-width: 0; overflow-wrap: anywhere; font-size: 28rpx; font-weight: 600; }
.manual-row .muted { flex: none; }
.preview-title { font-size: 32rpx; font-weight: 800; color: #4F4F7D; margin: 0 4rpx 18rpx; }
.actions { display: flex; align-items: center; margin-top: 24rpx; }
/* 和右边的主按钮一样高 */
.btn-line.redo { flex: none; width: 200rpx; height: 96rpx; line-height: 90rpx; border-radius: 48rpx; margin-right: 20rpx; font-size: 30rpx; }
.grow { flex: 1; }

.seg.locked { opacity: 0.6; }
.chip-lv { font-size: 20rpx; margin-left: 8rpx; opacity: 0.75; }
.muted.top { margin: -8rpx 0 8rpx; padding: 0; }
.seed-lv { font-size: 22rpx; color: #6E6EA3; font-weight: 700; margin-right: 12rpx; }
.pills.locked { opacity: 0.6; }
.card-title .sub { font-size: 22rpx; color: #70708C; font-weight: 400; margin-left: 12rpx; }
.team-no { font-size: 20rpx; background: #fff; color: #6E6EA3; border-radius: 16rpx; padding: 0 10rpx; margin: 0 10rpx 0 -10rpx; font-weight: 700; }
.team-line { display: flex; align-items: center; height: 64rpx; }
.team-line + .team-line { border-top: 1rpx solid #F2F2F8; } /* 分隔线只画在两行之间，第一行上面不画（见 tests/review-surface.test.js） */
.tl-no { width: 90rpx; font-size: 24rpx; color: #6E6EA3; font-weight: 700; }
.tl-name { flex: 1; font-size: 28rpx; font-weight: 600; }
.stage { margin-top: 28rpx; padding-top: 22rpx; border-top: 1rpx solid #F0F0F6; }
.stage-h { font-size: 27rpx; font-weight: 700; color: #4F4F7D; }
.seg.mini { width: 260rpx; padding: 4rpx; }
.seg.mini .seg-item { padding: 8rpx 0; font-size: 23rpx; }
.round { margin-top: 18rpx; background: #F8F8FC; border-radius: 16rpx; padding: 14rpx 18rpx 16rpx; }
.round-h { display: flex; align-items: center; }
.round-n { font-size: 26rpx; font-weight: 700; width: 140rpx; flex: none; }
.round-t { flex: 1; min-width: 0; font-size: 21rpx; color: #70708C; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.round-sw { transform: scale(0.75); margin-right: -14rpx; }
.sum { margin-top: 26rpx; background: #F1F1F8; border-radius: 16rpx; padding: 16rpx 20rpx; }
.sum-h { font-size: 22rpx; color: #6E6EA3; font-weight: 700; margin-bottom: 6rpx; }
.sum-row { display: flex; font-size: 23rpx; line-height: 1.8; color: #4F4F7D; }
.sum-row.hl { font-weight: 700; }
.sum-k { width: 230rpx; flex: none; color: #70708C; }
.sum-row.hl .sum-k { color: #6E6EA3; }
.sum-v { flex: 1; }
.seg-item.off { color: #B7B7CC; }

/* 计入 LULU 积分：类别说明 / 和活动形式不匹配的提示 */
.cup-n { margin-top: 10rpx; padding: 8rpx; font-size: 22rpx; }
.cup-n.bad { color: #b34d4d; font-weight: 600; }

/* 四人轮换双打：三轮预览 */
.rot-pv { margin-top: 12rpx; }
.rot-pv-r { display: flex; align-items: center; padding: 18rpx 0; }
.rot-pv-r + .rot-pv-r { border-top: 1rpx solid #ECECF5; }
.rot-pv-r:last-child { padding-bottom: 0; }
.rot-pv-n { flex: none; width: 120rpx; font-size: 26rpx; font-weight: 800; color: #6E6EA3; }
.rot-pv-t { flex: 1; font-size: 28rpx; color: #2E2E4A; }
.cup-kinds { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); }
/* 开放报名时先加入的球友（选填）：标题和表单项一样大小，说明一行，右边小按钮 */
.pre-card { padding-top: 26rpx; padding-bottom: 26rpx; }
.pre-head { display: flex; align-items: center; }
.pre-t { flex: 1; min-width: 0; margin-right: 20rpx; }
.pre-h { font-size: 28rpx; font-weight: 600; color: #2E2E4A; }
.pre-opt { margin-left: 12rpx; padding: 2rpx 12rpx; border-radius: 16rpx; background: #F1F1F8; color: #6E6EA3; font-size: 20rpx; font-weight: 500; vertical-align: 2rpx; }
.pre-d { margin-top: 8rpx; font-size: 22rpx; line-height: 1.5; color: #84849E; }
.pre-list { margin-top: 18rpx; padding-top: 4rpx; border-top: 1rpx solid #F2F2F8; }
.pre-row { display: flex; align-items: center; padding: 14rpx 0; font-size: 27rpx; color: #2E2E4A; }
.pre-row + .pre-row { border-top: 1rpx solid #F2F2F8; } /* 分隔线只画在两行之间 */
.pre-row:last-child { padding-bottom: 0; }
.pre-no { width: 44rpx; flex: none; color: #84849E; font-size: 22rpx; font-weight: 700; }
.pre-n { flex: 1; min-width: 0; }
.pre-x { flex: none; padding: 8rpx 4rpx 8rpx 20rpx; font-size: 24rpx; color: #84849E; }
