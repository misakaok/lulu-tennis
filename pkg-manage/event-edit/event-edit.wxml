<view class="page">
  <view wx:if="{{loading}}" class="muted"></view>
  <view wx:elif="{{error}}" class="empty"><image class="empty-art" src="/images/art-ball.png" mode="aspectFit" /><view>{{error}}</view></view>
  <block wx:else>
    <view class="card">
      <view class="ee-row">
        <text class="label">比赛名称</text>
        <input class="ee-in" value="{{title}}" maxlength="20" bindinput="onTitle" placeholder="请输入比赛名称" />
      </view>
      <event-form value="{{value}}" allow-past="{{true}}" bind:change="onInfo" />
    </view>
    <view class="btn-primary {{saving ? 'disabled' : ''}}" hover-class="tap-on" bindtap="save">{{saving ? '保存中…' : '保存'}}</view>
  </block>
</view>
