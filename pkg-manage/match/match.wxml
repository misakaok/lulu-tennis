<view class="page">
  <view wx:if="{{loading}}" class="muted"></view>
  <view wx:elif="{{error}}" class="empty"><image class="empty-art" src="/images/art-ball.png" mode="aspectFit" /><view>{{error}}</view></view>
  <block wx:else>
    <view wx:if="{{status === 'invalid'}}" class="st-tip bad">这条活动比分不是从活动对阵表录入的，不计入战绩</view>

    <!-- 记分牌 -->
    <!-- 背景：俯拍球网竖在正中间，左右两个半场对应两方（pkg-manage/images/bg-score.jpg） -->
    <view class="hero bg-host {{sheen ? 'ani-sheen' : ''}}">
      <image class="bg-img" src="/pkg-manage/images/bg-score.jpg" mode="aspectFill" />
      <view class="hero-top">
        <view class="hero-tag" bindtap="openEvent">{{m.event || '日常比赛'}}{{m.event ? ' ›' : ''}}</view>
        <view class="hero-meta">{{m.date}} · {{m.typeText}} · {{m.format}}</view>
        <view wx:if="{{tags.length}}" class="hero-tags"><text wx:for="{{tags}}" wx:key="k" class="hero-hl {{item.k}}">{{item.t}}</text></view>
      </view>
      <view class="hero-main">
        <view class="hs {{m.winner === 'a' ? 'w' : 'l'}}">
          <view class="hs-avs"><view wx:for="{{m.a}}" wx:key="name" wx:for-item="p" class="hs-av-w" data-uid="{{p.uid}}" bindtap="openPlayer"><pl-av class="hs-av" uid="{{p.uid}}" name="{{p.name}}" /></view></view>
          <view wx:for="{{m.a}}" wx:key="name" wx:for-item="p" class="hs-n" data-uid="{{p.uid}}" bindtap="openPlayer">{{p.name}}<text wx:if="{{p.gender}}" class="gd"> {{p.gender}}</text></view>
          <view class="hs-badge {{m.winner === 'a' ? 'win ani-pop' : ''}}" style="animation-delay:460ms">{{m.winner === 'a' ? '胜' : m.loseText}}</view>
        </view>
        <view class="hero-mid">
          <view class="hero-big num ani-score" style="animation-delay:240ms"><text class="{{m.winner === 'a' ? '' : 'dim'}}">{{m.bigA}}</text><text class="colon">:</text><text class="{{m.winner === 'b' ? '' : 'dim'}}">{{m.bigB}}</text></view>
          <view class="hero-sub">{{m.bigLbl}}</view>
        </view>
        <view class="hs {{m.winner === 'b' ? 'w' : 'l'}}">
          <view class="hs-avs"><view wx:for="{{m.b}}" wx:key="name" wx:for-item="p" class="hs-av-w" data-uid="{{p.uid}}" bindtap="openPlayer"><pl-av class="hs-av" uid="{{p.uid}}" name="{{p.name}}" /></view></view>
          <view wx:for="{{m.b}}" wx:key="name" wx:for-item="p" class="hs-n" data-uid="{{p.uid}}" bindtap="openPlayer">{{p.name}}<text wx:if="{{p.gender}}" class="gd"> {{p.gender}}</text></view>
          <view class="hs-badge {{m.winner === 'b' ? 'win ani-pop' : ''}}" style="animation-delay:460ms">{{m.winner === 'b' ? '胜' : m.loseText}}</view>
        </view>
      </view>
      <!-- 每盘比分 -->
      <view wx:if="{{m.showSets}}" class="hero-sets">
        <view wx:for="{{m.sets}}" wx:key="index" wx:for-item="s" class="hset ani-in" style="animation-delay:{{320 + index * 75}}ms">
          <view class="hset-l">第 {{index + 1}} 盘</view>
          <view class="hset-v num"><text class="{{s.aw ? 'on' : ''}}">{{s.a}}</text><text wx:if="{{s.tbA !== ''}}" class="tb">{{s.tbA}}</text><text class="hset-c">-</text><text class="{{s.bw ? 'on' : ''}}">{{s.b}}</text><text wx:if="{{s.tbB !== ''}}" class="tb">{{s.tbB}}</text></view>
        </view>
      </view>
    </view>

    <!-- 这场为什么涨分 / 掉分：只给本人看自己参加的正式比赛；等级按 0.5 档显示，涨跌只有箭头 -->
    <view wx:if="{{why}}" class="card why">
      <view class="card-title">这场的水平分<text class="sub">只有你自己能看到</text></view>
      <block wx:if="{{why.none}}">
        <view class="why-head"><text class="why-ar">—</text><text class="why-t">{{why.noneTitle}}</text></view>
        <view class="why-none">{{why.none}}</view>
      </block>
      <block wx:else>
        <view class="why-head">
          <text class="why-ar {{why.dir}}">{{why.arrow || '—'}}</text>
          <text class="why-t">{{why.title}}</text>
          <text wx:if="{{why.prov}}" class="ui-tag why-prov">{{why.provText}}</text>
        </view>
        <view class="why-r">{{why.reason}}</view>
        <view class="why-tier">{{why.tierText}}</view>
        <view wx:for="{{why.notes}}" wx:key="*this" class="why-note">{{item}}</view>
        <view class="why-more">
          <view class="btn-line mini" hover-class="tap-on" bindtap="toggleWhy">{{whyOpen ? '收起' : '查看计算'}}</view>
        </view>
        <view wx:if="{{whyOpen}}" class="why-d">
          <view class="why-row"><text class="why-k">实际得局率</text><text class="why-v">{{why.shareText}}</text></view>
          <view class="why-row"><text class="why-k">赛前预期得局率</text><text class="why-v">{{why.expectedText}}</text></view>
          <view class="why-row"><text class="why-k">{{why.double ? '赛前队伍水平（两人平均）' : '赛前水平'}}</text><text class="why-v">{{why.double ? '你们' : '你'}} {{why.mineLv}} · 对方 {{why.oppLv}}</text></view>
          <view class="why-foot">实际得局率高于预期就上升，低于预期就下降。赛前水平按 0.5 档显示，预期按精确的水平分计算。{{why.provNote}}</view>
        </view>
      </block>
    </view>

    <!-- 普通日常比赛：第一帧就用本机身份画好「比分状态」（previewSocial，不淡入），云端 matchState 回来原样替换；
         其他比赛（活动、弃权 / 退赛、管理员更正过的）等云端读完再出来、淡入，免得组件自己再调一次 matchState；
         读的期间不放占位文字（2026-11-25 用户要求） -->
    <view wx:if="{{ready || preset}}" class="{{previewSocial ? '' : 'late'}}"><match-social match-id="{{m._id}}" preset="{{preset}}" revocable="{{revocable}}" bind:revoked="onRevoked" /></view>

    <view wx:if="{{changes.length}}" class="card late">
      <view class="card-title">比分修改记录<text class="sub">{{changes.length}} 次</text></view>
      <view wx:for="{{changes}}" wx:key="i" class="chg">
        <view class="chg-dot"></view>
        <view class="chg-b">
          <view class="chg-t"><text class="chg-w">{{item.text}}</text><text class="chg-d">{{item.when}}</text></view>
          <view class="chg-s"><text class="chg-from">{{item.from}}</text><text class="chg-ar">→</text><text class="b">{{item.to}}</text></view>
        </view>
      </view>
    </view>
  </block>
</view>
