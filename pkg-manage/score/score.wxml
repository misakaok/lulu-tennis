<view class="page">
  <view wx:if="{{loading}}" class="muted center"></view>

  <view wx:elif="{{error}}" class="empty">
    <image class="empty-art" src="/images/art-ball.png" mode="aspectFit" />
    <view>{{error}}</view>
    <view class="btn-primary small" hover-class="tap-on" bindtap="goBack">返回</view>
  </view>

  <block wx:else>
    <!-- 对阵 -->
    <view class="head">
      <view class="h-event">{{title}}</view>
      <view class="h-stage">{{stage}}</view>
      <view wx:if="{{slotText}}" class="h-slot">{{slotText}}</view>
      <view class="vs-row">
        <view class="team {{done && winner === 'a' ? 'win' : ''}}">
          <view class="avs">
            <block wx:for="{{sideA}}" wx:key="name">
              <pl-av class="av init" name="{{item.name}}" />
            </block>
          </view>
          <view class="t-name">{{aLabel}}</view>
          <view wx:if="{{done && winner === 'a'}}" class="t-win">胜</view>
        </view>
        <view class="vs">VS</view>
        <view class="team {{done && winner === 'b' ? 'win' : ''}}">
          <view class="avs">
            <block wx:for="{{sideB}}" wx:key="name">
              <pl-av class="av init" name="{{item.name}}" />
            </block>
          </view>
          <view class="t-name">{{bLabel}}</view>
          <view wx:if="{{done && winner === 'b'}}" class="t-win">胜</view>
        </view>
      </view>
      <view class="h-rules">
        <view class="hr-k">本场规则 · {{ruleStage}}{{ruleCustom ? '（单独设置）' : ''}}</view>
        <view class="hr-v">{{typeText}} · {{ruleText}}</view>
      </view>
    </view>

    <!-- 未开打场次：赛前交手预览 & 水平分模拟 -->
    <view wx:if="{{!done && pre}}" class="card pre-card">
      <view class="pre-hd">
        <text class="card-title pre-title">赛前交手预览</text>
        <text class="pre-h2h">{{pre.h2h.text}}</text>
      </view>
      <view class="pre-vs">
        <view class="pre-sd">
          <view class="pre-lv num">{{pre.aLv}}</view>
          <view class="pre-sub">{{pre.double ? '队伍均值' : '当前水平'}}</view>
          <view wx:if="{{pre.formA.length}}" class="pre-fm">
            <view wx:for="{{pre.formA}}" wx:key="index" class="pre-dot {{item}}">{{item === 'w' ? '胜' : '负'}}</view>
          </view>
        </view>
        <view class="pre-mid">
          <view class="pre-pcts num"><text>{{pre.aSharePct}}%</text><text class="pre-pct-lbl">预期得局</text><text>{{pre.bSharePct}}%</text></view>
          <view class="pre-bar"><view class="pre-fill" style="width:{{pre.aSharePct}}%"></view></view>
        </view>
        <view class="pre-sd r">
          <view class="pre-lv num">{{pre.bLv}}</view>
          <view class="pre-sub">{{pre.double ? '队伍均值' : '当前水平'}}</view>
          <view wx:if="{{pre.formB.length}}" class="pre-fm r">
            <view wx:for="{{pre.formB}}" wx:key="index" class="pre-dot {{item}}">{{item === 'w' ? '胜' : '负'}}</view>
          </view>
        </view>
      </view>
      <view class="pre-out">{{pre.outlook}}</view>

      <view class="sim-tog" bindtap="toggleSim">
        <text class="sim-tog-t">如果这场打成 X:Y，水平分会怎么变？</text>
        <text class="sim-tog-a">{{simOpen ? '收起' : '试算 ›'}}</text>
      </view>
      <view wx:if="{{simOpen && simRes}}" class="sim-box">
        <view class="sim-bar">
          <text class="sim-who">假设局分（{{aLabel}} : {{bLabel}}）· 看 <text class="b">{{simSideLabel}}</text></text>
          <view wx:if="{{simCanSwitch}}" class="sim-sw" bindtap="switchSimSide">换看另一方</view>
        </view>
        <view class="sim-chips">
          <view wx:for="{{pre.presets}}" wx:key="label" class="sim-chip num {{simIdx === index ? 'on' : ''}}" data-i="{{index}}" bindtap="pickSim">{{item.label}}</view>
        </view>
        <view class="sim-res {{simRes.dir}}">
          <view class="sim-res-top">
            <text class="sim-res-t">{{simRes.arrow ? simRes.arrow + ' ' : ''}}{{simRes.title}}</text>
            <text class="sim-res-tier {{simRes.tierUp ? 'up' : ''}} {{simRes.tierDown ? 'down' : ''}}">{{simRes.tierText}}</text>
          </view>
          <view class="sim-res-s">{{simRes.summary}}</view>
          <view class="sim-res-meta">模拟得局 {{simRes.shareText}} · 赛前预期 {{simRes.expectedText}}{{simRes.provText ? ' · ' + simRes.provText : ''}}</view>
        </view>
      </view>
    </view>

    <!-- 已有结果 -->
    <view wx:if="{{done && !editing}}" class="card">
      <view class="card-title">比分</view>
      <view class="res-row head-row">
        <text class="res-name"></text>
        <text wx:for="{{resultSets}}" wx:key="index" class="res-sc">第{{index + 1}}盘</text>
      </view>
      <view class="res-row {{winner === 'a' ? 'w' : ''}}">
        <text class="res-name">{{aLabel}}</text>
        <text wx:for="{{resultSets}}" wx:key="index" class="res-sc {{item.aw ? 'hi' : ''}}">{{item.a}}<text wx:if="{{item.tbA !== ''}}" class="tb">{{item.tbA}}</text></text>
      </view>
      <view class="res-row {{winner === 'b' ? 'w' : ''}}">
        <text class="res-name">{{bLabel}}</text>
        <text wx:for="{{resultSets}}" wx:key="index" class="res-sc {{item.bw ? 'hi' : ''}}">{{item.b}}<text wx:if="{{item.tbB !== ''}}" class="tb">{{item.tbB}}</text></text>
      </view>
      <view wx:if="{{outcomeText}}" class="oc">{{outcomeText}}</view>
      <view wx:if="{{unrated}}" class="oc-n">{{unrated.title}} · {{unrated.text}}</view>
      <view wx:elif="{{!resultSets.length}}" class="muted small">发起人直接判定了胜者，没有局分</view>
      <view class="muted small">比赛日期 {{date}}</view>
    </view>

    <!-- 录分 -->
    <view wx:if="{{editing}}" class="card">
      <view class="line">
        <text class="label">比赛日期</text>
        <picker mode="date" value="{{date}}" end="{{today}}" bindchange="onDate">
          <view class="picker">{{date}} <text class="arrow">›</text></view>
        </picker>
      </view>
      <view wx:if="{{scorerOk}}" class="sc-row">
        <view class="sc-t">打球时可以用场边记分逐分记，打完自动填好局分</view>
        <view class="btn-line mini" hover-class="tap-on" bindtap="openScorer">{{scorerResume ? '继续场边记分' : '场边记分'}}</view>
      </view>
      <view class="card-title top">局分<text class="sub">按本场规则自动设置：{{ruleText}}</text></view>
      <view wx:if="{{fromScorer}}" class="sc-from">已带入场边记分的局分，核对后点「提交比分」才会保存</view>
      <score-sets set-games="{{setGames}}" no-ad="{{noAd}}" best-of="{{bestOf}}" a-label="{{aLabel}}" b-label="{{bLabel}}" init="{{init}}" bind:change="onSets" />
      <view class="result {{check.ok ? 'ok' : ''}}">{{check.msg}}</view>
    </view>

    <!-- 发起人：赛前弃权 / 中途退赛 -->
    <view wx:if="{{isOwner && !retire}}" class="card owner-tools">
      <view class="card-title">发起人处理<text class="sub">必须选择原因，会留档</text></view>
      <view class="ot-acts">
        <view class="btn-line ot-a {{busy ? 'disabled' : ''}}" hover-class="tap-on" bindtap="walkover">判赛前弃权</view>
        <view class="btn-line ot-a {{busy ? 'disabled' : ''}}" hover-class="tap-on" bindtap="retireStart">记录中途退赛</view>
      </view>
      <view class="muted small">弃权不填局分，另一方进入下一轮，标「弃权胜 / 弃权负」；中途退赛保留实际已打的局分。</view>
    </view>
    <view wx:if="{{retire}}" class="card">
      <view class="card-title">{{retire.name}} 中途退赛<text class="sub">填实际已打的局分（{{aLabel}} : {{bLabel}}）</text></view>
      <view wx:for="{{retire.sets}}" wx:key="index" class="rt-row">
        <text class="rt-n">第 {{index + 1}} 盘</text>
        <input class="rt-in" type="number" maxlength="2" value="{{item.a}}" data-i="{{index}}" data-k="a" bindinput="retireInput" />
        <text class="rt-c">:</text>
        <input class="rt-in" type="number" maxlength="2" value="{{item.b}}" data-i="{{index}}" data-k="b" bindinput="retireInput" />
      </view>
      <view wx:if="{{retire.sets.length < 3}}" class="rt-add" bindtap="retireAddSet">＋ 再加一盘</view>
      <view class="rt-reason-t">退赛原因（必选）</view>
      <view class="rt-reasons">
        <view wx:for="{{withdrawReasons}}" wx:key="*this" class="rt-reason {{retire.reason === item ? 'on' : ''}}" data-v="{{item}}" bindtap="retireReason">{{item}}</view>
      </view>
      <view class="ot-acts">
        <view class="btn-line ot-a" hover-class="tap-on" bindtap="retireCancel">取消</view>
        <view class="btn-primary ot-a {{busy ? 'disabled' : ''}}" hover-class="tap-on" bindtap="retireSubmit">确认退赛结果</view>
      </view>
    </view>

    <block wx:if="{{editing}}">
      <view class="btn-primary {{check.ok && !submitting ? '' : 'disabled'}}" hover-class="tap-on" bindtap="submit">{{submitting ? '保存中…' : (done ? '保存修改' : '提交比分')}}</view>
      <view wx:if="{{done}}" class="btn-line cancel" hover-class="tap-on" bindtap="cancelEdit">取消修改</view>
      <view class="foot">提交后对阵表、积分榜、排行榜和水平分会自动更新</view>
    </block>
    <view wx:elif="{{done && canEdit}}" class="btn-line edit" hover-class="tap-on" bindtap="startEdit">比分录错了？修改比分</view>
    <match-social wx:if="{{done && !editing && recordId}}" match-id="{{recordId}}" revocable="{{revocable}}" bind:revoked="onRevoked" />
    <view wx:if="{{reason}}" class="foot">{{reason}}</view>
  </block>
</view>

<!-- 录完比赛顺手记入球拍时长弹层（仅本人首次录分且有在役球拍时弹出，纯可选） -->
<view wx:if="{{rkOpen}}" class="rk-mask" catchtap="skipRkLog">
  <view class="rk-sheet" catchtap="noop">
    <view class="rk-hd">
      <text class="rk-t">比分已保存 · 顺手记入球拍时长？</text>
      <text class="rk-x" bindtap="skipRkLog">✕</text>
    </view>
    <view class="rk-s">自动累计到所选球拍本次球线的打球时长（{{rkDate}}）</view>
    <view class="rk-lbl">选择球拍</view>
    <view class="rk-list">
      <view wx:for="{{rkList}}" wx:key="id" class="rk-item {{rkId === item.id ? 'on' : ''}}" data-id="{{item.id}}" bindtap="pickRk">
        <text class="rk-in">{{item.title}}</text>
        <text wx:if="{{item.name}}" class="rk-is">{{item.name}}</text>
      </view>
    </view>
    <view class="rk-lbl">本次打球时长（分钟）</view>
    <view class="rk-mins">
      <view wx:for="{{['30','45','60','90','120']}}" wx:key="*this" class="rk-chip num {{rkMin === item ? 'on' : ''}}" data-m="{{item}}" bindtap="rkMinQuick">{{item}}分</view>
    </view>
    <input class="rk-ipt num" type="number" maxlength="3" value="{{rkMin}}" placeholder="输入 1~600 分钟" bindinput="rkMinInput" />
    <view class="rk-acts">
      <view class="btn-line rk-btn" hover-class="tap-on" bindtap="skipRkLog">暂不记录</view>
      <view class="btn-primary rk-btn {{rkBusy ? 'disabled' : ''}}" hover-class="tap-on" bindtap="saveRkLog">{{rkBusy ? '记录中…' : '记入 +' + (rkMin || '0') + ' 分'}}</view>
    </view>
  </view>
</view>
