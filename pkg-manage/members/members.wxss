.seg { margin-bottom: 20rpx; }
.m-seg .seg-item { padding: 14rpx 2rpx; font-size: 22rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.muted { text-align: center; color: #84849E; font-size: 25rpx; padding: 30rpx 0; }
.card .muted { padding: 10rpx 0; } /* 卡片里的空状态 / 提示：卡片本身有内边距，不再上下各加 30rpx */
.mrow { display: flex; align-items: center; padding: 18rpx 0; }
.mrow + .mrow { border-top: 1rpx solid #F2F2F8; } /* 分隔线只画在两行之间，第一行上面不画（见 tests/review-surface.test.js） */
.mrow:first-child { padding-top: 0; } /* 没有标题的卡片（成员、待审核）：第一行上边距不叠在卡片内边距上 */
.mrow:last-child { padding-bottom: 0; } /* 卡片最后一行：下边距不再叠在卡片内边距上，底部留白和顶部一致 */
.m-main { flex: 1; min-width: 0; }
.m-n { font-size: 28rpx; font-weight: 700; color: #2E2E4A; }
.m-s { margin-top: 4rpx; font-size: 22rpx; color: #70708C; }
.m-tag { margin-left: 10rpx; font-size: 19rpx; color: #fff; background: #6E6EA3; border-radius: 8rpx; padding: 2rpx 10rpx; font-weight: 400; }
.m-a { flex: none; margin-left: 10rpx; padding: 8rpx 20rpx; border-radius: 24rpx; border: 2rpx solid #CFCFE6; color: #6E6EA3; font-size: 23rpx; transition: transform 0.14s ease, opacity 0.14s ease; }
.m-a.main { background: #6E6EA3; color: #fff; border-color: #6E6EA3; }
.m-a.danger { color: #b34d4d; border-color: #e9c9c9; }
.m-ck { width: 40rpx; height: 40rpx; line-height: 40rpx; text-align: center; border-radius: 10rpx; border: 2rpx solid #CFCFE6; margin-right: 16rpx; color: #fff; font-size: 24rpx; }
.m-ck.on { background: #6E6EA3; border-color: #6E6EA3; }
button.m-share { flex: none; margin: 0 0 0 10rpx !important; padding: 0 20rpx !important; height: 52rpx; line-height: 52rpx; font-size: 23rpx; border-radius: 26rpx; background: #6E6EA3; color: #fff; width: auto !important; }
button.m-share::after { border: none; }
.foot { text-align: center; font-size: 21rpx; color: #84849E; margin-top: 20rpx; }

.m-alias { font-size: 22rpx; color: #8C8CA3; font-weight: normal; margin-left: 6rpx; }

.m-g { margin-left: 10rpx; font-size: 19rpx; color: #6E6EA3; background: #F1F1F8; border: 1rpx solid #CFCFE6; border-radius: 8rpx; padding: 2rpx 10rpx; font-weight: 400; } /* 已选的性别：点了可以修改（带 ›） */
.m-gd-tip { display: flex; align-items: center; }

/* 「生成邀请链接」按钮和下面的卡片拉开：按钮带阴影，比卡片之间的 24rpx 再多留一点 */
.m-new { margin-bottom: 32rpx; }
.row-t { display: flex; align-items: center; justify-content: space-between; } /* 卡片标题右边放小按钮 */

/* 运营统计标签页 */
.ops-hero {
  position: relative; overflow: hidden;
  border-radius: 34rpx; padding: 26rpx 24rpx 22rpx; margin-bottom: 18rpx; color: #fff;
  background: linear-gradient(148deg, #A6A6CE 0%, #8484B6 100%);
  box-shadow: 0 14rpx 32rpx rgba(110, 110, 163, 0.26);
}
.ops-hero::before {
  content: ''; position: absolute; left: 0; right: 0; top: 0; bottom: 0;
  border-radius: inherit; pointer-events: none; z-index: 0;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.14) 0%, rgba(255, 255, 255, 0) 46%, rgba(56, 54, 108, 0.16) 100%);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.44), inset 0 0 0 1rpx rgba(255, 255, 255, 0.18);
}
.ops-hin { position: relative; z-index: 1; }
.ops-htop { display: flex; align-items: center; justify-content: space-between; }
.ops-hk { font-size: 24rpx; font-weight: 800; }
.ops-htag { padding: 3rpx 14rpx; border-radius: 14rpx; font-size: 19rpx; font-weight: 700; background: rgba(255, 255, 255, 0.22); }
.ops-hgrid {
  display: flex; margin-top: 18rpx; padding: 14rpx 0; border-radius: 20rpx;
  background: rgba(56, 54, 108, 0.16); border: 1rpx solid rgba(255, 255, 255, 0.22);
}
.ohg { flex: 1; text-align: center; }
.ohg-bl { border-left: 1rpx solid rgba(255, 255, 255, 0.18); }
.ohg-n { font-size: 34rpx; font-weight: 900; line-height: 1.1; }
.ohg-n.hi { color: #E2F86A; }
.ohg-l { margin-top: 4rpx; font-size: 18rpx; opacity: 0.88; }
.ops-sub { margin-bottom: 16rpx; }
.ops-sub-t { font-size: 20rpx; color: #6E6EA3; font-weight: 600; }
.ops-tip { margin-top: 14rpx; font-size: 20rpx; color: #84849E; }

.bk-row { padding: 14rpx 0; }
.bk-row + .bk-row { border-top: 1rpx solid #F2F2F8; }
.bk-row:last-child { padding-bottom: 0; }
.bk-top { display: flex; align-items: baseline; justify-content: space-between; }
.bk-l { font-size: 25rpx; font-weight: 700; color: #2E2E4A; }
.bk-r { font-size: 21rpx; color: #5C5C76; font-weight: 600; }
.bk-bar { height: 12rpx; border-radius: 6rpx; background: #EFEFF7; overflow: hidden; margin-top: 10rpx; }
.bk-fill { height: 100%; border-radius: 6rpx; background: linear-gradient(90deg, #8A8ABA, #B1B1D8); }
.bk-fill.lv { background: linear-gradient(90deg, #A3C61F, #C9E33A); }

.tier-card { padding: 20rpx 12rpx; }
.t-grid { display: flex; }
.tc { flex: 1; text-align: center; padding: 0 6rpx; }
.tc-bl { border-left: 1rpx solid #EFEFF6; }
.tc-n { display: block; font-size: 34rpx; font-weight: 900; color: #4F4F7D; line-height: 1.1; }
.tc-n.hi { color: #587400; }
.tc-n.dim { color: #9A9AB2; }
.tc-l { display: block; margin-top: 6rpx; font-size: 18rpx; color: #70708C; }

.flt-row { white-space: nowrap; margin-bottom: 16rpx; }
.flt { display: inline-block; margin-right: 12rpx; padding: 8rpx 22rpx; border-radius: 24rpx; font-size: 22rpx; color: #6C6C86; background: #E9E9F4; transition: transform 0.14s ease, background-color 0.2s ease, color 0.2s ease; }
.flt.on { background: #8484B6; color: #fff; font-weight: 700; }

.mr-row { display: flex; align-items: center; padding: 16rpx 0; }
.mr-row + .mr-row { border-top: 1rpx solid #F2F2F8; }
.mr-row:last-child { padding-bottom: 0; }
.mr-m { flex: 1; min-width: 0; margin-right: 12rpx; }
.mr-n { font-size: 26rpx; font-weight: 700; color: #2E2E4A; }
.mr-lv { margin-left: 10rpx; padding: 1rpx 10rpx; border-radius: 8rpx; font-size: 19rpx; font-weight: 700; color: #6E6EA3; background: #F1F1F8; }
.mr-s { margin-top: 4rpx; font-size: 20rpx; color: #84849E; }
.mr-r { flex: none; text-align: right; }
.mr-v { display: block; font-size: 23rpx; font-weight: 800; color: #4F4F7D; }
.mr-v2 { display: block; margin-top: 2rpx; font-size: 20rpx; color: #84849E; }

.exp-btns { display: flex; margin: 0 -6rpx 16rpx; }
.exp-b { flex: 1; margin: 0 6rpx; height: 64rpx; line-height: 64rpx; text-align: center; border-radius: 16rpx; font-size: 22rpx; font-weight: 700; color: #5C5C76; background: #F2F2F8; border: 2rpx solid transparent; transition: transform 0.14s ease, background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease; }
.exp-b.on { background: #F1F1F8; border-color: #A3A3CB; color: #4F4F7D; }
.exp-box { max-height: 520rpx; overflow-y: auto; padding: 18rpx 20rpx; border-radius: 18rpx; background: #F7F7FC; border: 1rpx solid #ECECF5; }
.exp-txt { font-size: 21rpx; line-height: 1.65; color: #3A3A52; white-space: pre-wrap; word-break: break-all; }
.exp-copy { margin-top: 22rpx; }
