.line { display: flex; justify-content: space-between; align-items: center; padding-bottom: 20rpx; border-bottom: 1rpx solid #EFEFF6; }
.picker { font-size: 30rpx; font-weight: 600; color: #4F4F7D; }
.arrow { color: #84849E; margin-left: 6rpx; }
.field { margin-top: 24rpx; }
.field .label { display: block; margin-bottom: 14rpx; }

/* 球员 */
.vs-box { display: flex; align-items: center; }
.side { flex: 1; }
.vs { width: 76rpx; text-align: center; font-weight: 900; font-style: italic; color: #6E6EA3; font-size: 32rpx; }
.slot {
  display: flex; align-items: center; justify-content: center;
  height: 84rpx; border-radius: 20rpx; border: 2rpx dashed #D8D8E7; color: #84849E; font-size: 26rpx;
  margin-bottom: 14rpx; padding: 0 14rpx;
}
.slot:last-child { margin-bottom: 0; }
.slot .avatar { margin-right: 12rpx; }
.slot-name { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.slot.filled { border-style: solid; color: #2E2E4A; font-weight: 600; font-size: 28rpx; }
.slot.a.filled { background: #F4F4FA; border-color: #D9D9EC; }
.slot.b.filled { background: #edf6ff; border-color: #b8dbff; }
.slot.active { border: 3rpx solid #6E6EA3; box-shadow: 0 0 0 6rpx rgba(133, 133, 184, 0.12); color: #6E6EA3; }

.chips { display: flex; flex-wrap: wrap; margin: 26rpx -8rpx 0; }
.chip { padding: 12rpx 26rpx; margin: 8rpx; border-radius: 30rpx; background: #F2F2F8; font-size: 26rpx; color: #3A3A52; }
.chip.used { background: #7A7AAE; color: #fff; }
.chips-empty { color: #84849E; font-size: 24rpx; padding: 8rpx; }

.rules-tip { margin-top: 20rpx; font-size: 22rpx; color: #6E6EA3; background: #F1F1F8; border-radius: 12rpx; padding: 12rpx 18rpx; }

.result { margin-top: 20rpx; padding: 18rpx; border-radius: 16rpx; background: #F7F7FB; color: #70708C; font-size: 26rpx; text-align: center; }
.result:empty { display: none; }
.result.ok { background: #F1F1F8; color: #6E6EA3; font-weight: 700; }

.event-tip { margin-bottom: 20rpx; padding: 18rpx 24rpx; border-radius: 18rpx; background: #F1F1F8; color: #6E6EA3; font-size: 23rpx; line-height: 1.6; }
.hero { display: flex; align-items: center; margin-bottom: 20rpx; padding: 28rpx 0 28rpx 32rpx; border-radius: 36rpx; color: #fff; background: linear-gradient(150deg, #A3A3CB, #8484B6); box-shadow: 0 12rpx 28rpx rgba(133, 133, 184, 0.3); overflow: hidden; }
.hero-main { flex: 1; min-width: 0; }
.hero-k { font-size: 22rpx; opacity: 0.85; }
.hero-vs { margin-top: 8rpx; font-size: 36rpx; font-weight: 800; line-height: 1.35; word-break: break-all; }
.hero-x { margin: 0 14rpx; font-size: 24rpx; font-weight: 600; opacity: 0.8; }
.hero-dim { opacity: 0.7; }
.hero-s { margin-top: 8rpx; font-size: 24rpx; opacity: 0.92; }
.hero-art { flex: none; width: 150rpx; height: 150rpx; margin: -12rpx 18rpx -12rpx 12rpx; }
.card.np { color: #6E6EA3; font-weight: 700; font-size: 27rpx; text-align: center; }
.chip { display: flex; align-items: center; }
.chips-note { font-size: 21rpx; color: #84849E; margin-top: 12rpx; }

.chip-g { margin-left: 12rpx; font-size: 20rpx; opacity: 0.65; }
.scorer-tip { margin-bottom: 20rpx; padding: 18rpx 24rpx; border-radius: 18rpx; background: #fff; border: 2rpx solid #D9D9EC; color: #4F4F7D; font-size: 24rpx; line-height: 1.6; }

/* 场边记分入口（和活动录分页同一个样子） */
.sc-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20rpx; padding: 18rpx 20rpx; background: #F4F4F9; border-radius: 20rpx; }
.sc-t { flex: 1; min-width: 0; font-size: 23rpx; color: #5C5C76; line-height: 1.5; margin-right: 16rpx; }
.sc-row .btn-line.mini { flex: none; }

/* 录完顺手记球拍时长弹层 */
.rk-mask { position: fixed; left: 0; right: 0; top: 0; bottom: 0; z-index: 60; background: rgba(34, 34, 62, 0.42); display: flex; align-items: flex-end; }
.rk-sheet { width: 100%; background: #fff; border-radius: 36rpx 36rpx 0 0; padding: 32rpx 32rpx calc(36rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.rk-hd { display: flex; align-items: center; justify-content: space-between; }
.rk-t { font-size: 31rpx; font-weight: 800; color: #2E2E4A; }
.rk-x { width: 52rpx; height: 52rpx; line-height: 52rpx; text-align: center; font-size: 28rpx; color: #84849E; }
.rk-s { margin-top: 6rpx; font-size: 22rpx; color: #70708C; }
.rk-lbl { margin: 22rpx 0 12rpx; font-size: 23rpx; font-weight: 700; color: #5C5C76; }
.rk-list { display: flex; flex-wrap: wrap; margin: 0 -6rpx; }
.rk-item { margin: 0 6rpx 12rpx; padding: 12rpx 20rpx; border-radius: 18rpx; background: #F4F4FA; border: 2rpx solid transparent; }
.rk-item.on { background: #EFEFF9; border-color: #8484B6; }
.rk-in { font-size: 25rpx; font-weight: 800; color: #2E2E4A; }
.rk-is { margin-left: 10rpx; font-size: 21rpx; color: #70708C; }
.rk-mins { display: flex; margin: 0 -6rpx 14rpx; }
.rk-chip { flex: 1; margin: 0 6rpx; height: 60rpx; line-height: 60rpx; text-align: center; border-radius: 16rpx; background: #F4F4FA; font-size: 24rpx; font-weight: 700; color: #5C5C76; }
.rk-chip.on { background: #8484B6; color: #fff; }
.rk-ipt { height: 76rpx; padding: 0 22rpx; border-radius: 18rpx; background: #F6F6FB; font-size: 30rpx; font-weight: 800; color: #2E2E4A; }
.rk-acts { display: flex; margin-top: 26rpx; }
.rk-btn { flex: 1; margin-right: 16rpx; height: 84rpx; line-height: 84rpx; border-radius: 42rpx; font-size: 28rpx; }
.btn-line.rk-btn { line-height: 78rpx; }
.rk-btn:last-child { margin-right: 0; }
