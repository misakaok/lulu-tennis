/*
 * 全局样式（淡紫风格）
 * 颜色：
 *   重点淡紫渐变 #A3A3CB → #8484B6：每页只给最重要的一块用（记分牌、个人卡、领奖台、活动头部）
 *   主题淡紫 #A3A3CB：描边、装饰；紫色文字 #6E6EA3；深紫文字 #4F4F7D
 *   浅紫底 #EFEFF6：标签、选中、次要底色
 *   网球黄绿 #C9E33A（文字 #2E3600）：只用在「胜」「冠军」「报名中」这类正向状态
 *   文字（2026-11-24 精修：去掉「死黑」、户外更清楚）：正文 #2E2E4A（带紫调的深墨）；卡片 / 列表大标题 #323252；
 *     说明 #70708C；更淡的说明 #84849E；故意做淡的状态（未达成、已结束日期、禁用）#A5A5BA / #C5C5DA
 *   红色：危险操作（撤销 / 作废 / 删除）和警示文字统一砖红 #b34d4d；未读数字角标 #D45B5B；其他状态不用红
 */
page {
  background: #F0F0F7; /* 冷雾灰：和白卡拉开层次 */
  color: #2E2E4A;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 28rpx;
}
.page { padding: 24rpx 28rpx 60rpx; }

/* 背景图卡片（界面配图，见 CLAUDE.md「界面配图」）：卡片加 .bg-host，第一个子元素放
   <image class="bg-img" src="/images/xxx.jpg" mode="aspectFill" />；其余内容照常写，会叠在图上面
   （卡片自己是一层，图片 z-index: -1 垫在最下面，卡片里原有的绝对定位装饰照常在图上面）。
   卡片自己的 background 写成和图片相近的颜色，图片还没显示出来时不闪白。 */
.bg-host { position: relative; overflow: hidden; z-index: 0; }
.bg-img { position: absolute; left: 0; top: 0; width: 100%; height: 100%; z-index: -1; }

.card {
  background: #fff;
  border-radius: 36rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  /* 空气感白卡：极细冷紫描边 + 双层阴影（近处收边、远处轻轻散开） */
  border: 1rpx solid rgba(132, 132, 182, 0.14);
  box-shadow: 0 4rpx 12rpx rgba(84, 84, 146, 0.06), 0 16rpx 36rpx rgba(84, 84, 146, 0.09);
}
.card-title { font-size: 32rpx; font-weight: 700; margin-bottom: 20rpx; color: #323252; }
.card-title .sub { font-size: 22rpx; color: #70708C; font-weight: 400; margin-left: 12rpx; }
.label { font-size: 26rpx; color: #6C6C86; }

.seg { display: flex; background: #E9E9F4; border-radius: 24rpx; padding: 6rpx; } /* 底色比页面（#F0F0F7）深一档，凹槽看得出来 */
.seg-item { flex: 1; text-align: center; padding: 14rpx 0; border-radius: 20rpx; font-size: 26rpx; color: #5C5C76; }
.seg-item.on { background: #fff; color: #6E6EA3; font-weight: 600; box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06); }
/* 滑动胶囊：选中的白底是一块单独的滑块，用 transform 平移过去（带一点回弹），不跳变。
   写法：<view class="seg has-thumb"><view class="seg-track"><view class="seg-thumb" style="width:50%;transform:translateX({{idx * 100}}%)"/></view> + 各个 .seg-item</view>
   宽度按项数等分（2 项 50%、3 项 33.3333%）；translateX 的百分比按滑块自己的宽度算，正好一格一格对齐。没改造的 .seg 照旧 */
.seg.has-thumb { position: relative; background: #E9E9F4; }
.seg-track { position: absolute; left: 6rpx; right: 6rpx; top: 6rpx; bottom: 6rpx; pointer-events: none; z-index: 0; }
.seg-thumb { height: 100%; border-radius: 18rpx; background: #fff; box-shadow: 0 4rpx 14rpx rgba(80, 80, 140, 0.14), 0 1rpx 3rpx rgba(80, 80, 140, 0.06); transition: transform 0.42s cubic-bezier(0.34, 1.24, 0.64, 1); } /* 2026-11-25 用户嫌快：0.34s → 0.42s、回弹 1.36 → 1.24 */
.seg.has-thumb .seg-item { position: relative; z-index: 1; background: transparent; box-shadow: none; }

.avatar {
  width: 72rpx; height: 72rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-weight: 700; color: #2E2E4A; font-size: 30rpx; flex: none;
}
.avatar.sm { width: 48rpx; height: 48rpx; font-size: 22rpx; }

/* 按钮只有三种：主按钮（渐变实心）、次按钮（紫色描边）、危险按钮（红色描边） */
.btn-primary {
  height: 96rpx; line-height: 96rpx; text-align: center; border-radius: 48rpx;
  color: #fff; font-size: 32rpx; font-weight: 700;
  background: linear-gradient(150deg, #A3A3CB, #8484B6);
  box-shadow: 0 12rpx 28rpx rgba(133, 133, 184, 0.3);
}
.btn-primary.disabled { opacity: 0.45; box-shadow: none; }
.btn-primary.small { display: inline-block; height: 76rpx; line-height: 76rpx; padding: 0 48rpx; font-size: 28rpx; margin-top: 30rpx; }
.btn-line, .btn-danger {
  height: 84rpx; line-height: 80rpx; text-align: center; border-radius: 42rpx; box-sizing: border-box;
  font-size: 28rpx; font-weight: 600; background: #fff; white-space: nowrap;
}
.btn-line { color: #6E6EA3; border: 3rpx solid #B9B9DA; }
.btn-danger { color: #b34d4d; border: 3rpx solid #E5C4C4; }
/* 小号：卡片标题右边、列表行里的操作（全选、编辑、上移、拒绝 / 同意……），代替文字链接 */
.btn-line.mini, .btn-danger.mini { display: inline-block; height: 52rpx; line-height: 48rpx; padding: 0 22rpx; border-width: 2rpx; border-radius: 26rpx; font-size: 23rpx; font-weight: 600; vertical-align: middle; }
.btn-primary.mini { display: inline-block; height: 52rpx; line-height: 52rpx; padding: 0 24rpx; border-radius: 26rpx; font-size: 23rpx; font-weight: 600; vertical-align: middle; box-shadow: none; }
.btn-line.disabled, .btn-danger.disabled { opacity: 0.45; }

/* 小标签：性别、组别、候补中、定级中…… */
.ui-tag { display: inline-block; padding: 2rpx 14rpx; border-radius: 16rpx; font-size: 22rpx; line-height: 1.6; color: #6E6EA3; background: #EFEFF6; font-weight: 400; }
.ui-tag.lime { color: #2E3600; background: #C9E33A; font-weight: 700; }
.ui-tag.solid { color: #fff; background: #6E6EA3; font-weight: 600; }
.ui-tag.warn { color: #6B5200; background: #FBF0C8; font-weight: 600; }
.ui-tag.bad { color: #b34d4d; background: #F7E9E9; font-weight: 600; }

/* 数字大而粗，说明小而淡 */
.stat-n { font-size: 44rpx; font-weight: 800; line-height: 1.15; }
.stat-l { font-size: 22rpx; color: #70708C; margin-top: 4rpx; }

.empty { text-align: center; color: #70708C; padding: 100rpx 0; font-size: 28rpx; }
/* 空状态插画：<image class="empty-art" src="/images/art-xxx.png" mode="aspectFit" />
   art-ball 通用（没有记录、读取失败）、art-net 活动、art-basket 成长档案、art-trophy 排行榜 */
.empty-art { display: block; width: 180rpx; height: 180rpx; margin: 0 auto 24rpx; }

/* 名字后面的性别（个人资料里填的） */
.gd { font-size: 20rpx; font-weight: 400; color: #8E8EB8; }

/* 记分牌数字：系统自带的窄体数字（iOS 用 DIN Alternate，安卓退回 Roboto Condensed / Roboto，双端观感接近），等宽、略收字距，滚动时不跳宽。
   只靠系统字体，不打包字体文件。超大比分 / 水平分在页面里再收到 -0.03em */
.num { font-family: "DIN Alternate", "Avenir Next Condensed", "Roboto Condensed", -apple-system, Roboto, sans-serif; font-variant-numeric: tabular-nums; letter-spacing: -0.02em; }

/* 小控件切换：底色、文字色平滑过渡（只给分段、筛选这类小块用） */
.seg-item { transition: background-color 0.28s ease, color 0.28s ease, border-color 0.28s ease, box-shadow 0.28s ease; } /* 和滑块差不多同时到（滑块 0.42s，回弹前约 0.28s 到位） */

/*
 * 动画（只用 transform / opacity，都写成全局类，页面和组件直接加类名）
 *   .ani-in      列表行、卡片出现时向上滑入并淡入；用 style="animation-delay:..." 逐行错开，只给前 10 行左右加
 *   .ani-grow-x  横向进度条从 0 拉开；.ani-grow-y 柱子从底部长出来
 *   hover-class="tap-on"      按钮、卡片按下时略微缩小
 *   hover-class="tap-row-on"  卡片里的行按下时变淡（行不缩放）
 *   .ani-pop     奖牌、胜负标签、最近几场胜负球轻轻弹出来（0.55 → 1.1 → 1）
 *   .pulse       「报名中」标签里的呼吸光点（外圈 ::after 放大淡出，一直循环；只给报名中这一种状态用）
 *   .ani-score   记分牌大比分聚焦落位
 *   .ani-sheen   紫色头卡入场时一道高光扫过，只播一次、停在看不见（用 ::after 画，不往卡片里加子元素，
 *                不影响 .bg-host 的第一个子元素 .bg-img；宿主卡片不要再用 ::after）
 *   .ani-wait / .ani-wait-x / .ani-wait-y / .ani-wait-pop   战绩、排行切走后的等待态（和动画起点一样），回到页面换回
 *                .ani-in / .ani-grow-x / .ani-grow-y / .ani-pop 再播一次（见 utils/anim.js 的 leave / enter）；球拍页不重播
 * 缓动统一用「快起慢刹」cubic-bezier(0.22, 1, 0.36, 1)。数字滚动在 utils/anim.js。
 */
/* 入场时长（2026-11-25 用户觉得原来的稍快，统一放慢约 25%）：滑入 0.62s、进度条 0.94s、柱子 0.78s、弹出 0.52s、大比分 0.55s；
   逐行错开每行 0.045～0.062s。按下回弹、分段滑块、场边记分是操作反馈，保持快 */
@keyframes ani-in { from { opacity: 0; transform: translateY(20rpx) scale(0.985); } to { opacity: 1; transform: translateY(0) scale(1); } }
@keyframes ani-grow-x { from { transform: scaleX(0); } to { transform: scaleX(1); } }
@keyframes ani-grow-y { from { transform: scaleY(0); } to { transform: scaleY(1); } }
@keyframes ani-pop { 0% { opacity: 0; transform: scale(0.55); } 60% { opacity: 1; transform: scale(1.1); } 100% { opacity: 1; transform: scale(1); } }
@keyframes ani-pulse { 0% { opacity: 0.7; transform: scale(1); } 100% { opacity: 0; transform: scale(2.2); } }
@keyframes ani-score { from { opacity: 0; transform: translateY(8rpx) scale(0.92); } to { opacity: 1; transform: translateY(0) scale(1); } }
@keyframes ani-sheen { 0% { opacity: 0; transform: translateX(-100%); } 20% { opacity: 1; } 80% { opacity: 1; } 100% { opacity: 0; transform: translateX(100%); } }
.ani-in { animation: ani-in 0.62s cubic-bezier(0.22, 1, 0.36, 1) backwards; }
.ani-grow-x { transform-origin: left center; animation: ani-grow-x 0.94s cubic-bezier(0.22, 1, 0.36, 1) backwards; }
.ani-wait { opacity: 0; transform: translateY(20rpx) scale(0.985); }
.ani-wait-x { transform-origin: left center; transform: scaleX(0); }
.ani-grow-y { transform-origin: center bottom; animation: ani-grow-y 0.78s cubic-bezier(0.22, 1, 0.36, 1) backwards; }
.ani-wait-y { transform-origin: center bottom; transform: scaleY(0); }
.ani-pop { animation: ani-pop 0.52s cubic-bezier(0.22, 1, 0.36, 1) backwards; }
.ani-wait-pop { opacity: 0; transform: scale(0.55); }
/* 换成等待态（切 tab 回来重播前）一下子到位，不走卡片自带的按下回弹过渡：
   否则卡片先往下滑一点、再弹上来，看着像上下弹两下（2026-11-25 用户快速点 tab 时看到） */
.ani-wait, .ani-wait-x, .ani-wait-y, .ani-wait-pop { transition: none !important; }
.ani-score { animation: ani-score 0.55s cubic-bezier(0.22, 1, 0.36, 1) backwards; }
.ani-sheen { position: relative; overflow: hidden; }
.ani-sheen::after {
  content: ''; position: absolute; left: 0; top: 0; right: 0; bottom: 0; pointer-events: none; z-index: 1; opacity: 0;
  background: linear-gradient(112deg, rgba(255, 255, 255, 0) 26%, rgba(255, 255, 255, 0.16) 40%, rgba(255, 255, 255, 0.42) 50%, rgba(255, 255, 255, 0.16) 58%, rgba(255, 255, 255, 0) 70%);
  animation: ani-sheen 1.1s cubic-bezier(0.22, 1, 0.36, 1) 0.15s both;
}
/* 呼吸光点：实心小圆 + 外圈放大淡出（用 <view class="pulse">，不用 <text>，避免小程序 wx-text 下空节点或 ::after 不显示） */
.pulse { position: relative; flex: none; display: inline-block; width: 12rpx; height: 12rpx; margin-right: 8rpx; border-radius: 50%; background: #5E7A00; }
.pulse::after { content: ''; position: absolute; left: 0; top: 0; width: 100%; height: 100%; border-radius: 50%; background: #5E7A00; animation: ani-pulse 2.2s ease-out infinite; }
/* 按下缩小、松手回弹：过渡写在元素本身上，松手时也有过渡（只写在 .tap-on 上松手会一下跳回去） */
.card, .btn-primary, .btn-line, .btn-danger { transition: transform 0.16s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.16s ease; }
.tap-on { transform: scale(0.97); opacity: 0.86; transition: transform 0.16s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.16s ease; }
.tap-row-on { opacity: 0.5; transition: opacity 0.12s ease-out; }
.disabled.tap-on, .dis.tap-on { transform: none; opacity: 0.45; }
