<view class="page">
  <view wx:if="{{loading}}" class="state"></view>

  <view wx:elif="{{error}}" class="card state-card">
    <view class="state-t">读取失败</view>
    <view class="state-s">{{error}}</view>
    <view class="btn-line retry" hover-class="tap-on" bindtap="retry">重试</view>
  </view>

  <block wx:else>
    <!-- 右边是固定配图（images/racket-hero.png，通用球拍、没有品牌），不随球拍变化；每支球拍仍用 <rk-art> 按配色画 -->
    <!-- 顶部卡片静止不动（2026-11-25 用户觉得动画太多）：不滑入、数字不滚、配图不动；下面的球拍卡片照旧滑入 -->
    <view class="hero">
      <view class="hero-main">
        <view class="hero-row">
          <view class="hc"><view class="hc-n num">{{o.inUse}}</view><view class="hc-l">在用球拍</view></view>
          <view class="hc"><view class="hc-n num">{{o.stringCount}}</view><view class="hc-l">累计穿线</view></view>
          <view class="hc"><view class="hc-n num">{{o.maintCount}}</view><view class="hc-l">累计维护</view></view>
        </view>
        <!-- 一支球拍都没有时不显示这行（和下面「还没有球拍」重复，2026-11-25 用户要求） -->
        <view wx:if="{{cards.length}}" class="hero-foot">
          <text wx:if="{{o.due}}" class="hero-due">{{o.due}} 项到期或快到了</text>
          <text wx:else>{{o.lastString ? '上次穿线 ' + o.lastString : '还没有穿线记录'}}</text>
        </view>
      </view>
      <image class="hero-art" src="/images/racket-hero.png" mode="aspectFit" />
    </view>

    <view wx:if="{{!cards.length}}" class="card empty-card">
      <image class="empty-art" src="/images/art-ball.png" mode="aspectFit" />
      <view class="ec-t">还没有球拍</view>
      <view class="ec-s">添加球拍后可以记录每次穿线、换手胶，设置提醒间隔，到期时这里会提示</view>
      <view class="btn-primary small" hover-class="tap-on" bindtap="add">＋ 添加球拍</view>
    </view>

    <block wx:else>
      <view wx:for="{{cards}}" wx:key="id" class="card rk {{item.retired ? 'off' : ''}} {{index < 10 ? 'ani-in' : ''}}" style="animation-delay:{{index < 10 ? index * 62 : 0}}ms" hover-class="tap-on" data-id="{{item.id}}" bindtap="open">
        <view class="rk-main">
          <rk-art class="rk-ph" brand="{{item.brand}}" model="{{item.model}}" />
          <view class="rk-body">
            <view class="rk-top">
              <text class="rk-no">{{item.title}}</text>
              <text class="rk-name">{{item.name}}</text>
              <text class="ui-tag {{item.retired ? '' : 'solid'}}">{{item.status}}</text>
            </view>
            <view class="rk-mid">
              <text class="rk-n">{{item.stringCount}}</text><text class="rk-u">次穿线</text>
              <text class="rk-n">{{item.maintCount}}</text><text class="rk-u">次维护</text>
            </view>
            <view class="rk-last">{{item.last}}</view>
          </view>
        </view>
        <view wx:if="{{item.alerts.length}}" class="rk-alerts"><text wx:for="{{item.alerts}}" wx:key="k" wx:for-item="a" class="ui-tag {{a.cls}} rk-a">{{a.t}}</text></view>
      </view>
      <view class="btn-primary" hover-class="tap-on" bindtap="add">＋ 添加球拍</view>
      <view class="danger-zone">
        <view class="dz-t">数据只保存在小程序的云端，按你的账号隔离。</view>
        <view class="btn-danger" hover-class="tap-on" bindtap="clearAll">{{clearing ? '正在清除…' : '清除全部球拍数据'}}</view>
      </view>
    </block>
  </block>
</view>
