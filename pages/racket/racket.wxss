/* 顶部淡紫柔幕（与战绩页同款衔接语言）：导航栏下弧形柔紫托住球拍概览卡，不再一刀切进平灰 */
page { background: linear-gradient(180deg, #ECECF7 0%, #F0F0F7 460rpx, #F0F0F7 100%); }
.page { position: relative; z-index: 0; }
.page::before {
  content: ''; position: absolute; left: 0; right: 0; top: 0; height: 204rpx; pointer-events: none; z-index: -1;
  border-radius: 0 0 50% 50% / 0 0 42rpx 42rpx;
  background: linear-gradient(180deg, #A3A3CB 0%, #C4C4E1 16%, #E2E2F2 66%, #EAEAF6 100%);
}

.state { text-align: center; color: #84849E; font-size: 26rpx; padding: 120rpx 0; }
.state-card { text-align: center; padding: 50rpx 30rpx; }
.state-t { font-size: 30rpx; font-weight: 800; color: #4F4F7D; }
.state-s { font-size: 24rpx; color: #70708C; margin: 12rpx 0 28rpx; }
.retry { width: 240rpx; margin: 0 auto; }

/* 顶部球拍概览紫卡：和球员卡 / 战绩顶卡同款对角柔光 + 顶边内高光 + 右上极淡斜向球线网纹（不再放重复的球拍插图）；静止不动 */
.hero {
  position: relative; overflow: hidden;
  border-radius: 36rpx; padding: 34rpx 28rpx 28rpx; margin-bottom: 28rpx; color: #fff;
  background: linear-gradient(148deg, #A6A6CE 0%, #8484B6 100%);
  box-shadow: 0 16rpx 36rpx rgba(110, 110, 163, 0.28);
}
.hero::before {
  content: ''; position: absolute; left: 0; right: 0; top: 0; bottom: 0;
  border-radius: inherit; pointer-events: none; z-index: 0;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.14) 0%, rgba(255, 255, 255, 0) 46%, rgba(56, 54, 108, 0.16) 100%);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.44), inset 0 0 0 1rpx rgba(255, 255, 255, 0.18);
}
.hero::after {
  content: ''; position: absolute; right: 0; top: 0; width: 320rpx; height: 100%; pointer-events: none; z-index: 0;
  background: url("data:image/svg+xml;base64,") right top / 100% 100% no-repeat;
}
.hero-main { position: relative; z-index: 1; }
.hero-row { display: flex; align-items: center; }
.hc { flex: 1; text-align: center; }
.hc + .hc { border-left: 1rpx solid rgba(255, 255, 255, 0.16); }
.hc-n { font-size: 58rpx; font-weight: 800; line-height: 1.08; letter-spacing: -0.03em; }
.hc-l { font-size: 22rpx; color: rgba(255, 255, 255, 0.88); margin-top: 6rpx; }
/* 底部状态条：烟熏冷紫毛玻璃小条，和顶部三项居中对称 */
.hero-foot {
  margin-top: 24rpx; padding: 12rpx 20rpx; border-radius: 20rpx; text-align: center;
  font-size: 23rpx; color: rgba(255, 255, 255, 0.92);
  background: rgba(56, 54, 108, 0.16);
  background-image: linear-gradient(180deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0));
  backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.24);
}
.hero-due { display: inline-block; color: #2E3600; background: #C9E33A; border-radius: 14rpx; padding: 2rpx 16rpx; font-weight: 800; }

.empty-card { text-align: center; padding: 50rpx 30rpx; }
.ec-t { font-size: 30rpx; font-weight: 800; color: #4F4F7D; }
.ec-s { font-size: 24rpx; color: #70708C; margin-top: 10rpx; line-height: 1.6; }

/* 列表分节头（和战绩页日期前的淡紫小竖标同语言） */
.sec-hd { display: flex; align-items: center; justify-content: space-between; margin: 4rpx 8rpx 16rpx; }
.sec-t { display: flex; align-items: center; font-size: 24rpx; font-weight: 700; color: #70708C; }
.sec-t::before { content: ''; width: 6rpx; height: 22rpx; border-radius: 3rpx; background: #A3A3CB; margin-right: 12rpx; }
.sec-c { font-size: 22rpx; font-weight: 600; color: #84849E; }

/* 球拍装备陈列卡：点击直接进详情，不做缩放抖动 */
.rk { padding: 26rpx 28rpx; }
.rk.off { opacity: 0.6; }
.rk-main { display: flex; align-items: center; }
/* 左侧球拍示意图展柜框：浅雾紫渐变 + 细冷紫描边 + 顶部柔白受光（用父页双类提高权重，稳盖过组件默认平灰底） */
.rk-main .rk-ph {
  width: 140rpx; height: 140rpx; border-radius: 26rpx; margin-right: 22rpx;
  background: linear-gradient(155deg, #F9F9FE 0%, #ECECF8 100%);
  border: 1rpx solid rgba(132, 132, 182, 0.16);
  box-shadow: inset 0 2rpx 0 rgba(255, 255, 255, 0.85), 0 4rpx 12rpx rgba(84, 84, 146, 0.06);
  box-sizing: border-box;
}
.rk-body { flex: 1; min-width: 0; }
.rk-top { display: flex; align-items: center; }
.rk-no { font-size: 21rpx; font-weight: 800; color: #6E6EA3; background: #EFEFF7; border-radius: 10rpx; padding: 3rpx 12rpx; flex: none; }
.rk-name { flex: 1; min-width: 0; margin: 0 12rpx; font-size: 30rpx; font-weight: 800; color: #2E2E4A; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.rk-mid { display: flex; align-items: baseline; margin-top: 12rpx; }
.rk-n { font-size: 42rpx; font-weight: 800; line-height: 1.05; color: #2E2E4A; }
.rk-u { font-size: 22rpx; color: #70708C; margin: 0 26rpx 0 6rpx; }
.rk-last { font-size: 22rpx; color: #5C5C76; margin-top: 10rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.rk-last.hint { color: #84849E; }
.rk-alerts { display: flex; flex-wrap: wrap; margin-top: 18rpx; padding-top: 16rpx; border-top: 1rpx solid rgba(132, 132, 182, 0.11); }
.rk-a { margin: 0 10rpx 6rpx 0; font-size: 20rpx; padding: 2rpx 14rpx; }
.rk-a.idle { color: #84849E; background: #F4F4FA; }

/* 拍面颠球添加按钮：平放的 3D 淡紫球拍（淡紫拍框 + 白色网床 + 黄绿点缀 + 深灰手胶，SVG 矢量无图片文件）+ 球影 + 纯净 3D 网球；
   点击拍头以手柄为轴先轻沉、再把小网球往上颠起 30rpx 落回甜区后进入添加球拍页 */
.ball-add { position: relative; width: 280rpx; height: 192rpx; margin: 16rpx auto 8rpx; }
.ball-add.sm { margin: 12rpx auto 0; transform: scale(0.88); transform-origin: center top; }
.ball-rk {
  position: absolute; left: 0; bottom: 0; width: 280rpx; height: 96rpx; z-index: 0; transform-origin: 88% 50%;
  background: url("data:image/svg+xml;base64,") center / 100% 100% no-repeat;
}
.ball-sh {
  position: absolute; left: 122rpx; bottom: 42rpx; width: 72rpx; height: 16rpx; margin-left: -36rpx; z-index: 1; border-radius: 50%;
  background: radial-gradient(ellipse, rgba(78, 76, 134, 0.30) 0%, rgba(78, 76, 134, 0.11) 52%, rgba(78, 76, 134, 0) 78%);
}
.ball-btn {
  position: absolute; left: 122rpx; bottom: 48rpx; width: 110rpx; height: 110rpx; margin-left: -55rpx; z-index: 2;
  border-radius: 50%; box-sizing: border-box; border: 4rpx solid rgba(255, 255, 255, 0.94);
  background:
    url("data:image/svg+xml;base64,") center / 100% 100% no-repeat,
    radial-gradient(circle at 33% 26%, #F2FC85 0%, #CEE842 52%, #A5C11B 100%);
  box-shadow: inset 0 6rpx 10rpx rgba(255, 255, 255, 0.5), inset 0 -10rpx 16rpx rgba(92, 114, 0, 0.28), 0 6rpx 14rpx rgba(78, 76, 134, 0.18);
}
/* 球面左上角一颗柔润小高光点，让纯净网球更饱满 Q 弹 */
.ball-btn::before {
  content: ''; position: absolute; left: 22rpx; top: 15rpx; width: 26rpx; height: 14rpx;
  border-radius: 50%; transform: rotate(-28deg); background: rgba(255, 255, 255, 0.46); pointer-events: none;
}
.ball-add.bouncing .ball-btn { animation: ani-ball-jump 0.38s cubic-bezier(0.22, 1, 0.36, 1) both; }
.ball-add.bouncing .ball-sh { animation: ani-ball-shadow 0.38s cubic-bezier(0.22, 1, 0.36, 1) both; }
.ball-add.bouncing .ball-rk { animation: ani-rk-juggle 0.38s cubic-bezier(0.22, 1, 0.36, 1) both; }
