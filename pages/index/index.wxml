<view class="page {{canRecordDaily ? 'with-fab' : ''}}">
  <view class="top">
    <view class="top-t">战绩</view>
    <view class="top-s">本月 {{stat.month}} 场 · 共 {{stat.total}} 场 · {{stat.players}} 位球员</view>
  </view>

  <!-- 我的战绩卡（每页唯一的渐变块）；没有账号或还没比赛时显示全部比赛的统计 -->
  <!-- 背景：俯拍球网横在卡片底边，网球停在网带上（images/bg-mine.jpg） -->
  <view wx:if="{{me}}" class="mine bg-host {{play ? 'ani-sheen' : ''}}" hover-class="tap-on" bindtap="goMe">
    <image class="bg-img" src="/images/bg-mine.jpg" mode="aspectFill" />
    <view class="mine-h">
      <pl-av class="mine-av" uid="{{me.uid}}" name="{{me.name}}" />
      <view class="mine-who"><view class="mine-n">{{me.name}}</view><view class="mine-r">{{me.rankText}}</view></view>
      <view class="mine-lv"><view class="mine-lvn num">{{me.level}}</view><view class="mine-lvl">{{me.levelLbl}}</view></view>
    </view>
    <view class="mine-stats">
      <view class="ms"><view class="ms-n num">{{me.played}}</view><view class="ms-l">场次</view></view>
      <view class="ms"><view class="ms-n num">{{me.win}} - {{me.lose}}</view><view class="ms-l">胜负</view></view>
      <view class="ms"><view class="ms-n num">{{me.rate}}%</view><view class="ms-l">胜率</view></view>
    </view>
    <view wx:if="{{me.recent.length}}" class="mine-form">
      <text class="mf-l">最近 {{me.recent.length}} 场</text>
      <view wx:for="{{me.recent}}" wx:key="i" class="mf {{item.w ? 'w' : ''}} {{play ? 'ani-pop' : 'ani-wait-pop'}}" style="animation-delay:{{200 + index * 45}}ms">{{item.w ? '胜' : '负'}}</view>
    </view>
  </view>
  <view wx:else class="mine club bg-host">
    <image class="bg-img" src="/images/bg-mine.jpg" mode="aspectFill" />
    <view class="mine-stats">
      <view class="ms"><view class="ms-n num">{{stat.total}}</view><view class="ms-l">总场次</view></view>
      <view class="ms"><view class="ms-n num">{{stat.month}}</view><view class="ms-l">本月</view></view>
      <view class="ms"><view class="ms-n num">{{stat.players}}</view><view class="ms-l">球员</view></view>
    </view>
  </view>

  <view class="filters">
    <view class="chips">
      <view wx:for="{{types}}" wx:key="value" class="fc {{filter === item.value ? 'on' : ''}}"
        data-v="{{item.value}}" bindtap="setFilter">{{item.label}}</view>
    </view>
    <input class="search" placeholder="搜索球员" placeholder-class="search-ph" value="{{who}}" bindinput="onSearch" confirm-type="search" />
  </view>

  <view wx:if="{{!groups.length && !loading}}" class="empty">
    <image class="empty-art" src="/images/art-ball.png" mode="aspectFit" />
    <view>{{who || filter !== 'all' ? '没有符合条件的比赛' : '还没有比赛记录'}}</view>
    <view wx:if="{{canRecordDaily && !who && filter === 'all'}}" class="btn-primary small" hover-class="tap-on" bindtap="goAdd">记录一场日常比赛</view>
  </view>

  <block wx:for="{{groups}}" wx:key="date" wx:for-item="g" wx:for-index="gi">
    <view class="date">{{g.label}}</view>
    <view wx:for="{{g.items}}" wx:key="_id" class="mc {{gi * 2 + index < 10 ? (play ? 'ani-in' : 'ani-wait') : ''}}" style="animation-delay:{{gi * 2 + index < 10 ? (gi * 2 + index) * 50 : 0}}ms" hover-class="tap-on" data-id="{{item._id}}" bindtap="openMatch" bindlongpress="onLong">
      <view class="mc-meta">
        <text class="mc-type">{{item.typeText}}</text>
        <text wx:if="{{item.eventText}}" class="mc-ev">{{item.eventText}}</text>
        <text wx:else class="mc-ev daily">日常比赛</text>
        <text wx:for="{{item.tags}}" wx:key="k" wx:for-item="t" class="ui-tag {{t.cls}} mc-tag">{{t.t}}</text>
        <text wx:if="{{item.pending}}" class="ui-tag warn mc-pend">待确认</text>
      </view>
      <view class="mc-body">
        <view class="sd {{item.winner === 'a' ? 'w' : ''}}">
          <view class="sd-avs"><pl-av wx:for="{{item.a}}" wx:key="name" wx:for-item="p" class="sd-av" uid="{{p.uid}}" name="{{p.name}}" /></view>
          <view class="sd-ns {{item.a.length > 1 ? 'two' : ''}}">
            <view wx:for="{{item.a}}" wx:key="name" wx:for-item="p" class="sd-n">{{p.name}}<text wx:if="{{p.gender}}" class="gd"> {{p.gender}}</text></view>
            <view wx:if="{{item.aDelta}}" class="dl {{item.aUp ? 'up' : 'down'}}">{{item.aDelta}}</view>
          </view>
        </view>
        <view class="sc">
          <view class="sc-big num"><text class="{{item.winner === 'a' ? '' : 'dim'}}">{{item.bigA}}</text><text class="sc-c">:</text><text class="{{item.winner === 'b' ? '' : 'dim'}}">{{item.bigB}}</text></view>
          <view wx:if="{{item.setText}}" class="sc-sets">{{item.setText}}</view>
        </view>
        <view class="sd r {{item.winner === 'b' ? 'w' : ''}}">
          <view class="sd-avs"><pl-av wx:for="{{item.b}}" wx:key="name" wx:for-item="p" class="sd-av" uid="{{p.uid}}" name="{{p.name}}" /></view>
          <view class="sd-ns {{item.b.length > 1 ? 'two' : ''}}">
            <view wx:for="{{item.b}}" wx:key="name" wx:for-item="p" class="sd-n">{{p.name}}<text wx:if="{{p.gender}}" class="gd"> {{p.gender}}</text></view>
            <view wx:if="{{item.bDelta}}" class="dl {{item.bUp ? 'up' : 'down'}}">{{item.bDelta}}</view>
          </view>
        </view>
      </view>
    </view>
  </block>

  <view wx:if="{{more}}" class="foot">上滑加载更多</view>
  <view wx:elif="{{groups.length}}" class="foot">下拉刷新 · 点击查看详情、修改比分 · 长按可删除自己参加的日常比赛</view>
</view>

<!-- 记录日常比赛（活动比赛在签表里录）；场边记分在「记一场」页里面 -->
<view wx:if="{{canRecordDaily}}" class="fabs">
  <view class="fab" hover-class="tap-on" bindtap="goAdd"><text class="fab-p">＋</text>记一场</view>
</view>
