<view class="page {{canRecordDaily ? 'with-fab' : ''}}">
  <!-- 顶部不放「战绩」大标题和「本月 N 场 · 共 N 场 · N 位球员」（2026-11-25 用户要求去掉；底部标签栏已写着「战绩」） -->
  <!-- 我的战绩卡（每页唯一的渐变块）；没有账号或还没比赛时显示全部比赛的统计 -->
  <!-- 背景：俯拍球网横在卡片底边，网球停在网带上（images/bg-mine.jpg） -->
  <!-- 高光只在这张卡第一次出现时扫一次（和「我的」页一样），切 tab 回来不再扫（2026-11-25 用户嫌闪） -->
  <view wx:if="{{me}}" class="mine bg-host ani-sheen" hover-class="tap-on" bindtap="goMe">
    <image class="bg-img" src="/images/bg-mine.jpg" mode="aspectFill" />
    <view class="mine-h">
      <pl-av class="mine-av" uid="{{me.uid}}" name="{{me.name}}" />
      <view class="mine-who"><view class="mine-n">{{me.name}}</view><view class="mine-r">{{me.rankText}}</view></view>
      <view class="mine-lv"><view class="mine-lvn num">{{me.level}}</view><view class="mine-lvl">{{me.levelLbl}}</view></view>
    </view>
    <view class="mine-stats">
      <view class="ms"><view class="ms-n num">{{me.played}}</view><view class="ms-l">场次</view></view>
      <view class="ms"><view class="ms-n num">{{me.win}} - {{me.lose}}</view><view class="ms-l">胜负</view></view>
      <view class="ms"><view class="ms-n num">{{me.rate}}%</view><view class="ms-l">胜率</view></view>
    </view>
    <view wx:if="{{me.recent.length}}" class="mine-form">
      <text class="mf-l">最近 {{me.recent.length}} 场</text>
      <view wx:for="{{me.recent}}" wx:key="i" class="mf {{item.w ? 'w' : ''}} {{play ? 'ani-pop' : 'ani-wait-pop'}}" style="animation-delay:{{240 + index * 55}}ms">{{item.w ? '胜' : '负'}}</view>
    </view>
  </view>
  <view wx:else class="mine club bg-host">
    <image class="bg-img" src="/images/bg-mine.jpg" mode="aspectFill" />
    <view class="mine-stats">
      <view class="ms"><view class="ms-n num">{{stat.total}}</view><view class="ms-l">总场次</view></view>
      <view class="ms"><view class="ms-n num">{{stat.month}}</view><view class="ms-l">本月</view></view>
      <view class="ms"><view class="ms-n num">{{stat.players}}</view><view class="ms-l">球员</view></view>
    </view>
  </view>

  <view class="filters">
    <view class="seg has-thumb chips">
      <view class="seg-track"><view class="seg-thumb" style="width:33.3333%;transform:translateX({{(filter === 'single' ? 1 : filter === 'double' ? 2 : 0) * 100}}%)"></view></view>
      <view wx:for="{{types}}" wx:key="value" class="seg-item {{filter === item.value ? 'on' : ''}}"
        data-v="{{item.value}}" bindtap="setFilter">{{item.label}}</view>
    </view>
    <input class="search" placeholder="搜索球员" placeholder-class="search-ph" value="{{who}}" bindinput="onSearch" confirm-type="search" />
    <picker class="dp-wrap" mode="date" value="{{pickDate || today}}" start="2020-01-01" end="{{today}}" bindchange="onPickDate">
      <view class="dp-btn {{pickDate ? 'on' : ''}}" hover-class="tap-on">
        <view class="dp-ic"></view>
        <text class="dp-t">{{pickDate ? pickShort : '日期'}}</text>
      </view>
    </picker>
  </view>

  <!-- 按日期查看时的当日汇总条 -->
  <view wx:if="{{daySummary}}" class="day-bar">
    <view class="day-hd">
      <picker mode="date" value="{{pickDate}}" start="2020-01-01" end="{{today}}" bindchange="onPickDate">
        <view class="day-date">{{daySummary.label}}<text class="day-caret">▾</text></view>
      </picker>
      <view class="day-acts">
        <view class="day-nav {{daySummary.prev ? '' : 'off'}}" hover-class="{{daySummary.prev ? 'tap-on' : ''}}" data-d="{{daySummary.prev}}" bindtap="jumpDate">‹</view>
        <view class="day-nav {{daySummary.next ? '' : 'off'}}" hover-class="{{daySummary.next ? 'tap-on' : ''}}" data-d="{{daySummary.next}}" bindtap="jumpDate">›</view>
        <view class="day-clr" hover-class="tap-on" bindtap="clearDate">查看全部</view>
      </view>
    </view>
    <view wx:if="{{daySummary.total}}" class="day-stats">
      <text class="day-st b">共 {{daySummary.total}} 场</text>
      <text wx:if="{{daySummary.single}}" class="day-st">单打 {{daySummary.single}}</text>
      <text wx:if="{{daySummary.double}}" class="day-st">双打 {{daySummary.double}}</text>
      <text class="day-st">{{daySummary.players}} 位球友</text>
      <text wx:if="{{daySummary.myPlayed}}" class="day-me">我 {{daySummary.myWin}}胜{{daySummary.myLose}}负</text>
      <text wx:if="{{daySummary.hasFilter}}" class="day-flt">当前显示 {{daySummary.shown}} 场</text>
    </view>
    <view wx:else class="day-none">
      <text class="day-none-t">当天暂无比赛记录</text>
      <view wx:if="{{daySummary.nearest}}" class="day-near" hover-class="tap-on" data-d="{{daySummary.nearest}}" bindtap="jumpDate">最近比赛日 {{daySummary.nearestShort}} ›</view>
    </view>
  </view>

  <view wx:if="{{!groups.length && !loading}}" class="empty">
    <image class="empty-art" src="/images/art-ball.png" mode="aspectFit" />
    <view>{{pickDate && !who && filter === 'all' ? daySummary.label + ' 还没有比赛记录' : (who || filter !== 'all' || pickDate ? '没有符合条件的比赛' : '还没有比赛记录')}}</view>
    <view wx:if="{{pickDate}}" class="btn-line small" hover-class="tap-on" bindtap="clearDate">查看全部比赛</view>
    <view wx:elif="{{canRecordDaily && !who && filter === 'all'}}" class="btn-primary small" hover-class="tap-on" bindtap="goAdd">记录一场日常比赛</view>
  </view>

  <block wx:for="{{groups}}" wx:key="date" wx:for-item="g" wx:for-index="gi">
    <block wx:if="{{!pickDate}}"><view class="date">{{g.label}}</view></block>
    <view wx:for="{{g.items}}" wx:key="_id" class="mc win-{{item.winner}}" data-id="{{item._id}}" bindtap="openMatch" bindlongpress="onLong">
      <view class="mc-meta">
        <text class="mc-type">{{item.typeText}}</text>
        <text wx:if="{{item.eventText}}" class="mc-ev">{{item.eventText}}</text>
        <text wx:else class="mc-ev daily">日常比赛</text>
        <text wx:for="{{item.tags}}" wx:key="k" wx:for-item="t" class="ui-tag {{t.cls}} mc-tag">{{t.t}}</text>
        <text wx:if="{{item.pending}}" class="ui-tag warn mc-pend">待确认</text>
      </view>
      <view class="mc-body">
        <!-- 俯视横向网球场底纹（竖向球网虚线 + 左右发球区 T 线，写在样式里的 SVG 矢量线），不放图片 -->
        <view class="mc-court"></view>
        <view class="sd {{item.winner === 'a' ? 'w' : ''}}">
          <view class="sd-avs"><pl-av wx:for="{{item.a}}" wx:key="name" wx:for-item="p" class="sd-av" uid="{{p.uid}}" name="{{p.name}}" /></view>
          <view class="sd-ns {{item.a.length > 1 ? 'two' : ''}}">
            <view wx:for="{{item.a}}" wx:key="name" wx:for-item="p" class="sd-n">{{p.name}}<text wx:if="{{p.gender}}" class="gd"> {{p.gender}}</text></view>
            <view wx:if="{{item.aDelta}}" class="dl {{item.aUp ? 'up' : 'down'}}">{{item.aDelta}}</view>
          </view>
        </view>
        <view class="sc">
          <view class="sc-big num"><text class="{{item.winner === 'a' ? '' : 'dim'}}">{{item.bigA}}</text><text class="sc-c">:</text><text class="{{item.winner === 'b' ? '' : 'dim'}}">{{item.bigB}}</text></view>
          <view wx:if="{{item.setText}}" class="sc-sets">{{item.setText}}</view>
        </view>
        <view class="sd r {{item.winner === 'b' ? 'w' : ''}}">
          <view class="sd-avs"><pl-av wx:for="{{item.b}}" wx:key="name" wx:for-item="p" class="sd-av" uid="{{p.uid}}" name="{{p.name}}" /></view>
          <view class="sd-ns {{item.b.length > 1 ? 'two' : ''}}">
            <view wx:for="{{item.b}}" wx:key="name" wx:for-item="p" class="sd-n">{{p.name}}<text wx:if="{{p.gender}}" class="gd"> {{p.gender}}</text></view>
            <view wx:if="{{item.bDelta}}" class="dl {{item.bUp ? 'up' : 'down'}}">{{item.bDelta}}</view>
          </view>
        </view>
      </view>
    </view>
  </block>

  <!-- 翻页条（超过 1 页时显示；点击中间页码可直达任意页） -->
  <view wx:if="{{totalPages > 1}}" class="pager">
    <view class="pg-btn {{page <= 1 ? 'off' : ''}}" hover-class="{{page > 1 ? 'tap-on' : ''}}" bindtap="prevPage">‹ 上一页</view>
    <picker class="pg-mid" mode="selector" range="{{pageOpts}}" value="{{page - 1}}" bindchange="pickPage">
      <view class="pg-cur num">
        <text>第 {{page}} / {{totalPages}} 页</text><text class="pg-caret">▾</text>
      </view>
      <view class="pg-tot">共 {{totalCount}} 场</view>
    </picker>
    <view class="pg-btn {{page >= totalPages ? 'off' : ''}}" hover-class="{{page < totalPages ? 'tap-on' : ''}}" bindtap="nextPage">下一页 ›</view>
  </view>

  <view wx:if="{{groups.length}}" class="foot">下拉刷新 · 点击查看详情、修改比分 · 长按可删除自己参加的日常比赛</view>
</view>

<!-- 记录日常比赛（活动比赛在签表里录）；场边记分在「记一场」页里面 -->
<view wx:if="{{canRecordDaily}}" class="fabs">
  <view class="fab" hover-class="tap-on" bindtap="goAdd"><text class="fab-p">＋</text>记一场</view>
</view>
