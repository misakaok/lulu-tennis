/* 顶部淡紫柔幕（2026-11-25）：页面底色从冷雾紫过渡到全局冷雾灰 #F0F0F7，导航栏下面一道大弧形淡紫幕布托住「我的战绩」卡上半截，
   不再一刀切进平灰。.page 建立局部层叠，幕布 z-index -1 只垫在页面内容下面（页面外的「记一场」按钮不受影响） */
page { background: #F0F0F7 linear-gradient(180deg, #ECECF7 0%, #F0F0F7 460rpx) no-repeat; background-size: 100% 460rpx; }
.page { position: relative; z-index: 0; }
.page::before {
  content: ''; position: absolute; left: 0; right: 0; top: 0; height: 228rpx; pointer-events: none; z-index: -1;
  border-radius: 0 0 50% 50% / 0 0 44rpx 44rpx;
  background: linear-gradient(180deg, #A3A3CB 0%, #C4C4E1 16%, #E2E2F2 66%, #EAEAF6 100%);
}
/* 底部留白：有「记一场」按钮时刚好让开按钮（距底 40rpx + 高 100rpx + 间隔 30rpx），没有按钮时用普通页面的 60rpx */
.page.with-fab { padding-bottom: 170rpx; }

/* 我的战绩卡 */
.mine.ani-sheen::after { animation-delay: 0.22s; }
.mine { padding: 34rpx 32rpx 64rpx; border-radius: 40rpx; color: #fff; background: #9190BD; box-shadow: 0 16rpx 36rpx rgba(110, 110, 163, 0.3); margin-bottom: 30rpx; transition: transform 0.16s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.16s ease; } /* 底部多留一点，给图里的球网 */
/* 整卡对角微光 + 顶边内高光（和「我的」球员卡同款；背景图盖住了卡片自己的 inset 阴影，所以用 ::before 画；::after 留给 .ani-sheen）。
   z-index 0：叠在 .bg-img（-1）上面；头像、文字、毛玻璃三格 z-index 1，盖在这层柔光上面 */
.mine::before {
  content: ''; position: absolute; left: 0; right: 0; top: 0; bottom: 0; border-radius: inherit; pointer-events: none; z-index: 0;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.14) 0%, rgba(255, 255, 255, 0) 45%, rgba(56, 54, 108, 0.16) 100%);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.44), inset 0 0 0 1rpx rgba(255, 255, 255, 0.18);
}
.mine-h, .mine-stats, .mine-form { position: relative; z-index: 1; }

.mine.club { padding: 26rpx 24rpx; }
.mine-h { display: flex; align-items: center; }
.mine-av { flex: none; width: 96rpx; height: 96rpx; border-radius: 50%; border: 5rpx solid rgba(255, 255, 255, 0.9); box-sizing: border-box; display: flex; align-items: center; justify-content: center; font-size: 40rpx; font-weight: 800; color: #2E2E4A; }
.mine-who { flex: 1; min-width: 0; margin-left: 22rpx; }
.mine-n { font-size: 34rpx; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.mine-r { margin-top: 4rpx; font-size: 23rpx; color: rgba(255, 255, 255, 0.88); }
.mine-lv { flex: none; text-align: right; }
.mine-lvn { font-size: 64rpx; font-weight: 800; line-height: 1; letter-spacing: -0.03em; }
.mine-lvl { margin-top: 8rpx; font-size: 22rpx; color: rgba(255, 255, 255, 0.88); }
.mine-stats { display: flex; margin: 28rpx -8rpx 0; }
.mine.club .mine-stats { margin-top: 0; }
.ms { flex: 1; margin: 0 8rpx; padding: 18rpx 0; border-radius: 24rpx; background: rgba(56, 54, 108, 0.16); background-image: linear-gradient(180deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0)); text-align: center; backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); border: 1rpx solid rgba(255, 255, 255, 0.24); box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.28), 0 8rpx 20rpx rgba(48, 46, 96, 0.16); } /* 烟熏冷紫毛玻璃，和球员卡数据条同款 */
.ms-n { font-size: 38rpx; font-weight: 800; line-height: 1.2; }
.ms-l { font-size: 22rpx; color: rgba(255, 255, 255, 0.88); }
.mine-form { display: flex; align-items: center; margin-top: 26rpx; }
.mf-l { margin-right: 14rpx; font-size: 22rpx; color: rgba(255, 255, 255, 0.88); }
.mf { width: 42rpx; height: 42rpx; margin-right: 10rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 20rpx; font-weight: 700; color: #fff; background: rgba(255, 255, 255, 0.2); }
.mf.w { color: #2E3600; background: #C9E33A; font-weight: 800; box-shadow: 0 0 0 4rpx rgba(201, 227, 58, 0.26); }

/* 筛选 */
.filters { display: flex; align-items: center; }
.chips { display: flex; flex: none; }
/* 紧凑版滑动胶囊：和右边搜索框、日期按钮一样高（54rpx） */
.seg.chips { width: 266rpx; height: 54rpx; padding: 4rpx; box-sizing: border-box; border-radius: 27rpx; margin-right: 10rpx; }
.seg.chips .seg-track { left: 4rpx; right: 4rpx; top: 4rpx; bottom: 4rpx; }
.seg.chips .seg-thumb { border-radius: 23rpx; }
.seg.chips .seg-item { padding: 0; height: 46rpx; line-height: 46rpx; border-radius: 23rpx; font-size: 24rpx; }
/* 搜索框：和左边的筛选按钮同高、同底色，文字居中，不再是一大块白色 */
.search { flex: 1; min-width: 0; height: 54rpx; padding: 0 18rpx; border-radius: 27rpx; background: #E9E9F4; font-size: 24rpx; color: #3a3a52; text-align: center; }
.search-ph { color: #84849E; }
/* 日期选择胶囊（和筛选、搜索同高） */
.dp-wrap { flex: none; margin-left: 10rpx; }
.dp-btn {
  display: flex; align-items: center; justify-content: center; height: 54rpx; padding: 0 18rpx;
  border-radius: 27rpx; background: #E9E9F4; color: #5C5C84; font-size: 24rpx; font-weight: 600;
  transition: background-color 0.16s ease, color 0.16s ease;
}
.dp-btn.on { background: #8484B6; color: #fff; box-shadow: 0 4rpx 12rpx rgba(110, 110, 163, 0.24); }
.dp-ic {
  width: 24rpx; height: 24rpx; margin-right: 8rpx; flex: none;
  background-repeat: no-repeat; background-position: center; background-size: 24rpx 24rpx;
  background-image: url("data:image/svg+xml;base64,");
}
.dp-btn.on .dp-ic {
  background-image: url("data:image/svg+xml;base64,");
}
.dp-t { white-space: nowrap; }

/* 选中日期后的当日数据汇总条 */
.day-bar {
  margin: 22rpx 0 18rpx; padding: 20rpx 24rpx; border-radius: 26rpx; background: #fff;
  border: 1rpx solid rgba(132, 132, 182, 0.16); box-shadow: 0 4rpx 14rpx rgba(84, 84, 146, 0.06);
}
.day-hd { display: flex; align-items: center; justify-content: space-between; }
.day-date { display: inline-flex; align-items: center; font-size: 28rpx; font-weight: 800; color: #2E2E4A; }
.day-caret { margin-left: 8rpx; font-size: 20rpx; color: #8484B6; }
.day-acts { display: flex; align-items: center; }
.day-nav {
  width: 44rpx; height: 44rpx; line-height: 40rpx; text-align: center; border-radius: 50%;
  background: #F1F1F8; color: #5C5C84; font-size: 30rpx; font-weight: 700; margin-right: 10rpx;
}
.day-nav.off { opacity: 0.35; }
.day-clr {
  height: 44rpx; line-height: 44rpx; padding: 0 18rpx; border-radius: 22rpx;
  background: #EFEFF8; color: #6E6EA3; font-size: 22rpx; font-weight: 700;
}
.day-stats { display: flex; flex-wrap: wrap; align-items: center; margin-top: 12rpx; }
.day-st { font-size: 22rpx; color: #70708C; margin-right: 16rpx; }
.day-st.b { font-weight: 700; color: #4F4F7D; }
.day-me {
  padding: 2rpx 14rpx; border-radius: 14rpx; background: #C9E33A; color: #2E3600;
  font-size: 21rpx; font-weight: 800; margin-right: 12rpx;
}
.day-flt { font-size: 21rpx; color: #8484B6; }
.day-none { display: flex; align-items: center; justify-content: space-between; margin-top: 12rpx; }
.day-none-t { font-size: 22rpx; color: #84849E; }
.day-near { font-size: 22rpx; font-weight: 700; color: #6E6EA3; }

.date { display: flex; align-items: center; margin: 34rpx 8rpx 14rpx; font-size: 24rpx; font-weight: 700; color: #70708C; }
.date::before { content: ''; width: 6rpx; height: 22rpx; border-radius: 3rpx; background: #A3A3CB; margin-right: 12rpx; } /* 日期前的小淡紫竖标 */

/* 每场一张小记分牌 */
.mc { margin-bottom: 18rpx; padding: 18rpx 26rpx 22rpx; border-radius: 32rpx; background: #fff; border: 1rpx solid rgba(132, 132, 182, 0.14); box-shadow: 0 4rpx 12rpx rgba(84, 84, 146, 0.06), 0 16rpx 36rpx rgba(84, 84, 146, 0.09); position: relative; overflow: hidden; }
/* 胜方一侧：清透冷雾紫微光 + 对齐对阵区的浅淡紫圆头短竖条（右边胜就镜像）；不用荧光黄绿竖条，黄绿只留给胜方名字旁小圆点 */
.mc.win-a { background-image: linear-gradient(90deg, rgba(163, 163, 203, 0.09), rgba(163, 163, 203, 0) 44%); }
.mc.win-b { background-image: linear-gradient(270deg, rgba(163, 163, 203, 0.09), rgba(163, 163, 203, 0) 44%); }
.mc.win-a .mc-body::before, .mc.win-b .mc-body::before { content: ''; position: absolute; top: 6rpx; bottom: 6rpx; width: 6rpx; border-radius: 3rpx; background: linear-gradient(180deg, #C6C6E4, #9E9EC8); pointer-events: none; z-index: 2; }
.mc.win-a .mc-body::before { left: -16rpx; }
.mc.win-b .mc-body::before { right: -16rpx; }
/* 记分牌顶条：和下面的对阵分栏；单打 / 双打是极淡冷紫小胶囊 */
.mc-meta { display: flex; align-items: center; font-size: 22rpx; color: #70708C; padding-bottom: 14rpx; border-bottom: 1rpx solid rgba(132, 132, 182, 0.11); }
.mc-type { flex: none; margin-right: 12rpx; padding: 2rpx 12rpx; border-radius: 10rpx; background: #EFEFF7; color: #6E6EA3; font-size: 20rpx; font-weight: 600; }
.mc-ev { flex: 1; min-width: 0; color: #6E6EA3; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.mc-ev.daily { color: #84849E; font-weight: 400; }
.mc-pend { flex: none; margin-left: 10rpx; }
.mc-tag { flex: none; margin-left: 8rpx; padding: 0 12rpx; font-size: 20rpx; }
.mc-body { position: relative; display: flex; align-items: flex-start; margin-top: 16rpx; }
/* 卡内暗纹（2026-11-25 精修）：俯视横向网球场骨架——上下渐隐单打边线 + 落在头像与比分空档里的左右发球线 + 发球中线 T 字 + 竖向球网虚线（比分背后自动减淡）；
   SVG base64 矢量线，无圆圈、无图片文件、无 <image>；在最底层，双方和比分盖在上面 */
.mc-court { position: absolute; left: 0; right: 0; top: 0; bottom: 0; pointer-events: none; z-index: 0;
  background: url("data:image/svg+xml;base64,") no-repeat center / 100% 100%; }
.mc-body .sd, .mc-body .sc { position: relative; z-index: 1; }
/* 每一方：头像在上、名字在下（居中），名字能用满这一侧的宽度；单打最多两行，双打每人一行 */
.sd { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: center; text-align: center; color: #70708C; }
.sd-avs { flex: none; display: flex; }
.sd-av { width: 68rpx; height: 68rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 28rpx; font-weight: 700; color: #2E2E4A; }
.sd-av + .sd-av { margin-left: -22rpx; border: 4rpx solid #fff; box-sizing: border-box; }
.sd.r .sd-avs { flex-direction: row-reverse; }
.sd.r .sd-av + .sd-av { margin-left: 0; margin-right: -22rpx; }
.sd-ns { align-self: stretch; min-width: 0; margin-top: 12rpx; }
.sd-n { font-size: 26rpx; line-height: 1.35; word-break: break-all; overflow: hidden; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.sd-ns.two .sd-n { -webkit-line-clamp: 1; }
.sd.w { color: #2E2E4A; }
.sd.w .sd-n { font-weight: 700; }
.sd.w .sd-n:first-child::after { content: ''; display: inline-block; width: 14rpx; height: 14rpx; margin-left: 8rpx; border-radius: 50%; background: #B4CF22; vertical-align: 4rpx; box-shadow: 0 0 0 4rpx rgba(201, 227, 58, 0.26); }
.sd.r.w .sd-n:first-child::after { display: none; }
.sd.r.w .sd-n:first-child::before { content: ''; display: inline-block; width: 14rpx; height: 14rpx; margin-right: 8rpx; border-radius: 50%; background: #B4CF22; vertical-align: 4rpx; box-shadow: 0 0 0 4rpx rgba(201, 227, 58, 0.26); }
.dl { display: inline-block; margin-top: 4rpx; padding: 0 10rpx; border-radius: 8rpx; font-size: 20rpx; font-weight: 700; }
.dl.up { color: #2f8a52; background: #e9f6ee; }
.dl.down { color: #b34d4d; background: #F7E9E9; }
.sc { flex: none; min-width: 120rpx; padding: 0 8rpx; margin-top: 8rpx; text-align: center; }
.sc-big { font-size: 60rpx; font-weight: 900; line-height: 1.1; color: #262646; letter-spacing: -0.03em; }
.sc-big .dim { color: #B4B4CA; font-weight: 700; }
.sc-c { margin: 0 8rpx; color: #B9B9CE; }
.sc-sets { display: inline-block; margin-top: 8rpx; padding: 3rpx 14rpx; border-radius: 12rpx; background: #F2F2F9; font-size: 20rpx; color: #6E6EA3; white-space: nowrap; }

.pager {
  display: flex; align-items: center; justify-content: space-between;
  margin-top: 26rpx; padding: 14rpx 16rpx; border-radius: 28rpx; background: #fff;
  border: 1rpx solid rgba(132, 132, 182, 0.14); box-shadow: 0 4rpx 14rpx rgba(84, 84, 146, 0.06);
}
.pg-btn {
  flex: none; height: 64rpx; line-height: 64rpx; padding: 0 26rpx; border-radius: 22rpx;
  background: #EFEFF8; color: #58588A; font-size: 25rpx; font-weight: 700;
}
.pg-btn.off { opacity: 0.36; }
.pg-mid { flex: 1; text-align: center; padding: 0 10rpx; }
.pg-cur { display: inline-flex; align-items: center; font-size: 26rpx; font-weight: 800; color: #2E2E4A; }
.pg-caret { margin-left: 6rpx; font-size: 19rpx; color: #8484B6; }
.pg-tot { margin-top: 2rpx; font-size: 20rpx; color: #84849E; }

/* 场边记分 + 记一场：浮在右下角 */
.fabs { position: fixed; right: 32rpx; bottom: 40rpx; z-index: 10; display: flex; align-items: center; }
.fab { height: 100rpx; padding: 0 40rpx; border-radius: 50rpx; display: flex; align-items: center; color: #fff; font-size: 30rpx; font-weight: 700; background: linear-gradient(150deg, #A3A3CB, #8484B6); box-shadow: 0 14rpx 32rpx rgba(133, 133, 184, 0.4); }
.fab-p { margin-right: 8rpx; font-size: 36rpx; font-weight: 800; }
