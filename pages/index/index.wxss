.hero {
  background: linear-gradient(155deg, #A3A3CB 0%, #8484B6 100%);
  color: #fff;
  padding: 36rpx 36rpx 44rpx;
  border-radius: 0 0 40rpx 40rpx;
}
.hero-title { font-size: 40rpx; font-weight: 700; }
.hero-sub { font-size: 24rpx; opacity: 0.92; margin-top: 8rpx; }
.hero-stats { display: flex; margin-top: 32rpx; background: rgba(255, 255, 255, 0.1); border-radius: 24rpx; padding: 22rpx 0; }
.hs { flex: 1; display: flex; flex-direction: column; align-items: center; }
.hs + .hs { border-left: 1rpx solid rgba(255, 255, 255, 0.15); }
.hs .num { font-size: 44rpx; font-weight: 800; color: #fff; }
.hs .lbl { font-size: 22rpx; opacity: 0.75; margin-top: 4rpx; }

.filters { display: flex; align-items: center; margin-bottom: 8rpx; }
.filters .seg { flex: 1.3; margin-right: 20rpx; }
.search { flex: 1; height: 72rpx; background: #fff; border-radius: 20rpx; padding: 0 22rpx; font-size: 26rpx; }

.date { font-size: 24rpx; color: #8686A0; margin: 28rpx 8rpx 14rpx; font-weight: 600; }
.match { padding: 22rpx 28rpx 14rpx; margin-bottom: 18rpx; }
.m-tag { font-size: 22rpx; color: #8686A0; margin-bottom: 6rpx; }
.m-row { display: flex; align-items: center; height: 76rpx; }
.m-row + .m-row { border-top: 1rpx dashed #ECECF4; }
.avatars { display: flex; width: 80rpx; flex: none; }
.avatars .avatar + .avatar { margin-left: -16rpx; border: 3rpx solid #fff; }
.names { flex: 1; font-size: 30rpx; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin-left: 12rpx; }
.m-row.lose .names { font-weight: 400; color: #6C6C86; }
.cup { font-size: 26rpx; }
.scores { display: flex; }
.sc { width: 52rpx; text-align: center; font-size: 34rpx; font-weight: 700; color: #BDBDCE; position: relative; }
.sc.w { color: #1E1E32; }
.tb { position: absolute; top: -6rpx; right: 0; font-size: 18rpx; font-weight: 600; color: #8686A0; }

.foot { text-align: center; color: #A5A5BA; font-size: 22rpx; margin-top: 30rpx; }

.avatar.img { display: block; background: #f2f2f8; }
.delta { font-size: 20rpx; font-weight: 700; margin-left: 10rpx; padding: 0 8rpx; border-radius: 8rpx; }
.delta.up { color: #2f8a52; background: #e9f6ee; }
.delta.down { color: #b34d4d; background: #f8eeee; }
.m-event { font-size: 22rpx; color: #6E6EA3; font-weight: 600; margin-bottom: 6rpx; }
.daily-entry { display: flex; align-items: center; margin-bottom: 18rpx; padding: 18rpx 24rpx; border-radius: 18rpx; background: #fff; border: 2rpx dashed #CFCFE6; color: #6E6EA3; font-size: 26rpx; font-weight: 700; }
.de-sub { margin-left: 14rpx; font-size: 21rpx; color: #A5A5BA; font-weight: 400; }
.m-pending { margin-left: 12rpx; color: #b7791f; background: #fff8e6; border-radius: 8rpx; padding: 0 10rpx; font-size: 20rpx; }
