<view class="page">
  <view class="seg top-seg">
    <view wx:for="{{types}}" wx:key="value" class="seg-item {{filter === item.value ? 'on' : ''}}"
      data-v="{{item.value}}" bindtap="setFilter">{{item.label}}</view>
  </view>
  <scroll-view wx:if="{{!board}}" scroll-x class="season-row" enhanced show-scrollbar="{{false}}">
    <text wx:for="{{seasons}}" wx:key="value" class="season {{season === item.value ? 'on' : ''}}" data-v="{{item.value}}" bindtap="setSeason">{{item.label}}{{item.value === 'all' ? '' : ' 赛季'}}</text>
  </scroll-view>
  <view class="sort-row">
    <text class="sort-lbl">排序</text>
    <scroll-view scroll-x class="sort-scroll" enhanced show-scrollbar="{{false}}">
      <text wx:for="{{sorts}}" wx:key="value" class="sort {{sort === item.value ? 'on' : ''}}" data-v="{{item.value}}" bindtap="setSort">{{item.label}}</text>
    </scroll-view>
  </view>
  <view class="sort-row">
    <text class="sort-lbl">性别</text>
    <text wx:for="{{genders}}" wx:key="value" class="sort {{gender === item.value ? 'on' : ''}}" data-v="{{item.value}}" bindtap="setGender">{{item.label}}</text>
  </view>

  <view wx:if="{{meHidden}}" class="hide-note" hover-class="tap-on" bindtap="openShown">
    <text class="hn-t">你没有开启公开展示，排行榜里不显示你</text><text class="hn-b">开启</text>
  </view>

  <view wx:if="{{none && !loading}}" class="empty">
    <image class="empty-art" src="/images/art-trophy.png" mode="aspectFit" />
    <view>{{emptyText}}</view>
  </view>

  <!-- 前三名领奖台 -->
  <view wx:if="{{top.length}}" class="podium {{top.length >= 3 ? '' : 'few'}}">
    <view wx:for="{{top}}" wx:key="key" class="pod r{{item.rank}} {{play ? 'ani-in' : 'ani-wait'}}" style="animation-delay:{{index * 75}}ms" hover-class="tap-on" data-key="{{item.key}}" bindtap="tapPlayer">
      <view class="medal m{{item.rank}}">{{item.rank}}</view>
      <pl-av class="avatar big" uid="{{item.uid}}" name="{{item.name}}" />
      <view class="pod-name">{{item.name}}</view>
      <view wx:if="{{item.gender}}" class="pod-g">{{item.gender}}</view>
      <view class="pod-rec">{{item.win}}胜 {{item.lose}}负</view>
      <view class="pod-base">
        <text class="pod-rate {{board ? 'sm' : ''}}">{{item.mainText}}</text>
        <text class="pod-lbl">{{item.mainLbl}}</text>
      </view>
    </view>
  </view>

  <!-- 完整榜单 -->
  <view wx:if="{{ranked.length}}" class="card table">
    <view class="tr th">
      <text class="c-rank">#</text><text class="c-name">球员</text>
      <text class="c-n">{{colLbl}}</text><text class="c-n">胜-负</text><text class="c-n">胜率</text>
    </view>
    <view wx:for="{{ranked}}" wx:key="key" class="tr {{item.key === myKey ? 'me' : ''}} {{index < 12 ? (play ? 'ani-in' : 'ani-wait') : ''}}" style="animation-delay:{{index < 12 ? index * 38 : 0}}ms" hover-class="tap-row-on" data-key="{{item.key}}" bindtap="tapPlayer">
      <text class="c-rank {{item.rank > 3 ? '' : 'gold'}}">{{item.rank}}</text>
      <view class="c-name">
        <pl-av class="avatar sm" uid="{{item.uid}}" name="{{item.name}}" />
        <!-- 名字和标签在同一段文字里：名字长换行时，性别、「我」跟在名字后面到第二行。
             间距用绑定进去的空格（标签之间直接写的空格小程序会忽略）：换行时空格留在上一行末尾，第二行的标签和名字左对齐 -->
        <view class="nm"><text>{{item.name}}{{' '}}</text><text wx:if="{{item.gender}}" class="g-tag">{{item.gender}}</text><text wx:if="{{item.gender && item.key === myKey}}">{{' '}}</text><text wx:if="{{item.key === myKey}}" class="me-tag">我</text></view>
      </view>
      <view class="c-n"><text class="lv">{{item.colText}}</text><text wx:if="{{item.provisional && !board}}" class="prov">定级中</text></view>
      <text class="c-n b">{{item.win}}-{{item.lose}}</text>
      <view class="c-n"><view class="rate-bar"><view class="rate-fill {{play ? 'ani-grow-x' : 'ani-wait-x'}}" style="width:{{item.rate}}%"></view></view><text class="rate-t">{{item.rate}}%</text></view>
    </view>
  </view>

  <view wx:if="{{ranked.length}}" class="foot">{{board ? '榜单只算正常完赛的比赛，胜负和胜率是生涯数据 · ' : season === 'all' ? '' : '胜负和胜率只算这个赛季，水平分不分赛季 · '}}只显示同意公开展示的球员 · 点击球员查看比赛统计</view>
</view>
