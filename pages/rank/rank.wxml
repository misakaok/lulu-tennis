<view class="page">
  <view class="seg top-seg">
    <view wx:for="{{types}}" wx:key="value" class="seg-item {{filter === item.value ? 'on' : ''}}"
      data-v="{{item.value}}" bindtap="setFilter">{{item.label}}</view>
  </view>
  <scroll-view scroll-x class="season-row" enhanced show-scrollbar="{{false}}">
    <text wx:for="{{seasons}}" wx:key="value" class="season {{season === item.value ? 'on' : ''}}" data-v="{{item.value}}" bindtap="setSeason">{{item.label}}{{item.value === 'all' ? '' : ' 赛季'}}</text>
  </scroll-view>
  <view class="sort-row">
    <text class="sort-lbl">排序</text>
    <text class="sort {{sort === 'level' ? 'on' : ''}}" data-v="level" bindtap="setSort">按水平</text>
    <text class="sort {{sort === 'win' ? 'on' : ''}}" data-v="win" bindtap="setSort">按胜场</text>
    <text wx:if="{{followCount}}" class="sort follow {{onlyFollow ? 'on' : ''}}" bindtap="toggleFollow">{{onlyFollow ? '✓ ' : ''}}只看关注</text>
  </view>

  <view wx:if="{{none && !loading}}" class="empty">
    <view class="empty-ball"></view>
    <view>{{onlyFollow ? '你关注的球友在这个范围里还没有比赛' : season === 'all' ? '还没有比赛数据' : '这个赛季还没有比赛'}}</view>
  </view>

  <!-- 前三名领奖台 -->
  <view wx:if="{{top.length}}" class="podium {{top.length >= 3 ? '' : 'few'}}">
    <view wx:for="{{top}}" wx:key="key" class="pod r{{item.rank}}" data-key="{{item.key}}" bindtap="tapPlayer">
      <view class="medal">{{item.rank === 1 ? '🥇' : item.rank === 2 ? '🥈' : '🥉'}}</view>
      <av-img wx:if="{{item.avatar}}" class="avatar big" src="{{item.avatar}}" />
      <view wx:else class="avatar big" style="background:{{item.color}}">{{item.initial}}</view>
      <view class="pod-name">{{item.name}}</view>
      <view class="pod-rec">{{item.win}}胜 {{item.lose}}负</view>
      <view class="pod-base">
        <text class="pod-rate">{{sort === 'level' ? item.levelText : item.rate + '%'}}</text>
        <text class="pod-lbl">{{sort === 'level' ? (item.provisional ? '定级中' : '水平') : '胜率'}}</text>
      </view>
    </view>
  </view>

  <!-- 完整榜单 -->
  <view wx:if="{{ranked.length}}" class="card table">
    <view class="tr th">
      <text class="c-rank">#</text><text class="c-name">球员</text>
      <text class="c-n">水平</text><text class="c-n">胜-负</text><text class="c-n">胜率</text>
    </view>
    <view wx:for="{{ranked}}" wx:key="key" class="tr {{item.key === myKey ? 'me' : ''}}" data-key="{{item.key}}" bindtap="tapPlayer">
      <text class="c-rank {{item.rank > 3 ? '' : 'gold'}}">{{item.rank}}</text>
      <view class="c-name">
        <av-img wx:if="{{item.avatar}}" class="avatar sm" src="{{item.avatar}}" />
        <view wx:else class="avatar sm" style="background:{{item.color}}">{{item.initial}}</view>
        <text class="nm">{{item.name}}</text>
        <text wx:if="{{item.key === myKey}}" class="me-tag">我</text>
      </view>
      <view class="c-n"><text class="lv">{{item.levelText}}</text><text wx:if="{{item.provisional}}" class="prov">定级中</text></view>
      <text class="c-n b">{{item.win}}-{{item.lose}}</text>
      <view class="c-n"><view class="rate-bar"><view class="rate-fill" style="width:{{item.rate}}%"></view></view><text class="rate-t">{{item.rate}}%</text></view>
    </view>
  </view>

  <view wx:if="{{ranked.length}}" class="foot">{{season === 'all' ? '' : '胜负和胜率只算这个赛季，水平分不分赛季 · '}}点击球员可以关注、发起挑战</view>
</view>
