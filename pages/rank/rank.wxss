.top-seg { margin-bottom: 30rpx; }

.podium { display: flex; align-items: flex-end; justify-content: center; margin-bottom: 30rpx; }
.pod { flex: 1; display: flex; flex-direction: column; align-items: center; max-width: 230rpx; transition: transform 0.16s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.16s ease; } /* 按下缩小、松手回弹 */
/* 名次奖牌：金银铜图标 images/medal-1/2/3.png（2026-11-24 用户要求，照 🥇🥈🥉 画成图片，不直接用 emoji 字符） */
.medal-img { display: block; width: 64rpx; height: 64rpx; margin-bottom: 4rpx; }
.r1 .medal-img { width: 76rpx; height: 76rpx; }
.avatar.big { width: 100rpx; height: 100rpx; font-size: 40rpx; border: 5rpx solid #fff; box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.1); }
.r1 .avatar.big { width: 124rpx; height: 124rpx; font-size: 48rpx; box-shadow: 0 0 0 5rpx #C9E33A, 0 12rpx 28rpx rgba(110, 110, 163, 0.28); } /* 第 1 名：白内环（头像白边）+ 黄绿外环 */
/* 名字长时换到第二行（最多两行，居中），不在第一行就截成省略号 */
.pod-name { font-size: 28rpx; font-weight: 700; margin-top: 12rpx; max-width: 200rpx; text-align: center; line-height: 1.35; word-break: break-all; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }
.pod-rec { font-size: 22rpx; color: #70708C; margin: 4rpx 0 12rpx; }
.pod-base {
  position: relative; overflow: hidden;
  width: 100%; border-radius: 20rpx 20rpx 0 0; display: flex; flex-direction: column; align-items: center; justify-content: center;
  color: #fff; background: linear-gradient(180deg, #B3B3D6, #8484B6);
  box-shadow: inset 0 2rpx 0 rgba(255, 255, 255, 0.45), 0 12rpx 26rpx rgba(110, 110, 163, 0.22); /* 顶面受光 + 投影：像立着的台子 */
}
/* 冠军台：顶部一条黄绿光带、更有纵深的渐变；高光只给冠军台，压轴扫过 */
.r1 .pod-base { height: 170rpx; background: linear-gradient(180deg, #B9B9DF, #7D7DB3); border-top: 5rpx solid #C9E33A; }
.r1 .pod-base.ani-sheen::after { animation-delay: 0.7s; }
.r2 .pod-base::after, .r3 .pod-base::after { display: none; }
/* 底座右下角的大号名次水印 */
.pod-wm { position: absolute; right: 8rpx; bottom: -16rpx; font-size: 92rpx; font-weight: 900; color: rgba(255, 255, 255, 0.13); line-height: 1; pointer-events: none; z-index: 0; }
.pod-rate, .pod-lbl { position: relative; z-index: 1; }
.r2 .pod-base { height: 130rpx; }
.r3 .pod-base { height: 100rpx; }
.pod-rate { font-size: 40rpx; font-weight: 800; color: #fff; }
.pod-lbl { font-size: 20rpx; opacity: 0.7; }
.podium.few .pod-base { height: 120rpx; }

.table { padding: 10rpx 24rpx; overflow: hidden; } /* 「我」那一行的底色铺满到卡片边上：按卡片圆角裁掉，不露出直角 */
.tr { display: flex; align-items: center; height: 92rpx; border-top: 1rpx solid #F2F2F8; font-size: 26rpx; }
.th { height: 64rpx; border-top: 0; color: #70708C; font-size: 22rpx; }
.c-rank { width: 50rpx; color: #70708C; font-weight: 700; }
.c-rank.gold { color: #d79b00; }
.c-name { flex: 1; display: flex; align-items: center; overflow: hidden; }
.c-name .avatar { margin-right: 14rpx; }
/* 名字长时换到第二行（最多两行），性别、「我」标签跟在名字后面一起折行 */
.nm { flex: 1; min-width: 0; font-weight: 600; line-height: 1.4; word-break: break-all; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }
.c-n { width: 120rpx; text-align: center; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.th .c-n { display: block; }
.b { font-weight: 700; }
.rate-bar { width: 80rpx; height: 8rpx; border-radius: 4rpx; background: #EFEFF6; overflow: hidden; }
.rate-fill { transition: width 0.4s ease-out; height: 100%; background: #A3A3CB; border-radius: 4rpx; }
.rate-t { font-size: 22rpx; color: #5C5C76; margin-top: 6rpx; }
.up { color: #6E6EA3; font-weight: 600; }
.down { color: #b34d4d; font-weight: 600; }
.foot { text-align: center; color: #84849E; font-size: 22rpx; margin-top: 20rpx; }

.sort-row { display: flex; align-items: center; justify-content: flex-end; margin: -10rpx 4rpx 24rpx; font-size: 24rpx; }
.sort-lbl { color: #84849E; margin-right: 12rpx; }
.sort { padding: 6rpx 18rpx; border-radius: 20rpx; color: #6c6c86; margin-left: 8rpx; transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease; }
.sort.on { background: #a3a3cb; color: #fff; font-weight: 600; }
.lv { font-weight: 800; color: #4f4f7d; font-size: 28rpx; }
.prov { font-size: 18rpx; color: #84849E; margin-top: 2rpx; }
.tr.me { background: #f6f6fb; margin: 0 -24rpx; padding: 0 24rpx; }
/* 「我」在最后一行：底色一直铺到卡片底边，不在下面留一条白边（2026-11-25 用户看到右下、左下角显示异常） */
.tr.me:last-child { height: 102rpx; margin-bottom: -10rpx; padding-bottom: 10rpx; box-sizing: border-box; }
.me-tag { display: inline-block; vertical-align: middle; line-height: 1.5; font-weight: 400; font-size: 18rpx; background: #a3a3cb; color: #fff; border-radius: 8rpx; padding: 0 8rpx; }

/* 赛季筛选 */
.top-seg { margin-bottom: 18rpx; }
.season-row { white-space: nowrap; margin-bottom: 14rpx; }
.season { display: inline-block; font-size: 24rpx; color: #6C6C86; background: #E9E9F4; border-radius: 24rpx; padding: 8rpx 24rpx; margin-right: 14rpx; transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease; }
.season.on { color: #fff; font-weight: 600; background: linear-gradient(90deg, #8484B6, #A3A3CB); }

/* 性别（个人资料里填了才显示） */
.g-tag { display: inline-block; vertical-align: middle; line-height: 1.5; font-weight: 400; font-size: 18rpx; color: #6E6EA3; background: #F1F1F8; border-radius: 8rpx; padding: 0 8rpx; }
.pod-g { font-size: 20rpx; color: #6E6EA3; margin-top: 2rpx; }

/* 排序 / 榜单一行可以横向滑动 */
.sort-scroll { flex: 1; width: 0; white-space: nowrap; }
.pod-rate.sm { font-size: 32rpx; }
.sort-scroll .sort { display: inline-block; }

/* 本人没开启公开展示的提示条 */
.hide-note { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24rpx; padding: 20rpx 24rpx; border-radius: 20rpx; background: #fff; border: 1rpx solid #A3A3CB; font-size: 24rpx; color: #6E6EA3; }
.hn-t { flex: 1; margin-right: 16rpx; }
.hn-b { flex: none; padding: 6rpx 22rpx; border-radius: 999rpx; background: #A3A3CB; color: #fff; font-weight: 600; }

/* 水平排行 / LULU 积分 */
.view-seg { margin-bottom: 18rpx; }
