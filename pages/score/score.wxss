.center { text-align: center; padding: 120rpx 0; }
.head {
  margin-bottom: 24rpx; padding: 30rpx 30rpx 26rpx; border-radius: 28rpx; color: #fff; text-align: center;
  background: linear-gradient(155deg, #A3A3CB 0%, #8484B6 100%); box-shadow: 0 12rpx 28rpx rgba(133, 133, 184, 0.3);
}
.h-event { font-size: 24rpx; opacity: 0.85; }
.h-stage { font-size: 36rpx; font-weight: 800; margin-top: 6rpx; }
.vs-row { display: flex; align-items: center; margin-top: 28rpx; }
.team { flex: 1; min-width: 0; position: relative; }
.avs { display: flex; justify-content: center; }
.av {
  width: 104rpx; height: 104rpx; border-radius: 50%; border: 4rpx solid rgba(255, 255, 255, 0.85);
  background: #f2f2f8; margin: 0 -10rpx; box-sizing: border-box;
}
.av.init { display: flex; align-items: center; justify-content: center; font-size: 40rpx; font-weight: 800; color: #1E1E32; }
.t-name { margin-top: 14rpx; font-size: 28rpx; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; padding: 0 8rpx; }
.t-win { display: inline-block; margin-top: 8rpx; padding: 2rpx 18rpx; border-radius: 20rpx; background: #fff; color: #6E6EA3; font-size: 22rpx; font-weight: 800; }
.team:not(.win) .t-name { opacity: 0.95; }
.vs { width: 80rpx; font-size: 34rpx; font-weight: 900; font-style: italic; opacity: 0.9; }
.h-rules { margin-top: 24rpx; font-size: 22rpx; background: rgba(255, 255, 255, 0.18); border-radius: 14rpx; padding: 10rpx 16rpx; }

.line { display: flex; justify-content: space-between; align-items: center; padding-bottom: 20rpx; border-bottom: 1rpx solid #EFEFF6; }
.picker { font-size: 30rpx; font-weight: 600; color: #4F4F7D; }
.arrow { color: #A5A5BA; margin-left: 6rpx; }
.card-title.top { margin-top: 24rpx; }

.res-row { display: flex; align-items: center; height: 72rpx; border-top: 1rpx solid #F2F2F8; font-size: 28rpx; color: #8686A0; }
.res-row.head-row { height: 44rpx; border-top: 0; font-size: 22rpx; color: #A5A5BA; }
.res-row.w { color: #1E1E32; font-weight: 700; }
.res-name { flex: 1; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.res-sc { width: 100rpx; text-align: center; font-size: 34rpx; font-weight: 800; color: #BDBDCE; }
.head-row .res-sc { font-size: 22rpx; font-weight: 400; color: #A5A5BA; }
.res-sc.hi { color: #4F4F7D; }
.tb { font-size: 20rpx; vertical-align: super; margin-left: 2rpx; }

.result { margin-top: 20rpx; padding: 18rpx; border-radius: 16rpx; background: #F7F7FB; color: #8686A0; font-size: 26rpx; text-align: center; }
.result:empty { display: none; }
.result.ok { background: #F1F1F8; color: #6E6EA3; font-weight: 700; }
.btn-ghost {
  height: 88rpx; line-height: 88rpx; text-align: center; border-radius: 44rpx; margin-top: 10rpx;
  border: 2rpx solid #CFCFE6; color: #6E6EA3; font-size: 28rpx; font-weight: 600; background: #fff;
}
.btn-text { text-align: center; color: #8686A0; font-size: 26rpx; padding: 24rpx 0 0; }
.foot { text-align: center; font-size: 22rpx; color: #A5A5BA; margin-top: 24rpx; }
.muted { color: #A5A5BA; font-size: 26rpx; }
.muted.small { font-size: 22rpx; margin-top: 14rpx; }
.hr-k { font-size: 21rpx; opacity: 0.9; }
.hr-v { font-size: 26rpx; font-weight: 800; margin-top: 4rpx; }
.oc { margin-top: 12rpx; font-size: 26rpx; font-weight: 800; color: #b7791f; }
.oc-n { font-size: 21rpx; font-weight: 400; color: #A5A5BA; }
.ot-acts { display: flex; margin-top: 6rpx; }
.ot-a { flex: 1; margin-right: 14rpx; height: 72rpx; line-height: 72rpx; text-align: center; border-radius: 36rpx; border: 2rpx solid #CFCFE6; color: #6E6EA3; font-size: 25rpx; font-weight: 700; background: #fff; }
.ot-a:last-child { margin-right: 0; }
.ot-a.main { background: #9595C4; color: #fff; border-color: #9595C4; }
.ot-a.dis { opacity: 0.5; }
.rt-row { display: flex; align-items: center; height: 80rpx; }
.rt-n { width: 120rpx; font-size: 25rpx; color: #5C5C76; }
.rt-in { width: 110rpx; height: 64rpx; text-align: center; background: #F7F7FB; border-radius: 12rpx; font-size: 30rpx; font-weight: 800; }
.rt-c { margin: 0 16rpx; color: #A5A5BA; }
.rt-add { font-size: 24rpx; color: #6E6EA3; margin: 6rpx 0 14rpx; }
.rt-reason { width: 100%; height: 130rpx; box-sizing: border-box; background: #F7F7FB; border-radius: 14rpx; padding: 14rpx; font-size: 25rpx; margin-bottom: 14rpx; }
