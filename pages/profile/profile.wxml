<view class="page">
  <view wx:if="{{tip}}" class="tip">{{tip}}</view>

  <!-- 照片：1:1 裁剪，1080×1080 高清；同意公开展示、检测通过后其他成员才看得到
       点照片或右下角相机角标弹出菜单（从相册选 / 拍照 / 查看大图 / 删除照片），下面只留一行状态和一行说明 -->
  <view class="card ph-card">
    <view class="ph-wrap" hover-class="tap-on" bindtap="photoMenu">
      <view class="ph-ring">
        <!-- 先显示本机缩略图（photoBase），原图 / 新照片（photoShow）加载完再淡入盖上：进页面不闪 -->
        <view wx:if="{{photoShow || photoBase}}" class="photo ph-stack">
          <image wx:if="{{photoBase}}" class="ph-img on" src="{{photoBase}}" mode="aspectFill" binderror="baseErr" />
          <image wx:if="{{photoShow}}" class="ph-img {{photoReady || !photoBase ? 'on' : ''}}" src="{{photoShow}}" mode="aspectFill" bindload="photoLoaded" />
        </view>
        <view wx:else class="photo init" style="background:{{color}}">{{initial}}</view>
      </view>
      <view class="ph-cam"><view class="cam-body"><view class="cam-lens"></view></view></view>
    </view>
    <view class="ph-t">{{photoShow || photoBase ? '更换照片' : '添加照片'}}</view>
    <view wx:if="{{photoNew && isNew}}" class="ph-pill">新照片 · 点「完成」后上传</view>
    <view wx:elif="{{stateText && !photoNew}}" class="ph-pill {{photoState === 'checking' ? '' : 'bad'}}">{{stateText}}</view>
    <view wx:elif="{{hasPhoto && !shown}}" class="ph-pill bad">没有开启公开展示，照片只有你自己能看到</view>
    <view wx:if="{{photoNew && !saving}}" class="ph-ops"><view class="btn-line ph-op" hover-class="tap-on" bindtap="undoPhoto">不换了</view></view>
  </view>
  <canvas type="2d" id="photo-cv" class="photo-cv"></canvas>

  <!-- 基本资料 -->
  <view class="card">
    <view class="name-row">
      <text class="label">昵称</text>
      <input class="name-in" type="nickname" value="{{name}}" placeholder="点击填写，可用微信昵称" maxlength="10"
        bindinput="onName" bindblur="onName" bindchange="onName" />
    </view>

    <view class="name-row">
      <text class="label">性别</text>
      <view class="gseg">
        <view class="g-item {{gender === 'm' ? 'on' : ''}}" data-v="m" bindtap="pickGender">男</view>
        <view class="g-item {{gender === 'f' ? 'on' : ''}}" data-v="f" bindtap="pickGender">女</view>
      </view>
    </view>

  </view>

  <!-- 公开展示授权（审核要求：展示昵称和照片前本人知情并同意）：不强制，不同意也能保存资料；之后随时可以开关 -->
  <view class="card consent">
    <view class="cs-row" hover-class="tap-row-on" bindtap="toggleShown">
      <view class="cbox {{shown ? 'on' : ''}}"><text wx:if="{{shown}}" class="ck">✓</text></view>
      <text class="cs-t">同意向其他成员公开展示我的昵称和照片</text>
    </view>
    <!-- 说明保持两行（2026-11-23 用户要求精简）；完整说明在授权弹窗里（utils/consent.js）。「仍显示昵称」不能删：审核要求事先知情 -->
    <view class="cs-d">展示在排行榜、LULU 积分、战绩、报名名单和球员主页，仅本小程序成员可见。</view>
    <view class="cs-d">不同意也照常报名、录分：照片只有你自己能看到，排行榜不显示你，LULU 积分里显示为「球友」；报名名单、对阵表和比赛记录里仍显示昵称。</view>
  </view>

  <!-- 网球等级 -->
  <view class="card">
    <view class="card-title">网球等级（自评）<text class="sub">作为起始等级；打完比赛后，卡片上显示按比赛算出的等级</text></view>
    <view wx:for="{{levels}}" wx:key="v" class="lv {{level === item.v ? 'on' : ''}}" data-v="{{item.v}}" bindtap="pickLevel">
      <view class="radio"><view wx:if="{{level === item.v}}" class="dot"></view></view>
      <text>{{item.t}}</text>
    </view>
  </view>

  <view class="lock-note">比赛场数、胜率和排名由比赛记录自动计算，不能手动修改</view>
  <view class="btn-primary {{saving ? 'disabled' : ''}}" hover-class="tap-on" bindtap="save">{{isNew ? '完成' : '保存修改'}}</view>
  <view wx:if="{{fromGate}}" class="btn-line later" hover-class="tap-on" bindtap="later">稍后再设置</view>
</view>
