<view class="page">
  <view wx:if="{{tip}}" class="tip">{{tip}}</view>

  <!-- 照片：1:1 裁剪，1080×1080 高清；检测通过后其他球友才看得到 -->
  <view class="card center">
    <view class="photo-wrap" bindtap="previewPhoto">
      <image wx:if="{{photoShow}}" class="photo" src="{{photoShow}}" mode="aspectFill" />
      <view wx:else class="photo init" style="background:{{color}}">{{initial}}</view>
      <view wx:if="{{photoNew && isNew}}" class="photo-tag">新照片 · 点「完成」后上传</view>
    </view>
    <view class="photo-btns">
      <view class="btn-line pb" hover-class="tap-on" bindtap="pickAlbum">从相册选</view>
      <view class="btn-line pb" hover-class="tap-on" bindtap="pickCamera">拍照</view>
    </view>
    <view wx:if="{{photoNew && !saving}}" class="photo-ops"><view class="btn-line op" hover-class="tap-on" bindtap="undoPhoto">不换了</view></view>
    <view wx:elif="{{hasPhoto}}" class="photo-ops"><view class="btn-danger op" hover-class="tap-on" bindtap="removePhoto">删除照片</view></view>
    <view wx:if="{{stateText && !photoNew}}" class="photo-state">{{stateText}}</view>
    <view class="hint">照片会裁成正方形（1080×1080），经过微信图片安全检测后展示给其他球友；没有照片时显示名字首字</view>
  </view>
  <canvas type="2d" id="photo-cv" class="photo-cv"></canvas>

  <!-- 基本资料 -->
  <view class="card">
    <view class="name-row">
      <text class="label">昵称</text>
      <input class="name-in" type="nickname" value="{{name}}" placeholder="点击填写，可用微信昵称" maxlength="10"
        bindinput="onName" bindblur="onName" bindchange="onName" />
    </view>
    <view class="hint left">昵称只用于展示。改昵称不影响以前的战绩和活动报名（都按账号关联）。</view>

    <view class="name-row">
      <text class="label">性别</text>
      <view class="gseg">
        <view class="g-item {{gender === 'm' ? 'on' : ''}}" data-v="m" bindtap="pickGender">男</view>
        <view class="g-item {{gender === 'f' ? 'on' : ''}}" data-v="f" bindtap="pickGender">女</view>
      </view>
    </view>

  </view>

  <!-- 网球等级 -->
  <view class="card">
    <view class="card-title">网球等级（自评）<text class="sub">作为起始等级；打完比赛后，卡片上显示按比赛算出的等级</text></view>
    <view wx:for="{{levels}}" wx:key="v" class="lv {{level === item.v ? 'on' : ''}}" data-v="{{item.v}}" bindtap="pickLevel">
      <view class="radio"><view wx:if="{{level === item.v}}" class="dot"></view></view>
      <text>{{item.t}}</text>
    </view>
  </view>

  <view class="lock-note">比赛场数、胜率和排名由比赛记录自动计算，不能手动修改</view>
  <view class="btn-primary {{saving ? 'disabled' : ''}}" hover-class="tap-on" bindtap="save">{{isNew ? '完成' : '保存修改'}}</view>
</view>
