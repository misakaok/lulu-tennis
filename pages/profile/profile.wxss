.tip { background: #fff8e6; color: #9a6a00; font-size: 24rpx; padding: 18rpx 22rpx; border-radius: 16rpx; margin-bottom: 20rpx; }

/* 本页的重点块：淡紫渐变底（同球拍页、比赛详情的 hero），白字 */
.ph-card { display: flex; flex-direction: column; align-items: center; padding: 44rpx 36rpx 32rpx; color: #fff; background: linear-gradient(150deg, #A3A3CB, #8484B6); box-shadow: 0 12rpx 28rpx rgba(133, 133, 184, 0.3); }
/* 照片：半透明白圈 + 白色间隔，右下角白色相机角标（纯 CSS 画的相机） */
.ph-wrap { position: relative; border-radius: 50%; }
.ph-ring { padding: 6rpx; border-radius: 50%; background: rgba(255, 255, 255, 0.45); box-shadow: 0 12rpx 28rpx rgba(80, 80, 140, 0.25); }
.photo { width: 220rpx; height: 220rpx; border-radius: 50%; display: block; background: #F1F1F8; border: 6rpx solid #fff; box-sizing: border-box; }
.ph-stack { position: relative; overflow: hidden; }
.ph-img { position: absolute; left: 0; top: 0; width: 100%; height: 100%; display: block; opacity: 0; transition: opacity 0.2s; }
.ph-img.on { opacity: 1; }
.photo.init { display: flex; align-items: center; justify-content: center; color: #fff; font-size: 92rpx; font-weight: 800; }
.ph-cam { position: absolute; right: 4rpx; bottom: 4rpx; width: 64rpx; height: 64rpx; border-radius: 50%; background: #fff; box-sizing: border-box; display: flex; align-items: center; justify-content: center; box-shadow: 0 4rpx 12rpx rgba(80, 80, 140, 0.3); }
.cam-body { position: relative; width: 28rpx; height: 20rpx; border: 3rpx solid #6E6EA3; border-radius: 6rpx; display: flex; align-items: center; justify-content: center; }
.cam-body::before { content: ''; position: absolute; top: -8rpx; left: 7rpx; width: 10rpx; height: 5rpx; background: #6E6EA3; border-radius: 3rpx 3rpx 0 0; }
.cam-lens { width: 8rpx; height: 8rpx; border: 3rpx solid #6E6EA3; border-radius: 50%; }
.ph-t { margin-top: 20rpx; font-size: 27rpx; font-weight: 700; color: #fff; }
.ph-pill { margin-top: 16rpx; max-width: 100%; box-sizing: border-box; padding: 8rpx 22rpx; border-radius: 999rpx; background: rgba(255, 255, 255, 0.22); color: #fff; font-size: 22rpx; line-height: 1.5; text-align: center; }
.ph-pill.bad { background: #fff; color: #b34d4d; }
.ph-ops { margin-top: 16rpx; display: flex; justify-content: center; }
.ph-op { width: 200rpx; }
.ph-hint { margin-top: 22rpx; padding-top: 20rpx; border-top: 1rpx solid rgba(255, 255, 255, 0.28); align-self: stretch; font-size: 21rpx; line-height: 1.6; color: rgba(255, 255, 255, 0.85); text-align: center; }
.ph-op { border-color: #fff; }
.photo-cv { position: fixed; left: -2000px; top: 0; width: 1080px; height: 1080px; }

.hint { font-size: 22rpx; color: #A5A5BA; margin-top: 16rpx; }
.hint.left { align-self: stretch; }

.name-row { align-self: stretch; display: flex; align-items: center; margin-top: 36rpx; background: #f7f7fb; border-radius: 18rpx; padding: 0 24rpx; }
.name-row .label { width: 90rpx; }
.name-in { flex: 1; height: 88rpx; font-size: 30rpx; font-weight: 600; }

.lv { display: flex; align-items: center; padding: 20rpx 16rpx; border-radius: 16rpx; font-size: 27rpx; color: #3a3a52; }
.lv + .lv { margin-top: 6rpx; }
.lv.on { background: #f1f1f8; color: #4f4f7d; font-weight: 600; }
.radio { width: 34rpx; height: 34rpx; border-radius: 50%; border: 3rpx solid #c5c5da; margin-right: 18rpx; display: flex; align-items: center; justify-content: center; flex: none; }
.lv.on .radio { border-color: #8585b8; }
.dot { width: 18rpx; height: 18rpx; border-radius: 50%; background: #8585b8; }
.gseg { flex: 1; display: flex; background: #EFEFF6; border-radius: 18rpx; padding: 6rpx; }
.g-item { flex: 1; text-align: center; padding: 12rpx 0; border-radius: 14rpx; font-size: 26rpx; color: #5C5C76; }
.g-item.on { background: #fff; color: #4F4F7D; font-weight: 700; box-shadow: 0 2rpx 8rpx rgba(0,0,0,.06); }
.name-row .gseg { margin: 12rpx 0; }
.name-row:first-child { margin-top: 0; }
.consent { padding-top: 28rpx; }
.cs-row { display: flex; align-items: center; padding: 8rpx 0 14rpx; border-radius: 12rpx; }
.cbox { width: 38rpx; height: 38rpx; border-radius: 10rpx; border: 3rpx solid #c5c5da; margin-right: 18rpx; display: flex; align-items: center; justify-content: center; flex: none; }
.cbox.on { background: #8484B6; border-color: #8484B6; }
.ck { color: #fff; font-size: 24rpx; font-weight: 800; line-height: 1; }
.cs-t { font-size: 28rpx; font-weight: 600; color: #3a3a52; }
.cs-d { font-size: 22rpx; color: #8686A0; line-height: 1.6; margin-top: 6rpx; }
.lock-note { text-align: center; font-size: 22rpx; color: #A5A5BA; margin: 10rpx 0 20rpx; }
