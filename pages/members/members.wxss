.seg { margin-bottom: 20rpx; }
.muted { text-align: center; color: #A5A5BA; font-size: 25rpx; padding: 30rpx 0; }
.mrow { display: flex; align-items: center; padding: 18rpx 0; border-top: 1rpx solid #F2F2F8; }
.mrow:first-of-type { border-top: 0; }
.m-main { flex: 1; min-width: 0; }
.m-n { font-size: 28rpx; font-weight: 700; color: #1E1E32; }
.m-s { margin-top: 4rpx; font-size: 22rpx; color: #8686A0; }
.m-tag { margin-left: 10rpx; font-size: 19rpx; color: #fff; background: #6E6EA3; border-radius: 8rpx; padding: 2rpx 10rpx; font-weight: 400; }
.m-a { flex: none; margin-left: 10rpx; padding: 8rpx 20rpx; border-radius: 24rpx; border: 2rpx solid #CFCFE6; color: #6E6EA3; font-size: 23rpx; }
.m-a.main { background: #9595C4; color: #fff; border-color: #9595C4; }
.m-a.danger { color: #b34d4d; border-color: #e9c9c9; }
.m-ck { width: 40rpx; height: 40rpx; line-height: 40rpx; text-align: center; border-radius: 10rpx; border: 2rpx solid #CFCFE6; margin-right: 16rpx; color: #fff; font-size: 24rpx; }
.m-ck.on { background: #9595C4; border-color: #9595C4; }
button.m-share { flex: none; margin: 0 0 0 10rpx !important; padding: 0 20rpx !important; height: 52rpx; line-height: 52rpx; font-size: 23rpx; border-radius: 26rpx; background: #9595C4; color: #fff; width: auto !important; }
button.m-share::after { border: none; }
.foot { text-align: center; font-size: 21rpx; color: #A5A5BA; margin-top: 20rpx; }
