.seg { margin-bottom: 20rpx; }
.muted { text-align: center; color: #A5A5BA; font-size: 25rpx; padding: 30rpx 0; }
.card .muted { padding: 10rpx 0; } /* 卡片里的空状态 / 提示：卡片本身有内边距，不再上下各加 30rpx */
.mrow { display: flex; align-items: center; padding: 18rpx 0; }
.mrow + .mrow { border-top: 1rpx solid #F2F2F8; } /* 分隔线只画在两行之间，第一行上面不画（见 tests/review-surface.test.js） */
.mrow:first-child { padding-top: 0; } /* 没有标题的卡片（成员、待审核）：第一行上边距不叠在卡片内边距上 */
.mrow:last-child { padding-bottom: 0; } /* 卡片最后一行：下边距不再叠在卡片内边距上，底部留白和顶部一致 */
.m-main { flex: 1; min-width: 0; }
.m-n { font-size: 28rpx; font-weight: 700; color: #1E1E32; }
.m-s { margin-top: 4rpx; font-size: 22rpx; color: #8686A0; }
.m-tag { margin-left: 10rpx; font-size: 19rpx; color: #fff; background: #6E6EA3; border-radius: 8rpx; padding: 2rpx 10rpx; font-weight: 400; }
.m-a { flex: none; margin-left: 10rpx; padding: 8rpx 20rpx; border-radius: 24rpx; border: 2rpx solid #CFCFE6; color: #6E6EA3; font-size: 23rpx; }
.m-a.main { background: #6E6EA3; color: #fff; border-color: #6E6EA3; }
.m-a.danger { color: #b34d4d; border-color: #e9c9c9; }
.m-ck { width: 40rpx; height: 40rpx; line-height: 40rpx; text-align: center; border-radius: 10rpx; border: 2rpx solid #CFCFE6; margin-right: 16rpx; color: #fff; font-size: 24rpx; }
.m-ck.on { background: #6E6EA3; border-color: #6E6EA3; }
button.m-share { flex: none; margin: 0 0 0 10rpx !important; padding: 0 20rpx !important; height: 52rpx; line-height: 52rpx; font-size: 23rpx; border-radius: 26rpx; background: #6E6EA3; color: #fff; width: auto !important; }
button.m-share::after { border: none; }
.foot { text-align: center; font-size: 21rpx; color: #A5A5BA; margin-top: 20rpx; }

.m-alias { font-size: 22rpx; color: #8C8CA3; font-weight: normal; margin-left: 6rpx; }

.m-g { margin-left: 10rpx; font-size: 19rpx; color: #6E6EA3; background: #F1F1F8; border: 1rpx solid #CFCFE6; border-radius: 8rpx; padding: 2rpx 10rpx; font-weight: 400; } /* 已选的性别：点了可以修改（带 ›） */
.m-gd-tip { display: flex; align-items: center; }

/* 「生成邀请链接」按钮和下面的卡片拉开：按钮带阴影，比卡片之间的 24rpx 再多留一点 */
.m-new { margin-bottom: 32rpx; }
.row-t { display: flex; align-items: center; justify-content: space-between; } /* 卡片标题右边放小按钮 */
