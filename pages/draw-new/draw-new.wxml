<view wx:if="{{!canPublish && authError}}" class="page muted">{{authError}}</view>
<view wx:elif="{{settingsLoading}}" class="page muted">加载中…</view>
<block wx:elif="{{canPublish}}">
<view class="page">
  <!-- 顶部概要：选项一改就跟着变，边填边确认建的是什么活动；整页唯一的重点色块 -->
  <view class="hero">
    <view class="hero-main">
      <view class="hero-k">{{editingSettings ? title : fromSignup ? '按报名名单生成对阵' : '新活动'}}</view>
      <view class="hero-t">{{heroTop}}</view>
      <view class="hero-s">{{heroSub}}</view>
    </view>
    <image class="hero-art" src="/images/art-net.png" mode="aspectFit" />
  </view>

  <!-- 活动设置 -->
  <view wx:if="{{!editingSettings || !fixedRotation}}" class="card">
    <view class="card-title">活动设置</view>
    <view wx:if="{{!editingSettings}}" class="field first">
      <text class="label">比赛名称</text>
      <input class="title-in" value="{{title}}" maxlength="20" bindinput="onTitle" placeholder="请输入比赛名称，例如：周末内部赛" disabled="{{fromSignup}}" />
    </view>
    <view wx:if="{{!fromSignup && !editingSettings && mode !== 'rotation'}}" class="field">
      <text class="label">参加方式</text>
      <view class="seg">
        <view class="seg-item {{entry === 'signup' ? 'on' : ''}}" data-v="signup" bindtap="setEntry">开放报名</view>
        <view class="seg-item {{entry === 'pick' ? 'on' : ''}}" data-v="pick" bindtap="setEntry">我来选人</view>
      </view>
    </view>
    <view class="field">
      <text class="label">活动形式</text>
      <view class="seg {{fromSignup ? 'locked' : ''}}">
        <view class="seg-item {{mode === 'groups' ? 'on' : ''}}" data-v="groups" bindtap="setMode">分组循环</view>
        <view class="seg-item {{mode === 'bracket' ? 'on' : ''}}" data-v="bracket" bindtap="setMode">单淘汰</view>
        <view class="seg-item {{mode === 'groups_ko' ? 'on' : ''}}" data-v="groups_ko" bindtap="setMode">循环＋淘汰</view>
        <view wx:if="{{!editingSettings}}" class="seg-item {{mode === 'rotation' ? 'on' : ''}}" data-v="rotation" bindtap="setMode">四人轮换</view>
      </view>
      <view wx:if="{{mode === 'rotation'}}" class="muted small">固定 4 人双打，每人单独报名；三轮换搭档：A＋B 对 C＋D、A＋C 对 B＋D、A＋D 对 B＋C</view>
    </view>
    <view wx:if="{{mode === 'bracket'}}" class="field">
      <text class="label">签数</text>
      <view class="pills {{fromSignup ? 'locked' : ''}}">
        <view wx:for="{{sizes}}" wx:key="*this" class="pill {{size === item ? 'on' : ''}}" data-v="{{item}}" bindtap="setSize">{{item}} 签</view>
      </view>
    </view>
    <view wx:elif="{{mode !== 'rotation'}}" class="field">
      <text class="label">分几组</text>
      <view class="pills {{fromSignup ? 'locked' : ''}}">
        <view wx:for="{{groupOpts}}" wx:key="*this" class="pill {{groupCount === item ? 'on' : ''}}" data-v="{{item}}" bindtap="setGroups">{{item === 1 ? '1 组（大循环）' : item + ' 组'}}</view>
      </view>
    </view>
    <view wx:if="{{mode === 'groups_ko'}}" class="field">
      <text class="label">每组进入下一轮</text>
      <view class="seg {{fromSignup ? 'locked' : ''}}">
        <view class="seg-item {{advance === 1 ? 'on' : ''}} {{groupCount === 1 ? 'off' : ''}}" data-v="1" bindtap="setAdvance">第 1 名</view>
        <view class="seg-item {{advance === 2 ? 'on' : ''}}" data-v="2" bindtap="setAdvance">前 2 名</view>
      </view>
      <view class="muted small">{{koInfo}}</view>
    </view>
    <!-- LULU 积分（默认不计）：开启后选类别；活动形式由管理员选（循环＋淘汰或单淘汰），开启 / 换类别不改已选的形式 -->
    <view wx:if="{{!fromSignup && !editingSettings && mode !== 'rotation'}}" class="field">
      <text class="label">计入 LULU 积分</text>
      <view class="seg">
        <view class="seg-item {{cupOn ? '' : 'on'}}" data-v="0" bindtap="setCup">不计入</view>
        <view class="seg-item {{cupOn ? 'on' : ''}}" data-v="1" bindtap="setCup">计入</view>
      </view>
    </view>
    <view wx:if="{{!fromSignup && !editingSettings && cupOn && mode !== 'rotation'}}" class="field">
      <text class="label">积分类别</text>
      <view class="seg cup-kinds">
        <view wx:for="{{cupKinds}}" wx:key="value" class="seg-item {{cupKind === item.value ? 'on' : ''}}" data-v="{{item.value}}" bindtap="setCupKind">{{item.label}}</view>
      </view>
      <view class="small cup-n {{cupErr ? 'bad' : 'muted'}}">{{cupErr || cupNote}}</view>
      <block wx:if="{{cupKind !== 'encounter'}}">
        <text class="label cup-n">积分组别</text>
        <view class="seg">
          <view wx:for="{{cupPointGroups}}" wx:key="value" class="seg-item {{cupPointGroup === item.value ? 'on' : ''}}" data-v="{{item.value}}" bindtap="setCupPointGroup">{{item.label}}</view>
        </view>
        <view class="small cup-n muted">3.5 组女子单打：冠军加 5 分，亚军加 3 分，四强加 1 分</view>
      </block>
    </view>
    <view wx:if="{{(fromSignup || editingSettings) && cupText}}" class="field">
      <text class="label">LULU 积分</text>
      <view><text class="ui-tag solid">{{cupText}}</text></view>
      <view wx:if="{{editingSettings && cupErr}}" class="small cup-n bad">{{cupErr}}</view>
    </view>
  </view>

  <!-- 时间地点（截止报名后不再显示，到活动详情里编辑） -->
  <view wx:if="{{!fromSignup && !editingSettings}}" class="card">
    <view class="card-title">时间地点<text class="sub">创建后可以在活动详情里编辑</text></view>
    <event-form recent="{{recentPlaces}}" allow-past="{{entry === 'pick'}}" bind:change="onInfo" />
  </view>

  <!-- 比赛规则：录分时直接沿用，不用每场再选 -->
  <view class="card">
    <view class="card-title">计分规则<text class="sub">{{fromSignup ? '按当前规则排对阵' : '录分时自动沿用'}}</text></view>
    <view wx:if="{{!editingSettings}}" class="field first">
      <text class="label">单打 / 双打</text>
      <view class="seg {{fromSignup || mode === 'rotation' ? 'locked' : ''}}">
        <view class="seg-item {{type === 'single' ? 'on' : ''}}" data-v="single" bindtap="setType">单打</view>
        <view class="seg-item {{type === 'double' ? 'on' : ''}}" data-v="double" bindtap="setType">双打</view>
      </view>
    </view>
    <view wx:if="{{!editingSettings}}" class="field">
      <text class="label">组别</text>
      <view class="pills {{fromSignup ? 'locked' : ''}}">
        <view class="pill {{category === '' ? 'on' : ''}}" data-v="" bindtap="setCategory">不限</view>
        <view class="pill {{category === 'm' ? 'on' : ''}}" data-v="m" bindtap="setCategory">男子</view>
        <view class="pill {{category === 'f' ? 'on' : ''}}" data-v="f" bindtap="setCategory">女子</view>
        <view wx:if="{{type === 'double' && mode !== 'rotation'}}" class="pill {{category === 'mixed' ? 'on' : ''}}" data-v="mixed" bindtap="setCategory">混双</view>
      </view>
      <view wx:if="{{category}}" class="muted small">{{category === 'mixed' ? '报名时搭档必须一男一女；没搭档的由你配对' : '报名时按个人资料里的性别限制'}}{{entry === 'pick' && !fromSignup ? '。「我来选人」不会自动检查性别，请自己把关' : ''}}</view>
    </view>
    <view wx:if="{{mode !== 'bracket' && mode !== 'rotation' && entry === 'signup' && !fromSignup}}" class="field">
      <text class="label">报名上限</text>
      <view class="pills">
        <view wx:for="{{limits}}" wx:key="*this" class="pill {{limit === item ? 'on' : ''}}" data-v="{{item}}" bindtap="setLimit">{{item ? item + (type === 'double' ? ' 队' : ' 人') : '不限'}}</view>
      </view>
      <view class="muted small">{{type === 'double' ? '按队算，1 队 2 人（2 队 = 4 人，凑一场双打）；单人报名占 1 个名额。' : ''}}满了之后还能报名，排进候补；前面有人取消就自动递补</view>
    </view>
    <view wx:if="{{waitInfo}}" class="muted small">{{waitInfo}}</view>

    <!-- 小组赛规则 -->
    <view wx:if="{{mode !== 'bracket'}}" class="stage">
      <view class="stage-h">{{mode === 'rotation' ? '每轮的规则（三轮相同）' : '分组循环的规则'}}</view>
      <rule-picker value="{{rules.group}}" disabled="{{fromSignup}}" data-stage="group" bind:change="onRule" />
    </view>

    <!-- 淘汰赛规则：统一一套，或按轮次单独设置 -->
    <view wx:if="{{mode !== 'groups' && mode !== 'rotation'}}" class="stage">
      <view class="stage-h row">
        <text>单淘汰的规则</text>
        <view class="seg mini {{fromSignup ? 'locked' : ''}}">
          <view class="seg-item {{byRound ? '' : 'on'}}" data-v="0" bindtap="setByRound">统一</view>
          <view class="seg-item {{byRound ? 'on' : ''}}" data-v="1" bindtap="setByRound">按轮次</view>
        </view>
      </view>
      <view wx:if="{{byRound}}" class="muted small">下面是其他轮次的默认规则；需要不同规则的轮次（如最后一轮）打开「单独设置」</view>
      <rule-picker value="{{rules.ko}}" disabled="{{fromSignup}}" data-stage="ko" bind:change="onRule" />
      <block wx:if="{{byRound}}">
        <view wx:for="{{koRoundList}}" wx:key="players" class="round">
          <view class="round-h">
            <text class="round-n">{{item.name}}</text>
            <text class="round-t">{{item.custom ? '单独设置' : '同上：' + item.text}}</text>
            <switch class="round-sw" checked="{{item.custom}}" disabled="{{fromSignup}}" color="#5C5C94" data-p="{{item.players}}" bindchange="toggleRound" />
          </view>
          <rule-picker wx:if="{{item.custom}}" value="{{item.rule}}" disabled="{{fromSignup}}" data-stage="{{item.players}}" bind:change="onRule" />
        </view>
      </block>
    </view>

    <view class="sum">
      <view class="sum-h">规则一览（录分时按场次自动使用）</view>
      <view wx:for="{{rulesSum}}" wx:key="stage" class="sum-row {{item.hl ? 'hl' : ''}}"><text class="sum-k">{{item.stage}}</text><text class="sum-v">{{item.text}}</text></view>
    </view>

    <view wx:if="{{editingSettings}}" class="info">已报名的球友和搭档会保留，候补按新的名额和原报名顺序更新。</view>
    <view wx:elif="{{entry === 'signup'}}" class="info ok">{{info}}</view>
  </view>

  <block wx:if="{{editingSettings}}">
    <view class="btn-primary {{saving || cupErr ? 'disabled' : ''}}" hover-class="tap-on" bindtap="saveSettings">{{saving ? '保存中…' : '保存规则'}}</view>
  </block>
  <block wx:elif="{{entry === 'pick'}}">
    <!-- 参赛球员 -->
    <view class="card">
      <view class="card-title row">
        <text>{{fromSignup ? '报名名单' : '参加的球员'}}</text>
        <view class="links"><view class="btn-line mini" hover-class="tap-on" bindtap="selectAll">全选</view><view class="btn-line mini" hover-class="tap-on" bindtap="clearAll">清空</view></view>
      </view>
      <view class="chips">
        <view wx:for="{{chips}}" wx:key="name" class="chip {{item.on ? 'on' : ''}}" data-name="{{item.name}}" bindtap="togglePlayer">
          <text wx:if="{{item.team}}" class="team-no">{{item.team}}队</text>
          <text>{{item.name}}</text><text wx:if="{{item.level}}" class="chip-lv">{{item.level}}</text>
        </view>
        <view wx:if="{{!chips.length}}" class="muted">还没有球员。球友加入小程序并填好资料后，会出现在这里</view>
      </view>
      <view class="info {{canDraw ? 'ok' : ''}}">{{info}}</view>
    </view>

    <!-- 双打配对 -->
    <view wx:if="{{type === 'double' && teamList.length}}" class="card">
      <view class="card-title row">
        <text>双打配对</text>
        <view class="btn-line mini" hover-class="tap-on" bindtap="shufflePairs">随机配对</view>
      </view>
      <view class="muted small top">按点选顺序每 2 人一队；想换搭档，取消后再按顺序点选</view>
      <view wx:for="{{teamList}}" wx:key="no" class="team-line">
        <text class="tl-no">{{item.no}} 队</text>
        <text class="tl-name">{{item.name}}</text>
        <text wx:if="{{item.level}}" class="seed-lv">{{item.level}}</text>
      </view>
    </view>

    <!-- 种子 -->
    <view wx:if="{{seedChips.length}}" class="card">
      <view class="card-title row">
        <text>{{type === 'double' ? '种子队伍' : '种子选手'}}</text>
        <view class="btn-line mini" hover-class="tap-on" bindtap="autoSeeds">按水平推荐</view>
      </view>
      <view class="muted small top">选出水平靠前的{{type === 'double' ? '队伍作为种子队伍' : '球员作为种子选手'}}，排对阵时把他们分开。按顺序点选：第一个点的是 1 号种子，可以上移调整顺序</view>
      <view class="chips">
        <view wx:for="{{seedChips}}" wx:key="name" class="chip seedable {{item.seed ? 'seeded' : ''}}" data-name="{{item.name}}" bindtap="toggleSeed">
          <text wx:if="{{item.seed}}" class="badge">{{item.seed}}</text>
          <text>{{item.name}}</text><text wx:if="{{item.level}}" class="chip-lv">{{item.level}}</text>
        </view>
      </view>
      <view wx:if="{{seedList.length}}" class="seed-list">
        <view wx:for="{{seedList}}" wx:key="name" class="seed-row">
          <text class="seed-no">{{item.seed}} 号种子</text>
          <text class="seed-name">{{item.name}}</text>
          <text wx:if="{{item.level}}" class="seed-lv">{{item.level}}</text>
          <view wx:if="{{index > 0}}" class="btn-line mini" hover-class="tap-on" data-i="{{index}}" bindtap="seedUp">↑ 上移</view>
        </view>
      </view>
      <view class="muted small">{{seedInfo}}</view>
    </view>

    <view wx:if="{{!manualOnly}}" class="btn-primary {{canDraw ? '' : 'disabled'}}" hover-class="tap-on" bindtap="doDraw">{{mode === 'rotation' ? '排三轮对阵' : (preview && !manualOpts.length) ? '重新排' : (mode === 'bracket' ? '随机排对阵' : '随机分组')}}</view>
    <view wx:if="{{mode !== 'rotation' && (!preview || !manualOpts.length)}}" class="btn-line manual-start {{canDraw ? '' : 'disabled'}}" hover-class="tap-on" data-manual="yes" bindtap="doDraw">{{mode === 'bracket' ? '手动排对阵' : '手动分组'}}</view>

    <!-- 抽签结果预览 -->
    <view wx:if="{{preview}}" id="preview" class="preview">
      <view wx:if="{{manualOpts.length}}" class="card">
        <view class="card-title">{{mode === 'bracket' ? '手动排对阵' : '手动分组'}}</view>
        <view class="muted small top">按实际对阵核对。选中其他位置的球员或队伍，会交换两边的位置。</view>
        <picker wx:for="{{manualLabels}}" wx:key="*this" range="{{manualOpts}}" value="{{manualIndexes[index]}}" data-i="{{index}}" bindchange="setManualSlot">
          <view class="manual-row">
            <text class="manual-no">{{item}}</text>
            <text class="manual-name">{{manualOpts[manualIndexes[index]]}}</text>
            <text class="muted">更换 ›</text>
          </view>
        </picker>
      </view>
      <view class="preview-title">对阵预览</view>
      <view wx:if="{{preview.rotRounds}}" class="rot-pv">
        <view wx:for="{{preview.rotRounds}}" wx:key="*this" class="rot-pv-r"><text class="rot-pv-n">第 {{index + 1}} 轮</text><text class="rot-pv-t">{{item}}</text></view>
        <view class="muted small">按名单顺序排：每人和另外三位各搭档一次</view>
      </view>
      <draw-board wx:else draw="{{preview}}" />
      <view class="actions">
        <view wx:if="{{!preview.rotRounds && !manualOpts.length}}" class="btn-line redo" hover-class="tap-on" bindtap="doDraw">重新抽</view>
        <view class="btn-primary grow {{saving ? 'disabled' : ''}}" hover-class="tap-on" bindtap="save">{{saving ? '保存中…' : (editingMatchups ? '保存对阵' : fromSignup ? '确定，生成对阵' : '创建活动，生成对阵')}}</view>
      </view>
    </view>
  </block>

  <block wx:else>
    <!-- 开放报名时先加入的球友（可选）：已经确定参加的，创建后由管理员代报名，其余名额照常开放 -->
    <!-- 选填项：不用大号卡片标题，做成和表单项一样大小的一行（2026-11-24 用户嫌标题太大） -->
    <view class="card pre-card">
      <view class="pre-head">
        <view class="pre-t">
          <view class="pre-h">先加入的球友<text class="pre-opt">{{pre.length ? '已选 ' + pre.length + (type === 'double' && mode !== 'rotation' ? ' 队' : ' 人') : '选填'}}</text></view>
          <view class="pre-d">{{pre.length ? '创建后按顺序加进报名名单，其余名额开放报名' : '已确定参加的可以先加上，创建后在活动详情里也能加'}}</view>
        </view>
        <view class="btn-line mini" hover-class="tap-on" bindtap="openPre">＋ 添加</view>
      </view>
      <view wx:if="{{pre.length}}" class="pre-list">
      <view wx:for="{{pre}}" wx:key="key" class="pre-row">
        <text class="pre-no">{{index + 1}}</text>
        <text class="pre-n">{{type === 'double' && mode !== 'rotation' ? item.text : item.names}}</text>
        <text class="pre-x" data-i="{{index}}" bindtap="removePre">✕</text>
      </view>
      </view>
    </view>
    <member-sheet wx:if="{{preSheet}}" title="{{preSheet.title}}" sub="{{preSheet.sub}}" list="{{preSheet.list}}" extra="{{preSheet.extra}}" bind:pick="prePick" bind:extra="preSolo" bind:close="closePre" />
    <view class="btn-primary {{saving ? 'disabled' : ''}}" hover-class="tap-on" bindtap="publishSignup">{{saving ? '创建中…' : '开始报名'}}</view>
  </block>
</view>

</block>
