<!-- 朋友圈单页模式（utils/timeline.js）：只有固定介绍，不读任何数据；底部「前往小程序」是微信自带的 -->
<view wx:if="{{timeline}}" class="page">
  <view class="tl-card bg-host">
    <image class="bg-img" src="/images/bg-gate.jpg" mode="aspectFill" />
    <view class="tl-dog"><image class="tl-dog-img" src="/images/dog-smile.png" mode="aspectFit" /></view>
    <view class="tl-title">LULU 网球</view>
    <view class="tl-sub">私人网球活动管理</view>
    <view class="tl-desc">成员在这里报名活动、记录比赛。点下方「前往小程序」，用管理员给的邀请码加入。</view>
  </view>
</view>

<block wx:else>
<!-- 顶部：球场图只作背景，标题和按钮是页面组件，叠在左边一块纯色场地上。
     背景是 3 张轮播（2026-11-23 用户要求，「每页最多一张背景图」的唯一例外）：底下固定 hero-court.jpg，
     hero-2 / hero-3 叠在上面按 slide 淡入淡出（只动 opacity）；文字和按钮不动。三张图都是左边 60% 干净场地 -->
<view class="hero bg-host">
  <image class="bg-img" src="/images/hero-court.jpg" mode="aspectFill" />
  <view class="hero-slides">
    <image class="hero-slide {{slide === 1 ? 'on' : slide === 2 ? 'hold' : 'gone'}}" src="/images/hero-2.jpg" mode="aspectFill" />
    <image class="hero-slide {{slide === 2 ? 'on' : slide === 0 ? 'off' : 'gone'}}" src="/images/hero-3.jpg" mode="aspectFill" />
  </view>
  <view class="hero-dots">
    <view wx:for="{{[0, 1, 2]}}" wx:key="*this" class="hero-dot" data-i="{{item}}" catchtap="pickSlide"><view class="hero-dot-i {{slide === item ? 'on' : ''}}"></view></view>
  </view>
  <view class="hero-in">
    <view class="hero-title">活动</view>
    <view class="hero-sub"><view>查看活动 → 报名参加</view><view>按场次录分 → 自动排名</view></view>
    <view wx:if="{{canPublish}}" class="hero-btn" hover-class="tap-on" bindtap="goNew">＋ 创建球友活动</view>
  </view>
</view>

<view class="page">
  <view class="seg tabs has-thumb">
    <view class="seg-track"><view class="seg-thumb" style="width:33.3333%;transform:translateX({{(tab === 'all' ? 0 : tab === 'mine' ? 1 : 2) * 100}}%)"></view></view>
    <view class="seg-item {{tab === 'all' ? 'on' : ''}}" data-v="all" bindtap="setTab">全部活动</view>
    <view class="seg-item {{tab === 'mine' ? 'on' : ''}}" data-v="mine" bindtap="setTab">我的活动{{mineCount ? ' ' + mineCount : ''}}</view>
    <view class="seg-item {{tab === 'next' ? 'on' : ''}}" data-v="next" bindtap="setTab">我的下一场</view>
  </view>

  <!-- 刚删除的活动：5 分钟内可以撤回 -->
  <view wx:if="{{undo}}" class="card undo-bar ani-in">
    <view class="undo-t">已删除{{undo.title ? '「' + undo.title + '」' : '活动'}}</view>
    <view class="btn-line mini" hover-class="tap-on" bindtap="undoRemove">撤回</view>
    <view class="undo-x" hover-class="tap-on" bindtap="closeUndo">✕</view>
  </view>

  <!-- 我的下一场：只有一场；时间、对手没确定的明确写「待定」；点进活动详情的「场次」并定位到这场 -->
  <block wx:if="{{tab === 'next'}}">
    <view wx:if="{{nextStale && next}}" class="nx-stale">网络异常，下面可能不是最新的安排，下拉刷新重试</view>
    <view wx:if="{{next}}" class="card nx ani-in" hover-class="tap-on" bindtap="openNext">
      <view class="nx-head">
        <text class="nx-title">{{next.title}}</text>
        <text class="nx-stage">{{next.stage}}</text>
      </view>
      <view class="nx-when">
        <text class="nx-time num {{next.time ? '' : 'tbd'}}">{{next.time || '待定'}}</text>
        <view class="nx-wd">
          <text class="nx-date">{{next.dateText}}</text>
          <text class="nx-court">{{next.court}}</text>
        </view>
      </view>
      <view wx:if="{{next.note}}" class="nx-note">{{next.note}}</view>
      <view wx:if="{{next.double && next.partner}}" class="nx-row">
        <text class="nx-k">搭档</text>
        <pl-av wx:for="{{next.partnerP}}" wx:key="name" wx:for-item="p" class="nx-av" uid="{{p.uid}}" name="{{p.name}}" />
        <text class="nx-v">{{next.partner}}</text>
      </view>
      <view class="nx-row">
        <text class="nx-k">对手</text>
        <pl-av wx:for="{{next.oppP}}" wx:key="name" wx:for-item="p" class="nx-av" uid="{{p.uid}}" name="{{p.name}}" />
        <text class="nx-v {{next.oppTbd ? 'tbd' : ''}}">{{next.opponent}}</text>
      </view>
      <view class="nx-foot"><text class="btn-line mini">查看场次 ›</text></view>
    </view>
    <view wx:elif="{{!loading}}" class="empty">
      <image class="empty-art" src="/images/art-net.png" mode="aspectFit" />
      <view>{{nextStale ? '网络异常，暂时查不到你的下一场' : '暂无下一场'}}</view>
      <view wx:if="{{nextStale}}" class="nx-stale-s">下拉刷新重试</view>
    </view>
  </block>

  <view wx:if="{{tab !== 'next' && !shown.length && !loading}}" class="empty">
    <image class="empty-art" src="/images/art-net.png" mode="aspectFit" />
    <view>{{tab === 'mine' ? '你还没有发起或报名活动' : '还没有活动'}}</view>
  </view>

  <view wx:for="{{shown}}" wx:key="_id" class="card draw {{item.st}} {{index < 8 ? 'ani-in' : ''}}" style="animation-delay:{{index < 8 ? index * 62 : 0}}ms" hover-class="tap-on" data-id="{{item._id}}" bindtap="open">
    <!-- 左：日期块；右：名称 + 状态 / 形式一行 / 我的关系和进度 -->
    <view class="d-date {{item.st}} {{item.day.m ? '' : 'tbd'}}">
      <text class="d-band">{{item.day.m || '日期'}}</text>
      <text class="d-day num">{{item.day.d}}</text>
      <text class="d-mw">{{item.day.w}}</text>
    </view>
    <view class="d-body">
      <view class="d-top">
        <view class="d-title">{{item.title}}</view>
        <view class="ui-tag {{item.status.cls}} d-status"><view wx:if="{{item.st === 'sign'}}" class="pulse"></view>{{item.status.text}}</view>
      </view>
      <view wx:if="{{item.pinnedAt || item.cupTag}}" class="d-cup">
        <text wx:if="{{item.pinnedAt}}" class="ui-tag solid d-pin">置顶</text><text wx:if="{{item.cupTag}}" class="ui-tag">{{item.cupTag}}</text>
      </view>
      <view class="d-meta">{{item.meta}}</view>
      <view wx:if="{{item.roleTags.length || item.champion || item.progress}}" class="d-foot">
        <view class="d-roles">
          <text wx:for="{{item.roleTags}}" wx:key="*this" wx:for-item="t" class="d-role">{{t}}</text>
        </view>
        <text wx:if="{{item.champion}}" class="d-champ">冠军 {{item.champion}}</text>
        <view wx:elif="{{item.progressShort}}" class="d-pb">
          <view class="d-pb-track"><view class="d-pb-fill {{index < 8 ? 'ani-grow-x' : ''}}" style="width:{{item.progressPct}}%"></view></view>
          <text class="d-pb-t num">{{item.progressShort}}</text>
        </view>
        <text wx:elif="{{item.progress}}" class="d-prog">{{item.progress}}</text>
      </view>
    </view>
  </view>
  <view wx:if="{{more && tab !== 'next'}}" class="d-more">上滑加载更多</view>
</view>
</block>
