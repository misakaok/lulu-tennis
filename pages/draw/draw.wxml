<view class="hero">
  <view class="hero-title">赛事</view>
  <view class="hero-sub">发布赛事 → 报名 → 抽签分组 → 赛程录分 → 自动晋级排名</view>
  <view class="hero-btn" bindtap="goNew">＋ 发布赛事</view>
</view>

<view class="page">
  <view class="seg tabs">
    <view class="seg-item {{tab === 'all' ? 'on' : ''}}" data-v="all" bindtap="setTab">全部赛事</view>
    <view class="seg-item {{tab === 'mine' ? 'on' : ''}}" data-v="mine" bindtap="setTab">我的赛事{{mineCount ? ' ' + mineCount : ''}}</view>
  </view>
  <view wx:if="{{!shown.length && !loading}}" class="empty">
    <view class="empty-ball"></view>
    <view>{{tab === 'mine' ? '你还没有发起或报名赛事' : '还没有赛事'}}</view>
  </view>

  <view wx:for="{{shown}}" wx:key="_id" class="card draw" data-id="{{item._id}}" bindtap="open">
    <view class="d-top">
      <text class="d-title">{{item.title}}</text>
      <text class="d-arrow">›</text>
    </view>
    <view class="d-tags">
      <text wx:for="{{item.roleTags}}" wx:key="*this" wx:for-item="t" class="tag role">{{t}}</text>
      <text wx:if="{{item.signing}}" class="tag hot">报名中</text>
      <text class="tag main">{{item.modeText}}</text>
      <text class="tag">{{item.typeText}}</text>
      <text wx:if="{{!item.signing}}" class="tag">{{item.count}} {{item.unit}}</text>
      <text wx:if="{{item.seeds}}" class="tag">{{item.seeds}} 个种子</text>
      <text class="tag">{{item.date}}</text>
    </view>
    <view wx:if="{{item.champion}}" class="d-champ">🏆 冠军：{{item.champion}}</view>
    <view wx:elif="{{item.progress}}" class="d-prog">{{item.progress}}</view>
  </view>
</view>
