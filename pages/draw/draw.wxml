<view class="hero">
  <view class="hero-title">活动</view>
  <view class="hero-sub">查看活动 → 报名参加 → 按场次录分 → 自动排名</view>
  <view wx:if="{{canPublish}}" class="hero-btn" hover-class="tap-on" bindtap="goNew">＋ 创建球友活动</view>
</view>

<view class="page">
  <view class="seg tabs">
    <view class="seg-item {{tab === 'all' ? 'on' : ''}}" data-v="all" bindtap="setTab">全部活动</view>
    <view class="seg-item {{tab === 'mine' ? 'on' : ''}}" data-v="mine" bindtap="setTab">我的活动{{mineCount ? ' ' + mineCount : ''}}</view>
    <view class="seg-item {{tab === 'next' ? 'on' : ''}}" data-v="next" bindtap="setTab">我的下一场</view>
  </view>

  <!-- 我的下一场：只有一场；时间、对手没确定的明确写「待定」；点进活动详情的「场次」并定位到这场 -->
  <block wx:if="{{tab === 'next'}}">
    <view wx:if="{{nextStale && next}}" class="nx-stale">网络异常，下面可能不是最新的安排，下拉刷新重试</view>
    <view wx:if="{{next}}" class="card nx ani-in" hover-class="tap-on" bindtap="openNext">
      <view class="nx-head">
        <text class="nx-title">{{next.title}}</text>
        <text class="nx-stage">{{next.stage}}</text>
      </view>
      <view class="nx-when">
        <text class="nx-time {{next.time ? '' : 'tbd'}}">{{next.time || '待定'}}</text>
        <view class="nx-wd">
          <text class="nx-date">{{next.dateText}}</text>
          <text class="nx-court">{{next.court}}</text>
        </view>
      </view>
      <view wx:if="{{next.note}}" class="nx-note">{{next.note}}</view>
      <view wx:if="{{next.double && next.partner}}" class="nx-row">
        <text class="nx-k">搭档</text>
        <pl-av wx:for="{{next.partnerP}}" wx:key="name" wx:for-item="p" class="nx-av" uid="{{p.uid}}" name="{{p.name}}" />
        <text class="nx-v">{{next.partner}}</text>
      </view>
      <view class="nx-row">
        <text class="nx-k">对手</text>
        <pl-av wx:for="{{next.oppP}}" wx:key="name" wx:for-item="p" class="nx-av" uid="{{p.uid}}" name="{{p.name}}" />
        <text class="nx-v {{next.oppTbd ? 'tbd' : ''}}">{{next.opponent}}</text>
      </view>
      <view class="nx-foot"><text class="btn-line mini">查看场次 ›</text></view>
    </view>
    <view wx:elif="{{!loading}}" class="empty">
      <view class="empty-ball"></view>
      <view>{{nextStale ? '网络异常，暂时查不到你的下一场' : '暂无下一场'}}</view>
      <view wx:if="{{nextStale}}" class="nx-stale-s">下拉刷新重试</view>
    </view>
  </block>

  <view wx:if="{{tab !== 'next' && !shown.length && !loading}}" class="empty">
    <view class="empty-ball"></view>
    <view>{{tab === 'mine' ? '你还没有发起或报名活动' : '还没有活动'}}</view>
  </view>

  <view wx:for="{{shown}}" wx:key="_id" class="card draw {{index < 8 ? 'ani-in' : ''}}" style="animation-delay:{{index < 8 ? index * 50 : 0}}ms" hover-class="tap-on" data-id="{{item._id}}" bindtap="open">
    <!-- 左：日期块；右：名称 + 状态 / 形式一行 / 我的关系和进度 -->
    <view class="d-date {{item.st}} {{item.day.m ? '' : 'tbd'}}">
      <text class="d-band">{{item.day.m || '日期'}}</text>
      <text class="d-day">{{item.day.d}}</text>
      <text class="d-mw">{{item.day.w}}</text>
    </view>
    <view class="d-body">
      <view class="d-top">
        <text class="d-title">{{item.title}}</text>
        <text class="ui-tag {{item.status.cls}} d-status">{{item.status.text}}</text>
      </view>
      <view class="d-meta">{{item.meta}}</view>
      <view wx:if="{{item.roleTags.length || item.champion || item.progress}}" class="d-foot">
        <view class="d-roles">
          <text wx:for="{{item.roleTags}}" wx:key="*this" wx:for-item="t" class="d-role">{{t}}</text>
        </view>
        <text wx:if="{{item.champion}}" class="d-champ">🏆 冠军 {{item.champion}}</text>
        <text wx:elif="{{item.progress}}" class="d-prog">{{item.progress}}</text>
      </view>
    </view>
  </view>
</view>
