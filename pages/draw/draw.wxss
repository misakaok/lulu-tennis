/* 顶部球场图：图片铺满（aspectFill，竖向居中裁），文字和按钮放在左边约 56% 的纯色场地上，不压到白线和网球 */
.hero {
  min-height: 300rpx;
  background: #9796C4; /* 图片还没显示出来时的底色，和左边场地颜色接近 */
  color: #fff; padding: 40rpx 36rpx 44rpx; border-radius: 0 0 40rpx 40rpx;
  /* 文字上下居中：普通球友没有「创建球友活动」按钮，内容矮，不居中会全挤在上面、下面空一截 */
  display: flex; flex-direction: column; justify-content: center;
}
.hero-in { width: 56%; }
/* 轮播：hero-2 / hero-3 叠在固定的 hero-court 上面。on 淡入、off 淡出；hold = 上一张先垫着（新的一张淡入时不露出底图），gone = 直接藏起来 */
.hero-slides { position: absolute; left: 0; top: 0; width: 100%; height: 100%; z-index: -1; }
.hero-slide { position: absolute; left: 0; top: 0; width: 100%; height: 100%; opacity: 0; z-index: 1; }
.hero-slide.on { opacity: 1; z-index: 2; transition: opacity 0.6s ease; }
.hero-slide.off { opacity: 0; z-index: 2; transition: opacity 0.6s ease; }
.hero-slide.hold { opacity: 1; z-index: 1; }
.hero-dots { position: absolute; right: 18rpx; bottom: 10rpx; display: flex; }
.hero-dot { padding: 14rpx 8rpx; }
.hero-dot-i { width: 12rpx; height: 12rpx; border-radius: 50%; background: #fff; opacity: 0.45; transition: opacity 0.3s; }
.hero-dot-i.on { opacity: 1; }
.hero-title { font-size: 44rpx; font-weight: 800; text-shadow: 0 2rpx 8rpx rgba(40, 40, 80, 0.25); }
.hero-sub { font-size: 24rpx; line-height: 1.6; opacity: 0.95; margin-top: 10rpx; }
.hero-btn {
  margin-top: 32rpx; height: 84rpx; line-height: 84rpx; text-align: center; border-radius: 42rpx;
  background: #fff; color: #6E6EA3; font-weight: 700; font-size: 29rpx; box-shadow: 0 10rpx 24rpx rgba(40, 40, 80, 0.3);
}
.seg.tabs { margin-bottom: 20rpx; }

/* 活动卡片：左边日期块（记分牌式大数字），右边名称、形式、我的关系和进度 */
.draw { display: flex; align-items: stretch; padding: 24rpx; }
/* 日期块像一页台历：顶上色带写月份（报名中黄绿 / 进行中淡紫渐变 / 已结束灰），下面大字日、小字星期 */
.d-date {
  flex: none; width: 112rpx; border-radius: 20rpx; background: #F3F3F8; overflow: hidden;
  display: flex; flex-direction: column; align-items: center;
  border: 1rpx solid rgba(132, 132, 182, 0.16); box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.7); /* 台历块：细边 + 顶部受光 */
}
.d-band { width: 100%; text-align: center; font-size: 20rpx; font-weight: 700; line-height: 1.6; padding: 4rpx 0; color: #fff; background: linear-gradient(155deg, #A3A3CB, #8484B6); }
.d-date.sign .d-band { background: #C9E33A; color: #2E3600; }
.d-date.done .d-band { background: #C5C5D6; }
.d-day { flex: 1; display: flex; align-items: center; margin-top: 8rpx; font-size: 52rpx; font-weight: 800; line-height: 1.05; color: #6E6EA3; letter-spacing: -0.03em; }
.d-date.done .d-day { color: #A5A5BA; }
/* 已结束的活动标题也降一档：报名中、进行中的在列表里更醒目 */
.draw.done .d-title { color: #646480; font-weight: 600; }
.d-mw { margin: 4rpx 0 12rpx; font-size: 20rpx; line-height: 1.3; color: #70708C; white-space: nowrap; }
.d-date.tbd .d-day { font-size: 28rpx; font-weight: 700; }
.d-body { flex: 1; min-width: 0; margin-left: 24rpx; display: flex; flex-direction: column; } /* 从顶部排：名称和状态标签每张卡都和日期块顶端对齐，不随行数上下浮动 */
.d-top { display: flex; align-items: flex-start; }
/* 名称完整显示：第一行放不下就接着在第二行显示（最多 20 个字），英文单词（如 lulu）尽量不从中间断开 */
.d-title { flex: 1; min-width: 0; font-size: 31rpx; font-weight: 700; line-height: 1.35; color: #323252; word-break: normal; overflow-wrap: break-word; }
.d-status { flex: none; margin: 4rpx 0 0 16rpx; }
.d-meta { margin-top: 10rpx; font-size: 24rpx; line-height: 1.4; color: #70708C; word-break: keep-all; } /* 配合不换行空格：只在「 · 」之间换行 */
.d-foot { display: flex; align-items: center; justify-content: space-between; margin-top: 18rpx; }
.d-roles { display: flex; flex-wrap: wrap; }
.d-role { font-size: 21rpx; line-height: 1.6; padding: 0 12rpx; border-radius: 8rpx; margin-right: 10rpx; color: #6E6EA3; border: 1rpx solid #C9C9E0; }
.d-champ { flex: none; margin-left: 16rpx; font-size: 24rpx; font-weight: 700; color: #2E3600; background: #C9E33A; border-radius: 16rpx; padding: 0 14rpx; line-height: 1.6; }
.d-prog { flex: none; margin-left: 16rpx; font-size: 22rpx; color: #70708C; }
/* 进行中：细进度槽 + 淡紫到黄绿的填充 + 等宽数字 */
.d-pb { flex: none; display: flex; align-items: center; margin-left: 16rpx; }
.d-pb-track { width: 128rpx; height: 6rpx; border-radius: 3rpx; background: #E6E6F0; overflow: hidden; }
.d-pb-fill { height: 100%; border-radius: 3rpx; background: linear-gradient(90deg, #A3A3CB, #C9E33A); }
.d-pb-t { margin-left: 12rpx; font-size: 22rpx; font-weight: 700; color: #6E6EA3; }
/* 已结束但没有冠军的活动（分组循环 / 四人轮换）：进度条和数字一并压淡，突出进行中的活动 */
.draw.done .d-pb-fill { background: #C5C5D6; }
.draw.done .d-pb-t { color: #84849E; font-weight: 600; }
.d-status { display: inline-flex; align-items: center; }

/* 我的下一场：开打时间用记分牌式大数字，待定用灰色 */
.nx { padding: 28rpx 28rpx 24rpx; border-left: 8rpx solid #A3A3CB; background: linear-gradient(180deg, #F4F4FB, #fff 70%); } /* 顶部一层极淡冷紫 */
.nx-head { display: flex; align-items: baseline; flex-wrap: wrap; }
.nx-title { font-size: 31rpx; font-weight: 700; line-height: 1.35; color: #323252; word-break: break-all; margin-right: 16rpx; }
.nx-stage { font-size: 24rpx; color: #6E6EA3; font-weight: 600; }
.nx-when { display: flex; align-items: center; margin-top: 20rpx; }
.nx-time { flex: none; font-size: 64rpx; font-weight: 800; line-height: 1; color: #6E6EA3; letter-spacing: -0.03em; }
.nx-time.tbd { font-size: 44rpx; color: #84849E; }
.nx-wd { flex: 1; min-width: 0; margin-left: 24rpx; display: flex; flex-direction: column; }
.nx-date { font-size: 26rpx; font-weight: 600; color: #2E2E4A; }
.nx-court { margin-top: 4rpx; font-size: 24rpx; color: #70708C; }
.nx-note { margin-top: 14rpx; font-size: 23rpx; color: #70708C; background: #F6F6FB; border-radius: 12rpx; padding: 8rpx 16rpx; }
.nx-row { display: flex; align-items: center; margin-top: 18rpx; font-size: 27rpx; color: #2E2E4A; }
.nx-k { flex: none; width: 72rpx; font-size: 23rpx; color: #84849E; }
.nx-av { width: 44rpx; height: 44rpx; border-radius: 50%; flex: none; display: flex; align-items: center; justify-content: center; font-size: 20rpx; font-weight: 800; color: #2E2E4A; margin-right: 8rpx; }
.nx-v { flex: 1; min-width: 0; margin-left: 4rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-weight: 600; }
.nx-v.tbd { color: #84849E; font-weight: 400; }
.nx-foot { margin-top: 20rpx; text-align: right; }
.nx-stale { margin-bottom: 16rpx; padding: 14rpx 20rpx; border-radius: 16rpx; font-size: 23rpx; color: #6B5200; background: #FBF0C8; } /* 和 .ui-tag.warn 同色 */
.nx-stale-s { margin-top: 8rpx; font-size: 23rpx; color: #84849E; }

/* 朋友圈单页模式的介绍卡（和准入页同一张背景、同一只小狗和影子） */
.tl-card { margin-top: 20rpx; padding: 60rpx 40rpx 48rpx; border-radius: 32rpx; color: #fff; text-align: center; background: #9493C0; box-shadow: 0 12rpx 28rpx rgba(133, 133, 184, 0.3); }
.tl-dog { position: relative; width: 161rpx; height: 200rpx; margin: 0 auto; }
.tl-dog-img { display: block; width: 161rpx; height: 200rpx; }
.tl-dog::before {
  content: ''; position: absolute; left: 50%; top: 166rpx; width: 196rpx; height: 60rpx; margin-left: -98rpx; z-index: -1; border-radius: 50%;
  background: radial-gradient(closest-side, rgba(55, 55, 105, 0.32), rgba(55, 55, 105, 0.22) 50%, rgba(55, 55, 105, 0.07) 80%, rgba(55, 55, 105, 0));
}
.tl-title { margin-top: 20rpx; font-size: 44rpx; font-weight: 900; }
.tl-sub { margin-top: 6rpx; font-size: 26rpx; opacity: 0.95; }
.tl-desc { margin-top: 24rpx; font-size: 25rpx; line-height: 1.7; opacity: 0.95; }

/* LULU 积分活动与置顶标签（名称下面一行）：置顶用浅紫细描边，和右上角实心「进行中」拉开层次 */
.d-cup { margin-top: 10rpx; line-height: 1; }
.d-pin { margin-right: 10rpx; color: #58588A; background: #EFEFF9; border: 1.5rpx solid #C4C4E2; font-weight: 700; }

/* 删除后的撤回提示条 */
.undo-bar { display: flex; align-items: center; padding: 20rpx 24rpx; }
.undo-t { flex: 1; min-width: 0; font-size: 26rpx; line-height: 1.4; color: #2E2E4A; overflow-wrap: break-word; }
.undo-bar .btn-line.mini { flex: none; margin-left: 16rpx; }
.undo-x { flex: none; width: 56rpx; height: 56rpx; line-height: 56rpx; text-align: center; margin-left: 4rpx; font-size: 26rpx; color: #70708C; }

/* 列表底部分页器（和战绩页统一风格） */
.pager {
  display: flex; align-items: center; justify-content: space-between;
  margin-top: 24rpx; padding: 14rpx 16rpx; border-radius: 28rpx; background: #fff;
  border: 1rpx solid rgba(132, 132, 182, 0.14); box-shadow: 0 4rpx 14rpx rgba(84, 84, 146, 0.06);
}
.pg-btn {
  flex: none; height: 64rpx; line-height: 64rpx; padding: 0 26rpx; border-radius: 22rpx;
  background: #EFEFF8; color: #58588A; font-size: 25rpx; font-weight: 700;
}
.pg-btn.off { opacity: 0.36; }
.pg-mid { flex: 1; text-align: center; padding: 0 10rpx; }
.pg-cur { display: inline-flex; align-items: center; font-size: 26rpx; font-weight: 800; color: #2E2E4A; }
.pg-caret { margin-left: 6rpx; font-size: 19rpx; color: #8484B6; }
.pg-tot { margin-top: 2rpx; font-size: 20rpx; color: #84849E; }
