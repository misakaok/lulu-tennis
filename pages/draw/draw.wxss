.hero {
  background: linear-gradient(155deg, #A3A3CB 0%, #8484B6 100%);
  color: #fff; padding: 36rpx 36rpx 44rpx; border-radius: 0 0 40rpx 40rpx;
}
.hero-title { font-size: 40rpx; font-weight: 700; }
.hero-sub { font-size: 24rpx; opacity: 0.92; margin-top: 8rpx; }
.hero-btn {
  margin-top: 32rpx; height: 88rpx; line-height: 88rpx; text-align: center; border-radius: 44rpx;
  background: #fff; color: #6E6EA3; font-weight: 700; font-size: 30rpx; box-shadow: 0 10rpx 24rpx rgba(60, 60, 100, 0.25);
}
.draw { padding: 26rpx 28rpx; }
.d-top { display: flex; justify-content: space-between; align-items: center; }
.d-title { font-size: 32rpx; font-weight: 700; }
.d-arrow { color: #C5C5DA; font-size: 40rpx; }
.d-tags { display: flex; flex-wrap: wrap; margin-top: 14rpx; }
.tag { font-size: 22rpx; padding: 4rpx 14rpx; border-radius: 10rpx; background: #F2F2F8; color: #6C6C86; margin: 0 12rpx 8rpx 0; }
.tag.main { background: #ECECF6; color: #6E6EA3; font-weight: 600; }
.d-champ { margin-top: 10rpx; font-size: 26rpx; font-weight: 700; color: #b45309; }
.d-prog { margin-top: 10rpx; font-size: 24rpx; color: #8686A0; }
.tag.hot { background: #fff1d6; color: #9a6a00; font-weight: 700; }
.seg.tabs { margin-bottom: 20rpx; }
.tag.role { background: #6E6EA3; color: #fff; }
