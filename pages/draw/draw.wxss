/* 顶部球场图：图片铺满（aspectFill，竖向居中裁），文字和按钮放在左边约 56% 的纯色场地上，不压到白线和网球 */
.hero {
  min-height: 300rpx;
  background: #9796C4; /* 图片还没显示出来时的底色，和左边场地颜色接近 */
  color: #fff; padding: 40rpx 36rpx 44rpx; border-radius: 0 0 40rpx 40rpx;
}
.hero-in { width: 56%; }
.hero-title { font-size: 44rpx; font-weight: 800; text-shadow: 0 2rpx 8rpx rgba(40, 40, 80, 0.25); }
.hero-sub { font-size: 24rpx; line-height: 1.6; opacity: 0.95; margin-top: 10rpx; }
.hero-btn {
  margin-top: 32rpx; height: 84rpx; line-height: 84rpx; text-align: center; border-radius: 42rpx;
  background: #fff; color: #6E6EA3; font-weight: 700; font-size: 29rpx; box-shadow: 0 10rpx 24rpx rgba(40, 40, 80, 0.3);
}
.seg.tabs { margin-bottom: 20rpx; }

/* 活动卡片：左边日期块（记分牌式大数字），右边名称、形式、我的关系和进度 */
.draw { display: flex; align-items: stretch; padding: 24rpx; }
/* 日期块像一页台历：顶上色带写月份（报名中黄绿 / 进行中淡紫渐变 / 已结束灰），下面大字日、小字星期 */
.d-date {
  flex: none; width: 112rpx; border-radius: 20rpx; background: #F3F3F8; overflow: hidden;
  display: flex; flex-direction: column; align-items: center;
}
.d-band { width: 100%; text-align: center; font-size: 20rpx; font-weight: 700; line-height: 1.6; padding: 4rpx 0; color: #fff; background: linear-gradient(155deg, #A3A3CB, #8484B6); }
.d-date.sign .d-band { background: #C9E33A; color: #2E3600; }
.d-date.done .d-band { background: #C5C5D6; }
.d-day { flex: 1; display: flex; align-items: center; margin-top: 8rpx; font-size: 52rpx; font-weight: 800; line-height: 1.05; color: #6E6EA3; font-variant-numeric: tabular-nums; }
.d-date.done .d-day { color: #A5A5BA; }
.d-mw { margin: 4rpx 0 12rpx; font-size: 20rpx; line-height: 1.3; color: #8686A0; white-space: nowrap; }
.d-date.tbd .d-day { font-size: 28rpx; font-weight: 700; }
.d-body { flex: 1; min-width: 0; margin-left: 24rpx; display: flex; flex-direction: column; justify-content: center; }
.d-top { display: flex; align-items: flex-start; }
.d-title { flex: 1; min-width: 0; font-size: 31rpx; font-weight: 700; line-height: 1.35; color: #1E1E32; word-break: break-all; }
.d-status { flex: none; margin: 4rpx 0 0 16rpx; }
.d-meta { margin-top: 10rpx; font-size: 24rpx; line-height: 1.4; color: #8686A0; word-break: keep-all; } /* 配合不换行空格：只在「 · 」之间换行 */
.d-foot { display: flex; align-items: center; justify-content: space-between; margin-top: 18rpx; }
.d-roles { display: flex; flex-wrap: wrap; }
.d-role { font-size: 21rpx; line-height: 1.6; padding: 0 12rpx; border-radius: 8rpx; margin-right: 10rpx; color: #6E6EA3; border: 1rpx solid #C9C9E0; }
.d-champ { flex: none; margin-left: 16rpx; font-size: 24rpx; font-weight: 700; color: #2E3600; background: #C9E33A; border-radius: 16rpx; padding: 0 14rpx; line-height: 1.6; }
.d-prog { flex: none; margin-left: 16rpx; font-size: 22rpx; color: #8686A0; }

/* 我的下一场：开打时间用记分牌式大数字，待定用灰色 */
.nx { padding: 28rpx 28rpx 24rpx; border-left: 8rpx solid #A3A3CB; }
.nx-head { display: flex; align-items: baseline; flex-wrap: wrap; }
.nx-title { font-size: 31rpx; font-weight: 700; line-height: 1.35; color: #1E1E32; word-break: break-all; margin-right: 16rpx; }
.nx-stage { font-size: 24rpx; color: #6E6EA3; font-weight: 600; }
.nx-when { display: flex; align-items: center; margin-top: 20rpx; }
.nx-time { flex: none; font-size: 64rpx; font-weight: 800; line-height: 1; color: #6E6EA3; font-variant-numeric: tabular-nums; }
.nx-time.tbd { font-size: 44rpx; color: #A5A5BA; }
.nx-wd { flex: 1; min-width: 0; margin-left: 24rpx; display: flex; flex-direction: column; }
.nx-date { font-size: 26rpx; font-weight: 600; color: #1E1E32; }
.nx-court { margin-top: 4rpx; font-size: 24rpx; color: #8686A0; }
.nx-note { margin-top: 14rpx; font-size: 23rpx; color: #8686A0; background: #F6F6FB; border-radius: 12rpx; padding: 8rpx 16rpx; }
.nx-row { display: flex; align-items: center; margin-top: 18rpx; font-size: 27rpx; color: #1E1E32; }
.nx-k { flex: none; width: 72rpx; font-size: 23rpx; color: #A5A5BA; }
.nx-av { width: 44rpx; height: 44rpx; border-radius: 50%; flex: none; display: flex; align-items: center; justify-content: center; font-size: 20rpx; font-weight: 800; color: #22223a; margin-right: 8rpx; }
.nx-v { flex: 1; min-width: 0; margin-left: 4rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-weight: 600; }
.nx-v.tbd { color: #A5A5BA; font-weight: 400; }
.nx-foot { margin-top: 20rpx; text-align: right; }
.nx-stale { margin-bottom: 16rpx; padding: 14rpx 20rpx; border-radius: 16rpx; font-size: 23rpx; color: #6B5200; background: #FBF0C8; } /* 和 .ui-tag.warn 同色 */
.nx-stale-s { margin-top: 8rpx; font-size: 23rpx; color: #A5A5BA; }

/* 朋友圈单页模式的介绍卡（和准入页同一张背景、同一只小狗和影子） */
.tl-card { margin-top: 20rpx; padding: 60rpx 40rpx 48rpx; border-radius: 32rpx; color: #fff; text-align: center; background: #9493C0; box-shadow: 0 12rpx 28rpx rgba(133, 133, 184, 0.3); }
.tl-dog { position: relative; width: 161rpx; height: 200rpx; margin: 0 auto; }
.tl-dog-img { display: block; width: 161rpx; height: 200rpx; }
.tl-dog::before {
  content: ''; position: absolute; left: 50%; top: 166rpx; width: 196rpx; height: 60rpx; margin-left: -98rpx; z-index: -1; border-radius: 50%;
  background: radial-gradient(closest-side, rgba(55, 55, 105, 0.32), rgba(55, 55, 105, 0.22) 50%, rgba(55, 55, 105, 0.07) 80%, rgba(55, 55, 105, 0));
}
.tl-title { margin-top: 20rpx; font-size: 44rpx; font-weight: 900; }
.tl-sub { margin-top: 6rpx; font-size: 26rpx; opacity: 0.95; }
.tl-desc { margin-top: 24rpx; font-size: 25rpx; line-height: 1.7; opacity: 0.95; }
