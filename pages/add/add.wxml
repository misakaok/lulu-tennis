<view wx:if="{{!canRecordDaily && authError}}" class="page muted">{{authError}}</view>
<block wx:elif="{{canRecordDaily}}">
<view class="page">
  <!-- 顶部概要：选好双方、规则就跟着变；整页唯一的重点色块 -->
  <view class="hero">
    <view class="hero-main">
      <view class="hero-k">日常比赛{{dayText ? ' · ' + dayText : ''}}</view>
      <view class="hero-vs"><text>{{aLabel === 'A 方' ? '我' : aLabel}}</text><text class="hero-x">vs</text><text class="{{bLabel === 'B 方' ? 'hero-dim' : ''}}">{{bLabel === 'B 方' ? '待选对手' : bLabel}}</text></view>
      <view class="hero-s">{{type === 'double' ? '双打' : '单打'}} · {{setGames}} 局制 · {{bestOf === 3 ? '三盘两胜' : '一盘'}}</view>
    </view>
    <image class="hero-art" src="/images/art-ball.png" mode="aspectFit" />
  </view>
  <view class="event-tip" hover-class="tap-on" bindtap="goEvents">提交后直接计入战绩，参加者可在比赛详情里修改。活动里的比赛请到「活动」按场次录分 ›</view>
  <view wx:if="{{!fromScorer}}" class="sc-row">
    <view class="sc-t">打球时可以用场边记分逐分记，打完自动填好局分</view>
    <view class="btn-line mini" hover-class="tap-on" bindtap="openScorer">{{scorerResume ? '继续场边记分' : '场边记分'}}</view>
  </view>
  <view wx:if="{{fromScorer}}" class="scorer-tip">已带入场边记分的规则和比分：选好搭档和对手、核对比分后再保存。返回不会保存，记分还留在本机</view>
  <view wx:if="{{noProfile}}" class="card np" hover-class="tap-on" bindtap="goProfile">先设置自己的昵称，才能记录比赛 ›</view>
  <!-- 基本信息 -->
  <view class="card">
    <view class="line">
      <text class="label">比赛日期</text>
      <picker mode="date" value="{{date}}" end="{{today}}" bindchange="onDate">
        <view class="picker">{{date}} <text class="arrow">›</text></view>
      </picker>
    </view>
    <view class="field">
      <text class="label">类型</text>
      <view class="seg">
        <view class="seg-item {{type === 'single' ? 'on' : ''}}" data-v="single" bindtap="setType">单打</view>
        <view class="seg-item {{type === 'double' ? 'on' : ''}}" data-v="double" bindtap="setType">双打</view>
      </view>
    </view>
    <view class="field">
      <text class="label">每盘局数</text>
      <view class="seg">
        <view class="seg-item {{setGames === 4 ? 'on' : ''}}" data-v="4" bindtap="setGames">4 局制（3:3 抢七）</view>
        <view class="seg-item {{setGames === 6 ? 'on' : ''}}" data-v="6" bindtap="setGames">6 局制（6:6 抢七）</view>
      </view>
    </view>
    <view class="field">
      <text class="label">抢七规则</text>
      <view class="seg">
        <view class="seg-item {{noAd ? 'on' : ''}}" data-v="1" bindtap="setNoAd">金球（净胜 1 分）</view>
        <view class="seg-item {{noAd ? '' : 'on'}}" data-v="0" bindtap="setNoAd">占先（净胜 2 分）</view>
      </view>
    </view>
    <view class="field">
      <text class="label">盘数</text>
      <view class="seg">
        <view class="seg-item {{bestOf === 1 ? 'on' : ''}}" data-v="1" bindtap="setBestOf">一盘</view>
        <view class="seg-item {{bestOf === 3 ? 'on' : ''}}" data-v="3" bindtap="setBestOf">三盘两胜</view>
      </view>
    </view>
    <view class="rules-tip">{{rulesText}}</view>
  </view>

  <!-- 球员 -->
  <view class="card">
    <view class="card-title">选择对手<text class="sub">你固定在 A 方；点一个位置，再点下面的球员</text></view>
    <view class="vs-box">
      <view class="side">
        <view wx:for="{{slotsA}}" wx:key="key" class="slot a {{item.active ? 'active' : ''}} {{item.name ? 'filled' : ''}}"
          data-key="{{item.key}}" bindtap="tapSlot">
          <pl-av wx:if="{{item.name}}" class="avatar sm" name="{{item.name}}" />
          <text class="slot-name">{{item.name || item.placeholder}}</text>
        </view>
      </view>
      <view class="vs">VS</view>
      <view class="side">
        <view wx:for="{{slotsB}}" wx:key="key" class="slot b {{item.active ? 'active' : ''}} {{item.name ? 'filled' : ''}}"
          data-key="{{item.key}}" bindtap="tapSlot">
          <pl-av wx:if="{{item.name}}" class="avatar sm" name="{{item.name}}" />
          <text class="slot-name">{{item.name || item.placeholder}}</text>
        </view>
      </view>
    </view>

    <view class="chips">
      <view wx:for="{{chips}}" wx:key="name" class="chip {{item.used ? 'used' : ''}}" data-name="{{item.name}}" bindtap="pickPlayer">
        {{item.name}}<text wx:if="{{item.gender}}" class="chip-g">{{item.gender}}</text>
      </view>
      <view wx:if="{{!chips.length}}" class="chips-empty">还没有其他已注册的球员。请球友先在「我的」里设置资料</view>
    </view>
    <view class="chips-note">只能选设置过资料的球员：战绩按账号累计</view>
  </view>

  <!-- 比分 -->
  <view class="card">
    <view class="card-title">比分</view>
    <score-sets id="sets" init="{{initSets}}" set-games="{{setGames}}" no-ad="{{noAd}}" best-of="{{bestOf}}" a-label="{{aLabel}}" b-label="{{bLabel}}" bind:change="onSets" />
    <view class="result {{check.ok ? 'ok' : ''}}">{{check.msg}}</view>
  </view>

  <view class="btn-primary {{check.ok && !submitting ? '' : 'disabled'}}" hover-class="tap-on" bindtap="submit">{{submitting ? '保存中…' : '保存比分'}}</view>
</view>

</block>
