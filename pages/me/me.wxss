/* 注意：player-home 组件会套用本页样式，本页新类名不要和组件里的类名重名（箭头叫 .me-go 就是这个原因）
   两张入口卡共用的标题行：图标圆 + 标题 / 说明 + 箭头，垂直居中 */
.hd { display: flex; align-items: center; }
.hd-ic { flex: none; width: 76rpx; height: 76rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: #EFEFF6; }
.hd-img { display: block; width: 52rpx; height: 52rpx; }
.hd-img.full { width: 76rpx; height: 76rpx; } /* 击掌章牌本身是圆的，铺满 */
.hd-m { flex: 1; min-width: 0; margin-left: 20rpx; }
.hd-t { display: flex; align-items: center; font-size: 30rpx; line-height: 1.3; font-weight: 800; color: #2E2E4A; }
.hd-s { margin-top: 6rpx; font-size: 22rpx; line-height: 1.3; color: #70708C; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.hd-s.warn { color: #b34d4d; font-weight: 600; }
.me-go { flex: none; margin-left: 12rpx; font-size: 36rpx; line-height: 1; color: #C5C5DA; }

/* 紧凑单行入口卡（我的 LULU 积分、成长档案、成员管理共用统一高度与对齐） */
.me-ent { padding: 24rpx 30rpx; }
.me-yr { margin-left: 12rpx; font-size: 21rpx; font-weight: 600; color: #84849E; }

/* 场边工具（前缀 me-tl-，避免与 player-home 组件类名重名；顶行复用 .hd 和左右 30rpx 留白，和上方入口卡对齐） */
.me-tl-card { padding: 30rpx 30rpx 26rpx; }
.me-tl-grid { display: flex; margin: 22rpx -6rpx 0; }
.me-tl-it {
  flex: 1; margin: 0 6rpx; padding: 20rpx 10rpx 18rpx; border-radius: 22rpx;
  background: #F7F7FC; text-align: center;
  transition: transform 0.16s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.16s ease;
}
.me-tl-ic { width: 56rpx; height: 56rpx; margin: 0 auto 12rpx; border-radius: 18rpx; background-color: #EBEBF7; background-repeat: no-repeat; background-position: center; background-size: 34rpx 34rpx; }
.me-tl-ic1 { background-image: url("data:image/svg+xml;base64,"); }
.me-tl-ic2 { background-image: url("data:image/svg+xml;base64,"); }
.me-tl-ic3 { background-image: url("data:image/svg+xml;base64,"); }
.me-tl-n { font-size: 25rpx; font-weight: 800; color: #2E2E4A; }
.me-tl-d { margin-top: 4rpx; font-size: 19rpx; color: #84849E; }

/* 成员管理 */
.adm-only { margin-left: 12rpx; font-size: 20rpx; }
.adm-n { flex: none; min-width: 40rpx; height: 40rpx; line-height: 40rpx; box-sizing: border-box; padding: 0 12rpx; border-radius: 20rpx; text-align: center; font-size: 22rpx; font-weight: 800; color: #fff; background: #D45B5B; }


/* 页面底部：最后一张卡片自带 24rpx 下边距，再加 4rpx，和左右边距（28rpx）一致 */
.page.me-page { padding-bottom: 4rpx; }
