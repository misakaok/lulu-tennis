<view class="page me-page">
  <player-home id="home" uid="{{myId}}" mine />

  <!-- 我的 LULU 积分：今年的单打 / 双打积分 + 最近一站；只有本人看得到（没开公开展示也一样），点进个人明细 -->
  <view wx:if="{{cup}}" class="card cup" hover-class="tap-on" bindtap="openCup">
    <view class="hd">
      <view class="hd-ic"><image class="hd-img" src="/images/art-trophy.png" mode="aspectFit" /></view>
      <view class="hd-m">
        <view class="hd-t">我的 LULU 积分</view>
        <view class="hd-s">{{cup.year}} 年</view>
      </view>
      <text class="me-go">›</text>
    </view>
    <view wx:if="{{cup.any}}" class="gw-nums">
      <view class="gn"><text class="gn-n">{{cup.single}}</text><text class="gn-l">单打积分</text></view>
      <view class="gn"><text class="gn-n">{{cup.double}}</text><text class="gn-l">双打积分</text></view>
      <view wx:if="{{cup.encounter}}" class="gn"><text class="gn-n">{{cup.encounter}}</text><text class="gn-l">遭遇赛</text></view>
    </view>
    <view wx:else class="gw-empty">今年暂无积分</view>
    <view wx:if="{{cup.last}}" class="cup-last">最近一站 · {{cup.last.date}} {{cup.last.kind}}{{cup.last.format}} · {{cup.last.tier}} <text class="cup-pts">+{{cup.last.total}}</text></view>
  </view>

  <!-- 成长档案：只有自己看得到的私人记录，和正式战绩分开统计 -->
  <view class="card gw" hover-class="tap-on" bindtap="openGrowth">
    <view class="hd">
      <view class="hd-ic"><image class="hd-img" src="/images/art-basket.png" mode="aspectFit" /></view>
      <view class="hd-m">
        <view class="hd-t">我的成长档案</view>
      </view>
      <text class="me-go">›</text>
    </view>
    <block wx:if="{{gw.played}}">
      <view class="gw-nums">
        <view class="gn"><text class="gn-n">{{gw.played}}</text><text class="gn-l">记录场数</text></view>
        <view class="gn"><text class="gn-n">{{gw.rate}}<text class="gn-u">%</text></text><text class="gn-l">胜率</text></view>
        <view class="gn"><text class="gn-n">{{gw.month}}</text><text class="gn-l">本月</text></view>
      </view>
      <view class="gw-chart">
        <view wx:for="{{gw.trend}}" wx:key="ym" class="gc">
          <view class="gc-box"><view class="gc-bar {{index === 5 ? 'now' : ''}}" style="height:{{item.h}}%"></view></view>
          <text class="gc-l {{index === 5 ? 'now' : ''}}">{{item.label}}</text>
        </view>
      </view>
    </block>
    <block wx:else>
      <view class="gw-empty">记录约球、练习赛，看自己的胜率和每月走势</view>
      <view class="btn-line gw-add" hover-class="tap-on" catchtap="addGrowth">记第一场</view>
    </block>
  </view>

  <!-- 成员管理：仅管理员，放在最下面 -->
  <view wx:if="{{isAdmin}}" class="card adm" hover-class="tap-on" bindtap="openMembers">
    <view class="hd">
      <view class="hd-ic"><image class="hd-img full" src="/images/badges/social.png" mode="aspectFit" /></view>
      <view class="hd-m">
        <view class="hd-t">成员管理<text class="ui-tag adm-only">仅管理员</text></view>
        <view class="hd-s {{pendingApply ? 'warn' : ''}}">{{pendingApply ? pendingApply + ' 个新申请等你审核' : '审核申请、邀请、移除成员'}}</view>
      </view>
      <text wx:if="{{pendingApply}}" class="adm-n">{{pendingApply}}</text>
      <text class="me-go">›</text>
    </view>
  </view>
</view>
