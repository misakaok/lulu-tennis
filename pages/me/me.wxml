<view class="page me-page">
  <player-home id="home" uid="{{myId}}" mine />

  <!-- 我的 LULU 积分：紧凑入口行，点进个人明细看各站拆解 -->
  <view wx:if="{{cup}}" class="card me-ent" hover-class="tap-on" bindtap="openCup">
    <view class="hd">
      <view class="hd-ic"><image class="hd-img" src="/images/art-trophy.png" mode="aspectFit" /></view>
      <view class="hd-m">
        <view class="hd-t">我的 LULU 积分<text class="me-yr">{{cup.year}} 年</text></view>
        <view wx:if="{{cup.any}}" class="hd-s">单打积分 {{cup.single}} · 双打积分 {{cup.double}}<text wx:if="{{cup.encounter}}"> · 遭遇赛 {{cup.encounter}}</text></view>
        <view wx:else class="hd-s">今年暂无积分<text wx:if="{{cup.last}}"> · 最近一站 {{cup.last.date}} {{cup.last.tier}}</text></view>
      </view>
      <text class="me-go">›</text>
    </view>
  </view>

  <!-- 成长档案：紧凑入口行，点进查看私人记录与月度趋势 -->
  <view class="card me-ent" hover-class="tap-on" bindtap="openGrowth">
    <view class="hd">
      <view class="hd-ic"><image class="hd-img" src="/images/art-basket.png" mode="aspectFit" /></view>
      <view class="hd-m">
        <view class="hd-t">我的成长档案</view>
        <view wx:if="{{gw && gw.played}}" class="hd-s">已记 {{gw.played}} 场 · 胜率 {{gw.rate}}% · 本月 {{gw.month}} 场</view>
        <view wx:elif="{{gw}}" class="hd-s">记录约球、练习赛，看自己的胜率与走势</view>
      </view>
      <text class="me-go">›</text>
    </view>
  </view>

  <!-- 场边工具：纯本地球场常用小工具（记分 / AA 算账 / 双打排班） -->
  <view class="card me-tl-card">
    <view class="hd">
      <view class="hd-ic"><image class="hd-img" src="/images/art-tools.png" mode="aspectFit" /></view>
      <view class="hd-m">
        <view class="hd-t">场边工具</view>
      </view>
    </view>
    <view class="me-tl-grid">
      <view class="me-tl-it" hover-class="tap-on" bindtap="openScorer">
        <view class="me-tl-ic me-tl-ic1"></view>
        <view class="me-tl-n">场边记分</view>
        <view class="me-tl-d">转拍 · 计时 · 统计</view>
      </view>
      <view class="me-tl-it" hover-class="tap-on" bindtap="openAA">
        <view class="me-tl-ic me-tl-ic2"></view>
        <view class="me-tl-n">AA 算账</view>
        <view class="me-tl-d">场地 · 用球均摊</view>
      </view>
      <view class="me-tl-it" hover-class="tap-on" bindtap="openMixer">
        <view class="me-tl-ic me-tl-ic3"></view>
        <view class="me-tl-n">双打排班</view>
        <view class="me-tl-d">4~8 人均衡轮换</view>
      </view>
    </view>
  </view>

  <!-- 成员管理：仅管理员，放在最下面 -->
  <view wx:if="{{isAdmin}}" class="card me-ent adm" hover-class="tap-on" bindtap="openMembers">
    <view class="hd">
      <view class="hd-ic"><image class="hd-img full" src="/images/badges/social.png" mode="aspectFit" /></view>
      <view class="hd-m">
        <view class="hd-t">成员管理<text class="ui-tag adm-only">仅管理员</text></view>
        <view class="hd-s {{pendingApply ? 'warn' : ''}}">{{pendingApply ? pendingApply + ' 个新申请等你审核' : '审核申请、邀请、移除成员'}}</view>
      </view>
      <text wx:if="{{pendingApply}}" class="adm-n">{{pendingApply}}</text>
      <text class="me-go">›</text>
    </view>
  </view>
</view>
