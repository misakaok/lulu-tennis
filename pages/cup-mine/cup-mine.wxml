<!-- 我的 LULU 积分：只有本人看得到。年度 → 单打 / 双打 / 遭遇赛 → 总分 + 每站明细（名次、基础分、奖励分、合计） -->
<view class="page">
  <view wx:if="{{loading}}" class="empty">加载中…</view>
  <view wx:elif="{{error}}" class="card cm-err">{{error}}</view>
  <block wx:else>
    <view wx:if="{{years.length > 1}}" class="cm-years">
      <view wx:for="{{years}}" wx:key="*this" class="cm-year {{item === year ? 'on' : ''}}" data-v="{{item}}" bindtap="setYear">{{item}}</view>
    </view>

    <view class="seg cm-seg">
      <view wx:for="{{tabs}}" wx:key="value" class="seg-item {{which === item.value ? 'on' : ''}}" data-v="{{item.value}}" bindtap="setWhich">{{item.label}}</view>
    </view>

    <view class="card cm-sum">
      <view class="cm-sum-l">{{year}} 年{{whichText}}积分{{which === 'encounter' ? '（单独统计）' : ''}}</view>
      <view class="cm-sum-n">{{sum.total}}</view>
      <view class="cm-sum-s">计入 {{sum.stops}} 站<text wx:if="{{sum.champions}}"> · 冠军 {{sum.champions}} 次</text></view>
      <view wx:if="{{bestGroup}}" class="cm-sum-s">年终计入：{{bestGroup}}</view>
    </view>

    <view wx:if="{{meHidden}}" class="cm-hint" bindtap="openShown">你没有开启公开展示，积分榜上显示为「球友」；这里的积分只有你自己看得到 ›</view>

    <view wx:if="{{items.length}}" class="card cm-list">
      <view wx:if="{{groupTotals.length}}" class="cm-sub">
        <text wx:for="{{groupTotals}}" wx:key="name">{{index ? ' · ' : ''}}{{item.name}} {{item.total}} 分</text>
      </view>
      <view wx:for="{{items}}" wx:key="i" class="cm-row">
        <view class="cm-top">
          <text class="cm-date">{{item.date}}</text>
          <text class="cm-kind">{{item.kind}} · {{item.format}}</text>
          <text class="ui-tag {{item.champion ? 'lime' : ''}}">{{item.tier}}</text>
          <text class="cm-total">+{{item.total}}</text>
        </view>
        <view wx:if="{{item.partner}}" class="cm-sub">和 {{item.partner}} 一队</view>
        <view wx:if="{{!item.counted}}" class="cm-sub">已记入该组，本年度未计入最高组总分</view>
        <view class="cm-pts">
          <text>基础 {{item.base}}</text>
          <text wx:if="{{item.split}}">（{{item.split}}）</text>
          <text wx:if="{{item.bonus}}"> · 奖励 {{item.bonus}}（{{item.bonusText}}）</text>
          <text> · 合计 {{item.total}}</text>
        </view>
      </view>
    </view>
    <view wx:else class="empty">
      <image class="empty-art" src="/images/art-trophy.png" mode="aspectFit" />
      <view>这一年还没有{{whichText}}积分</view>
    </view>
  </block>
</view>
