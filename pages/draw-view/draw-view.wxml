<view class="page">
  <view wx:if="{{error}}" class="empty">
    <image class="empty-art" src="/images/art-ball.png" mode="aspectFit" />
    <view>{{error}}</view>
    <view class="btn-primary small" hover-class="tap-on" bindtap="goHome">返回活动列表</view>
  </view>

  <block wx:if="{{draw}}">
    <!-- 背景：几乎全是场地纹理，只在右上角有调暗的十字线（images/bg-event.jpg），整张卡都有字 -->
    <view class="head card bg-host">
      <image class="bg-img" src="/images/bg-event.jpg" mode="aspectFill" />
      <view class="h-title">{{draw.title}}</view>
      <view class="h-meta">{{meta}} · {{draw.date}}</view>
      <!-- 积分标签 + 右边管理员的「置顶」（半透明白；已置顶是实心白「已置顶」，再点确认后取消） -->
      <view wx:if="{{cupTag || canEdit}}" class="h-cup">
        <block wx:if="{{cupTag}}">
          <view wx:if="{{canEditCup}}" class="ui-tag solid h-cup-action" hover-class="tap-on" bindtap="editCupKind">
            <text>{{cupTag}}</text><text class="h-cup-edit">›</text>
          </view>
          <text wx:else class="ui-tag solid">{{cupTag}}</text>
        </block>
        <view wx:if="{{canEdit}}" class="h-pin {{draw.pinnedAt ? 'on' : ''}} {{pinBusy ? 'busy' : ''}}" hover-class="tap-on" bindtap="togglePin">{{draw.pinnedAt ? '已置顶' : '置顶'}}</view>
      </view>
      <view wx:if="{{ended}}" class="h-ended">已提前结束{{endReason ? '（' + endReason + '）' : ''}} · 已录比分照常保留，未打场次不再继续</view>
      <view wx:if="{{levelText}}" class="h-level">建议水平 {{levelText}}<text class="h-level-s">仅供参考，不限制报名</text></view>
      <view class="h-rules">
        <view class="hr-title">
          <text>规则 · {{formatText}}</text>
          <view wx:if="{{signing && !ended && canEdit}}" class="hr-edit" hover-class="tap-on" bindtap="goEditSettings">修改规则 ›</view>
        </view>
        <view wx:for="{{rulesSum}}" wx:key="stage" class="hr-row {{item.hl ? 'hl' : ''}}"><text class="hr-k">{{item.stage}}</text><text class="hr-v">{{item.text}}</text></view>
      </view>
      <view wx:if="{{seedRows.length}}" class="h-seeds"><text class="h-lbl">{{seedLabel}}</text><text wx:for="{{seedRows}}" wx:key="no" class="h-seed">{{item.no}} 号种子 {{item.name}}</text></view>
      <view wx:if="{{!signing && progress}}" class="h-prog">{{progress}}</view>
      <view wx:if="{{signing && signText}}" class="h-prog">{{signText}}</view>
      <view wx:if="{{signing && signNote}}" class="h-note">{{signNote}}</view>
    </view>

    <!-- LULU 积分结算（只有管理员看到） -->
    <view wx:if="{{cupBox}}" class="card cup-box">
      <view class="card-title">LULU 积分<text class="sub">管理员</text></view>
      <view class="cb-note {{cupBox.warn ? 'warn' : ''}}">{{cupBox.note}}</view>
      <view wx:if="{{cupBox.btn}}" class="{{cupBox.primary ? 'btn-primary' : 'btn-line'}} cb-btn" hover-class="tap-on" bindtap="openCupSettle">{{cupBox.btn}}</view>
    </view>

    <!-- 时间地点 -->
    <view class="card info">
      <view class="card-title row">
        <text>时间地点</text>
        <view class="in-acts">
          <view class="btn-line mini" hover-class="tap-on" bindtap="openAA">AA 算账</view>
          <view wx:if="{{canEdit}}" class="btn-line mini in-edit" hover-class="tap-on" bindtap="goEdit">编辑</view>
        </view>
      </view>
      <view class="in-row"><text class="in-k">时间</text><text class="in-v">{{info.when || '暂无'}}</text></view>
      <block wx:if="{{!info.empty}}">
        <view wx:if="{{info.place}}" class="in-row">
          <text class="in-k">地点</text>
          <view class="in-v"><view class="in-place">{{info.place.name || info.place.address}}</view><view wx:if="{{info.place.name && info.place.address}}" class="in-addr">{{info.place.address}}</view></view>
        </view>
        <view class="in-row"><text class="in-k">场地</text><text class="in-v">{{info.venue || '暂无'}}</text></view>
        <view wx:if="{{info.canNav}}" class="nav-btn" hover-class="tap-on" bindtap="openMap">打开地图导航</view>
      </block>
      <view wx:else class="muted">{{canEdit ? '还没有填写场地，点右上角「编辑」补充' : '发起人还没有填写场地'}}</view>
    </view>

    <!-- 报名中 -->
    <block wx:if="{{signing}}">
      <view class="card su-card">
        <view class="card-title row">
          <text>报名名单</text>
          <text class="count">{{signCount}}</text>
        </view>
        <!-- 先用本机缓存画的页面（ready 为假）：本机记着上次的名单就先显示名单（只是显示），没有就先空着（不写读取中的提示，2026-11-25 用户要求）；读完前不说「还没有人报名」 -->
        <view wx:if="{{!ready && !signups.length}}" class="muted"></view>
        <view wx:elif="{{ready && !signups.length}}" class="muted">还没有人报名，把它分享到群里吧</view>

        <view wx:for="{{signups}}" wx:key="_id" class="su-team">
          <view wx:for="{{item.members}}" wx:key="name" wx:for-item="p" class="su-row" hover-class="tap-row-on" data-uid="{{p.uid}}" bindtap="openPlayer">
            <text class="su-no">{{index === 0 ? item.no : ''}}</text>
            <pl-av class="su-av2 init" uid="{{p.uid}}" name="{{p.name}}" />
            <view class="su-main">
              <view class="su-top"><text class="su-nm">{{p.name}}</text><text class="su-g {{p.gender === '暂无' ? 'none' : ''}}">{{p.gender}}</text></view>
              <view class="su-stats">
                <text>排名 <text class="v {{p.rank === '暂无' || p.rank === '未公开' ? 'none' : ''}}">{{p.rank}}</text></text>
                <text>场数 <text class="v {{p.played === '暂无' ? 'none' : ''}}">{{p.played}}</text></text>
                <text>胜率 <text class="v {{p.rate === '暂无' ? 'none' : ''}}">{{p.rate}}</text></text>
              </view>
            </view>
            <view class="su-lv2 {{p.level === '暂无' ? 'none' : ''}}">{{p.level}}</view>
            <text class="su-go">›</text>
          </view>
          <view wx:if="{{item.waiting}}" class="su-solo su-wait">候补中：前面有人取消就自动递补</view>
          <view wx:elif="{{isDouble && !isRot && item.solo}}" class="su-solo">找搭档中，由发起人配对</view>
        </view>
        <block wx:if="{{!ended}}"><view wx:if="{{canEdit && ready}}" class="su-add"><view class="btn-line mini {{adminBusy ? 'disabled' : ''}}" hover-class="tap-on" bindtap="openAdminSignup">{{adminBusy ? '读取成员…' : '＋ 添加报名'}}</view></view></block>
      </view>
      <!-- 管理员代报名：选人弹层（双打接着选搭档，可以不带） -->
      <member-sheet wx:if="{{adminSheet}}" title="{{adminSheet.title}}" sub="{{adminSheet.sub}}" list="{{adminSheet.list}}" extra="{{adminSheet.extra}}" bind:pick="adminPick" bind:extra="adminSolo" bind:close="closeAdminSheet" />

      <view wx:if="{{ready && joined}}" class="joined">
        <view class="joined-ic">✓</view>
        <view class="joined-main">
          <view class="joined-t">{{myWaiting ? '你在候补名单里' : '你已报名'}}</view>
          <view class="joined-s">{{ended ? '活动已提前结束' : (isDouble && !isRot ? '截止报名前可以取消，会连同搭档一起取消' : '截止报名前可以随时取消')}}</view>
        </view>
        <view wx:if="{{!ended}}" class="btn-line mini quit" hover-class="tap-on" bindtap="quit">取消报名</view>
      </view>
      <block wx:if="{{!ended}}"><view wx:if="{{ready && canEdit && (!isRot || canPublish)}}" class="btn-line owner" hover-class="tap-on" bindtap="startDraw">{{canPublish ? '截止报名，生成' : '截止报名，手动排'}}{{draw.mode === 'bracket' || isRot ? '对阵' : '分组'}}</view></block>
    </block>

    <!-- 已抽签：签表 / 积分榜 + 赛程 -->
    <block wx:else>
      <view class="seg tabs has-thumb">
        <view class="seg-track"><view class="seg-thumb" style="width:50%;transform:translateX({{tab === 'schedule' ? 100 : 0}}%)"></view></view>
        <view class="seg-item tab {{tab === 'board' ? 'on' : ''}}" data-v="board" bindtap="setTab">{{isRot ? '三轮对阵' : draw.mode === 'groups' ? '积分榜' : draw.mode === 'groups_ko' ? '积分榜 · 对阵表' : '对阵表'}}</view>
        <view class="seg-item tab {{tab === 'schedule' ? 'on' : ''}}" data-v="schedule" bindtap="setTab">场次<text wx:if="{{todo}}" class="dot">{{todo}}</text></view>
      </view>

      <!-- 四人轮换：每轮的搭档、对手和状态（不排总名次）；还没录分的轮次可以直接场边记分 -->
      <view wx:if="{{tab === 'board' && isRot}}" class="rot">
        <view wx:for="{{rotRounds}}" wx:key="key" class="card rot-r {{item.me ? 'mine' : ''}}" hover-class="tap-on" data-key="{{item.key}}" bindtap="tapItem">
          <view class="rot-h"><text class="rot-n">第 {{item.round}} 轮</text><text class="ui-tag {{item.win ? 'lime' : item.done ? '' : item.me ? 'solid' : ''}}">{{item.st}}</text></view>
          <view class="rot-side {{item.winner === 'a' ? 'w' : ''}}">
            <pl-av wx:for="{{item.aP}}" wx:key="name" wx:for-item="p" class="rot-av" uid="{{p.uid}}" name="{{p.name}}" />
            <text class="rot-nm">{{item.aP[0].name}} / {{item.aP[1].name}}</text><text wx:if="{{item.winner === 'a'}}" class="rot-win">胜</text>
          </view>
          <view class="rot-vs">对</view>
          <view class="rot-side {{item.winner === 'b' ? 'w' : ''}}">
            <pl-av wx:for="{{item.bP}}" wx:key="name" wx:for-item="p" class="rot-av" uid="{{p.uid}}" name="{{p.name}}" />
            <text class="rot-nm">{{item.bP[0].name}} / {{item.bP[1].name}}</text><text wx:if="{{item.winner === 'b'}}" class="rot-win">胜</text>
          </view>
          <view wx:if="{{item.score}}" class="rot-score">{{item.score}}</view>
          <view wx:if="{{item.me}}" class="rot-me">{{item.me}}</view>
          <view wx:if="{{item.canScore}}" class="rot-acts"><view class="btn-line mini" hover-class="tap-on" data-key="{{item.key}}" catchtap="openRotScorer">场边记分</view></view>
        </view>
        <view class="muted center">三轮换搭档，每人和另外三位各搭档一次；不排总名次</view>
      </view>
      <block wx:elif="{{tab === 'board'}}">
        <view wx:if="{{ready && canEditMatchups}}" class="btn-line matchup-edit" hover-class="tap-on" bindtap="editDrawMatchups">手动调整对阵</view>
        <draw-board draw="{{draw}}" matches="{{matches}}" me="{{myName}}" editable="{{true}}" bind:open="onOpen" />
      </block>

      <view wx:else>
        <view class="seg sch-seg has-thumb">
          <view class="seg-track"><view class="seg-thumb" style="width:50%;transform:translateX({{schFilter === 'wd' ? 100 : 0}}%)"></view></view>
          <view class="seg-item {{schFilter === 'all' ? 'on' : ''}}" data-v="all" bindtap="setSchFilter">全部场次</view>
          <view class="seg-item {{schFilter === 'wd' ? 'on' : ''}}" data-v="wd" bindtap="setSchFilter">退赛／弃权{{wdCount ? ' ' + wdCount : ''}}</view>
        </view>
        <view class="sch-bar">
          <text class="muted">{{schFilter === 'wd' ? '只显示参加状态和对场次的影响' : isOwner ? '点击场次录分；可以给每一场安排时间和场地' : '点击场次录入或查看比分'}}</text>
          <text class="mine-tg {{onlyMine ? 'on' : ''}}" bindtap="toggleMine">{{onlyMine ? '✓ ' : ''}}只看我的</text>
        </view>

        <!-- 退赛／弃权：现有的退赛名单和弃权 / 中途退赛 / 成绩取消的场次，不显示原因 -->
        <block wx:if="{{schFilter === 'wd'}}">
          <view wx:if="{{!wdView.entrants.length && !wdView.rows.length}}" class="muted center">{{onlyMine ? '你在这个活动里没有退赛或弃权' : '这个活动没有退赛或弃权'}}</view>
          <view wx:if="{{wdView.entrants.length}}" class="card wdv">
            <view class="card-title">退赛名单<text class="sub">{{wdView.entrants.length}} 位</text></view>
            <view wx:for="{{wdView.entrants}}" wx:key="entrant" class="wdv-p">
              <view class="wdv-top"><text class="wdv-n">{{item.entrant}}</text><text class="ui-tag warn">{{item.status}}</text><text class="wdv-st">{{item.stage}}</text></view>
              <view class="wdv-s">{{item.policy}}</view>
              <view wx:if="{{item.count}}" class="wdv-s">影响 {{item.count}} 场，见下面</view>
            </view>
          </view>
          <view wx:for="{{wdView.rows}}" wx:key="key" class="sch done wdv-r {{item.mine ? 'mine' : ''}}" hover-class="tap-on" data-key="{{item.key}}" bindtap="tapWd">
            <view class="sch-top"><text class="sch-stage">{{item.stage}}</text><text class="ui-tag {{item.kind === 'void' ? '' : 'warn'}}">{{item.status}}</text></view>
            <view class="wdv-vs"><text class="{{item.winner === 'a' ? 'wdv-w' : ''}}">{{item.a}}</text><text class="wdv-x">vs</text><text class="{{item.winner === 'b' ? 'wdv-w' : ''}}">{{item.b}}</text></view>
            <view class="wdv-s">{{item.impact}}</view>
            <view class="wdv-u">{{item.unrated}}</view>
          </view>
        </block>

        <block wx:else>
        <view wx:if="{{!schedule.length}}" class="muted center">{{onlyMine ? '你在这个活动里没有比赛' : '还没有比赛'}}</view>
        <view wx:for="{{schedule}}" wx:key="key" id="sch-{{item.key}}" class="sch {{item.status}} {{item.mine ? 'mine' : ''}} {{focus === item.key ? 'focus' : ''}}" hover-class="tap-on" data-key="{{item.key}}" bindtap="tapItem">
          <view class="sch-top">
            <text class="sch-stage">{{item.stage}}</text>
            <text class="sch-st">{{item.status === 'done' ? '已完赛' : ended ? '未进行' : item.status === 'ready' ? (item.mine ? '待录分 ›' : '待赛') : '待定'}}</text>
          </view>
          <view class="sch-row {{item.winner === 'a' ? 'w' : ''}}">
            <view class="sch-avs">
              <block wx:for="{{item.aP}}" wx:key="name" wx:for-item="p">
                <pl-av class="sch-av init" uid="{{p.uid}}" name="{{p.name}}" />
              </block>
            </view>
            <text wx:if="{{item.aG}}" class="sch-name"><block wx:for="{{item.aP}}" wx:key="name" wx:for-item="p" wx:for-index="pi">{{pi ? ' / ' : ''}}{{p.name}}<text wx:if="{{p.gender}}" class="gd"> {{p.gender}}</text></block></text>
            <text wx:else class="sch-name">{{item.aText}}</text>
            <text wx:if="{{item.winner === 'a'}}" class="sch-win">胜</text>
          </view>
          <view class="sch-row {{item.winner === 'b' ? 'w' : ''}}">
            <view class="sch-avs">
              <block wx:for="{{item.bP}}" wx:key="name" wx:for-item="p">
                <pl-av class="sch-av init" uid="{{p.uid}}" name="{{p.name}}" />
              </block>
            </view>
            <text wx:if="{{item.bG}}" class="sch-name"><block wx:for="{{item.bP}}" wx:key="name" wx:for-item="p" wx:for-index="pi">{{pi ? ' / ' : ''}}{{p.name}}<text wx:if="{{p.gender}}" class="gd"> {{p.gender}}</text></block></text>
            <text wx:else class="sch-name">{{item.bText}}</text>
            <text wx:if="{{item.winner === 'b'}}" class="sch-win">胜</text>
          </view>
          <view wx:if="{{item.score}}" class="sch-score">{{item.score}}</view>
          <view wx:if="{{item.slotText && !item.done}}" class="sch-slot">{{item.slotText}}</view>
          <view class="sch-foot">
            <text class="sch-rule {{item.ruleCustom ? 'hl' : ''}}">{{item.ruleCustom ? '★ ' : ''}}{{item.ruleText}}</text>
            <text wx:if="{{isOwner && !item.done && !ended}}" class="sch-plan" data-key="{{item.key}}" catchtap="planSlot">{{item.slotText ? '修改安排' : '安排时间场地'}}</text>
          </view>
        </view>
        </block>
      </view>
    </block>

    <!-- 退赛 -->
    <view wx:if="{{!signing && (withdrawn.length || wdOwner || canWithdraw || myWd)}}" class="card wd">
      <view class="card-title">退赛<text class="sub">对阵生成后由发起人处理，不直接删除参加者</text></view>
      <view wx:for="{{withdrawn}}" wx:key="entrant" class="wd-row"><text class="wd-n">{{item.entrant}}</text><text class="wd-t">已退赛 · {{item.text}}</text></view>
      <block wx:if="{{wdOwner}}">
        <view wx:for="{{wdPending}}" wx:key="id" class="wd-row">
          <text class="wd-n">{{item.entrant}}</text><text class="wd-t">申请退赛{{item.reason ? '：' + item.reason : ''}}</text>
          <view class="btn-line mini wd-a" hover-class="tap-on" data-i="{{index}}" bindtap="rejectWithdraw">拒绝</view><view class="btn-primary mini wd-a" hover-class="tap-on" data-i="{{index}}" bindtap="approveWithdraw">同意</view>
        </view>
        <picker wx:if="{{!ended && wdCandidates.length}}" range="{{wdCandidates}}" bindchange="ownerWithdraw"><view class="btn-line wd-btn" hover-class="tap-on">登记球员退赛 / 缺席</view></picker>
      </block>
      <block wx:else>
        <view wx:if="{{myWd && myWd.status === 'pending'}}" class="wd-t">你的退赛申请等待发起人处理</view>
        <block wx:else>
          <!-- 被拒绝后保留提示，仍可再次申请（等待处理时不显示按钮） -->
          <view wx:if="{{myWd && myWd.status === 'rejected'}}" class="wd-t">发起人拒绝了你的退赛申请{{myWd.note ? '：' + myWd.note : ''}}</view>
          <view wx:if="{{!ended && canWithdraw}}" class="btn-line wd-btn" hover-class="tap-on" bindtap="requestWithdraw">申请退赛</view>
        </block>
      </block>
    </view>

    <!-- 单场安排（发起人） -->
    <view wx:if="{{slotEdit}}" class="sheet-mask" bindtap="slotCancel"></view>
    <view wx:if="{{slotEdit}}" class="sheet">
      <view class="sheet-t">安排这场比赛</view>
      <view class="sheet-s">{{slotEdit.title}}</view>
      <view class="sheet-row">
        <text class="label">日期</text>
        <picker mode="date" value="{{slotEdit.date || slotEdit.defDate}}" bindchange="slotDate"><view class="sheet-pick {{slotEdit.date ? '' : 'ph'}}">{{slotEdit.date || '选择日期'}} ›</view></picker>
      </view>
      <view class="sheet-row">
        <text class="label">时间</text>
        <picker mode="time" value="{{slotEdit.time || '09:00'}}" bindchange="slotTime"><view class="sheet-pick {{slotEdit.time ? '' : 'ph'}}">{{slotEdit.time || '选择时间'}} ›</view></picker>
      </view>
      <view class="sheet-row">
        <text class="label">场地编号</text>
        <picker range="{{courts}}" value="{{slotEdit.courtIndex}}" bindchange="slotCourt"><view class="sheet-pick {{slotEdit.court ? '' : 'ph'}}">{{courts[slotEdit.courtIndex]}} ›</view></picker>
      </view>
      <view class="sheet-note">没有安排的场次，沿用活动的日期、时间和场地。</view>
      <view class="sheet-acts">
        <view wx:if="{{slotEdit.had}}" class="btn-line sheet-a" hover-class="tap-on" bindtap="slotClear">清除安排</view>
        <view class="btn-line sheet-a" hover-class="tap-on" bindtap="slotCancel">取消</view>
        <view class="btn-primary sheet-a {{busy ? 'disabled' : ''}}" hover-class="tap-on" bindtap="slotSave">保存</view>
      </view>
    </view>

    <!-- 报名、删除等按钮等云端读完（ready）才显示：先用本机缓存画的页面不知道你报没报名 -->
    <!-- 底部按钮：第 1 行 报名（主按钮，报名中、还没报名时才有；双打点了选搭档）+ 分享，只有一个时占满一行；
         第 2 行 删除（管理员「管理员删除」/ 发起人「删除活动」）。置顶在顶部积分标签右边 -->
    <view class="acts">
    <view class="act-row">
      <block wx:if="{{!ended}}"><block wx:if="{{ready && signing && !joined}}">
        <picker wx:if="{{isDouble && !isRot && myName}}" class="act-cell" range="{{partnerOpts}}" bindchange="joinDouble">
          <view class="btn-primary act-btn {{busy ? 'disabled' : ''}}">{{full ? '排队候补' : '我要报名'}}</view>
        </picker>
        <view wx:else class="act-cell"><view class="btn-primary act-btn {{busy ? 'disabled' : ''}}" hover-class="tap-on" bindtap="join">{{full ? '排队候补' : '我要报名'}}</view></view>
      </block></block>
      <view class="act-cell"><button class="share act-btn" open-type="share">{{signing && !ended ? '发给球友报名' : '发给球友'}}</button></view>
    </view>
    <view wx:if="{{ready && canManage}}" class="act-row">
      <view wx:if="{{canClose}}" class="act-cell"><view class="btn-line act-btn {{closeBusy ? 'disabled' : ''}}" hover-class="tap-on" bindtap="closeDraw">提前结束</view></view>
      <view wx:elif="{{canReopen}}" class="act-cell"><view class="btn-line act-btn {{closeBusy ? 'disabled' : ''}}" hover-class="tap-on" bindtap="reopenDraw">恢复活动</view></view>
      <view class="act-cell"><view class="btn-danger act-btn" hover-class="tap-on" bindtap="remove">{{isOwner ? '删除活动' : '管理员删除'}}</view></view>
    </view>
    </view>
  </block>
  <!-- 分享封面用的画布（不显示） -->
  <canvas type="2d" id="share-cv" class="share-cv"></canvas>
</view>
