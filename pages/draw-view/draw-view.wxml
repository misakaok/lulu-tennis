<view class="page">
  <view wx:if="{{error}}" class="empty">
    <view class="empty-ball"></view>
    <view>{{error}}</view>
    <view class="btn-primary small" hover-class="tap-on" bindtap="goHome">返回活动列表</view>
  </view>

  <block wx:if="{{draw}}">
    <view class="head card">
      <view class="h-title">{{draw.title}}</view>
      <view class="h-meta">{{meta}} · {{draw.date}}</view>
      <view class="h-rules">
        <view class="hr-title">规则 · {{formatText}}</view>
        <view wx:for="{{rulesSum}}" wx:key="stage" class="hr-row {{item.hl ? 'hl' : ''}}"><text class="hr-k">{{item.stage}}</text><text class="hr-v">{{item.text}}</text></view>
      </view>
      <view wx:if="{{seedsText}}" class="h-seeds"><text class="h-lbl">分开排位</text>{{seedsText}}</view>
      <view wx:if="{{!signing && progress}}" class="h-prog">{{progress}}</view>
      <view wx:if="{{signing}}" class="h-prog">已报名 {{signCount}}</view>
    </view>

    <!-- 时间地点 -->
    <view class="card info">
      <view class="card-title row">
        <text>时间地点</text>
        <text wx:if="{{canEdit}}" class="link" bindtap="goEdit">编辑</text>
      </view>
      <view class="in-row"><text class="in-k">时间</text><text class="in-v">{{info.when || '暂无'}}</text></view>
      <block wx:if="{{!info.empty}}">
        <view class="in-row"><text class="in-k">场地</text><text class="in-v">{{info.venue || '暂无'}}</text></view>
        <view wx:if="{{info.canNav}}" class="nav-btn" hover-class="tap-on" bindtap="openMap">📍 打开地图导航</view>
      </block>
      <view wx:else class="muted">{{canEdit ? '还没有填写场地，点右上角「编辑」补充' : '发起人还没有填写场地'}}</view>
    </view>

    <!-- 报名中 -->
    <block wx:if="{{signing}}">
      <view class="card">
        <view class="card-title row">
          <text>报名名单</text>
          <text class="count">{{signCount}}</text>
        </view>
        <view wx:if="{{!signups.length}}" class="muted">还没有人报名，把它分享到群里吧</view>

        <view wx:for="{{signups}}" wx:key="_id" class="su-team">
          <view wx:for="{{item.members}}" wx:key="name" wx:for-item="p" class="su-row" hover-class="tap-row-on" data-uid="{{p.uid}}" bindtap="openPlayer">
            <text class="su-no">{{index === 0 ? item.no : ''}}</text>
            <pl-av class="su-av2 init" uid="{{p.uid}}" name="{{p.name}}" />
            <view class="su-main">
              <view class="su-top"><text class="su-nm">{{p.name}}</text><text class="su-g {{p.gender === '暂无' ? 'none' : ''}}">{{p.gender}}</text></view>
              <view class="su-stats">
                <text>排名 <text class="v {{p.rank === '暂无' ? 'none' : ''}}">{{p.rank}}</text></text>
                <text>场数 <text class="v {{p.played === '暂无' ? 'none' : ''}}">{{p.played}}</text></text>
                <text>胜率 <text class="v {{p.rate === '暂无' ? 'none' : ''}}">{{p.rate}}</text></text>
              </view>
            </view>
            <view class="su-lv2 {{p.level === '暂无' ? 'none' : ''}}">{{p.level}}</view>
            <text class="su-go">›</text>
          </view>
          <view wx:if="{{item.waiting}}" class="su-solo su-wait">候补中：前面有人取消就自动递补</view>
          <view wx:elif="{{isDouble && item.solo}}" class="su-solo">找搭档中，由发起人配对</view>
        </view>
      </view>

      <view wx:if="{{joined}}" class="joined">
        <view class="joined-ic">✓</view>
        <view class="joined-main">
          <view class="joined-t">{{myWaiting ? '你在候补名单里' : '你已报名'}}</view>
          <view class="joined-s">{{isDouble ? '截止报名前可以取消，会连同搭档一起取消' : '截止报名前可以随时取消'}}</view>
        </view>
        <view class="quit" hover-class="quit-hover" bindtap="quit">取消报名</view>
      </view>
      <picker wx:elif="{{isDouble && myName}}" range="{{partnerOpts}}" bindchange="joinDouble">
        <view class="btn-primary {{busy ? 'disabled' : ''}}">{{full ? '名额已满，排队候补（选择搭档）' : '我要报名（选择搭档）'}}</view>
      </picker>
      <view wx:else class="btn-primary {{busy ? 'disabled' : ''}}" hover-class="tap-on" bindtap="join">{{full ? '名额已满，排队候补' : '我要报名'}}</view>
      <view wx:if="{{canPublish}}" class="btn-owner" hover-class="tap-on" bindtap="startDraw">截止报名，生成{{draw.mode === 'bracket' ? '对阵' : '分组'}}</view>
    </block>

    <!-- 已抽签：签表 / 积分榜 + 赛程 -->
    <block wx:else>
      <view class="tabs">
        <view class="tab {{tab === 'board' ? 'on' : ''}}" data-v="board" bindtap="setTab">{{draw.mode === 'groups' ? '积分榜' : draw.mode === 'groups_ko' ? '积分榜 · 对阵表' : '对阵表'}}</view>
        <view class="tab {{tab === 'schedule' ? 'on' : ''}}" data-v="schedule" bindtap="setTab">场次<text wx:if="{{todo}}" class="dot">{{todo}}</text></view>
      </view>

      <draw-board wx:if="{{tab === 'board'}}" draw="{{draw}}" matches="{{matches}}" me="{{myName}}" editable="{{true}}" bind:open="onOpen" />

      <view wx:else>
        <view class="sch-bar">
          <text class="muted">{{isOwner ? '点击场次录分；可以给每一场安排时间和场地' : '点击场次录入或查看比分'}}</text>
          <text class="mine-tg {{onlyMine ? 'on' : ''}}" bindtap="toggleMine">{{onlyMine ? '✓ ' : ''}}只看我的</text>
        </view>
        <view wx:if="{{!schedule.length}}" class="muted center">{{onlyMine ? '你在这个活动里没有比赛' : '还没有比赛'}}</view>
        <view wx:for="{{schedule}}" wx:key="key" class="sch {{item.status}} {{item.mine ? 'mine' : ''}}" hover-class="tap-on" data-key="{{item.key}}" bindtap="tapItem">
          <view class="sch-top">
            <text class="sch-stage">{{item.stage}}</text>
            <text class="sch-st">{{item.status === 'done' ? '已完赛' : item.status === 'ready' ? (item.mine ? '待录分 ›' : '待赛') : '待定'}}</text>
          </view>
          <view class="sch-row {{item.winner === 'a' ? 'w' : ''}}">
            <view class="sch-avs">
              <block wx:for="{{item.aP}}" wx:key="name" wx:for-item="p">
                <pl-av class="sch-av init" uid="{{p.uid}}" name="{{p.name}}" />
              </block>
            </view>
            <text wx:if="{{item.aG}}" class="sch-name"><block wx:for="{{item.aP}}" wx:key="name" wx:for-item="p" wx:for-index="pi">{{pi ? ' / ' : ''}}{{p.name}}<text wx:if="{{p.gender}}" class="gd"> {{p.gender}}</text></block></text>
            <text wx:else class="sch-name">{{item.aText}}</text>
            <text wx:if="{{item.winner === 'a'}}" class="sch-win">胜</text>
          </view>
          <view class="sch-row {{item.winner === 'b' ? 'w' : ''}}">
            <view class="sch-avs">
              <block wx:for="{{item.bP}}" wx:key="name" wx:for-item="p">
                <pl-av class="sch-av init" uid="{{p.uid}}" name="{{p.name}}" />
              </block>
            </view>
            <text wx:if="{{item.bG}}" class="sch-name"><block wx:for="{{item.bP}}" wx:key="name" wx:for-item="p" wx:for-index="pi">{{pi ? ' / ' : ''}}{{p.name}}<text wx:if="{{p.gender}}" class="gd"> {{p.gender}}</text></block></text>
            <text wx:else class="sch-name">{{item.bText}}</text>
            <text wx:if="{{item.winner === 'b'}}" class="sch-win">胜</text>
          </view>
          <view wx:if="{{item.score}}" class="sch-score">{{item.score}}</view>
          <view wx:if="{{item.slotText && !item.done}}" class="sch-slot">🕒 {{item.slotText}}</view>
          <view class="sch-foot">
            <text class="sch-rule {{item.ruleCustom ? 'hl' : ''}}">{{item.ruleCustom ? '★ ' : ''}}{{item.ruleText}}</text>
            <text wx:if="{{isOwner && !item.done}}" class="sch-plan" data-key="{{item.key}}" catchtap="planSlot">{{item.slotText ? '修改安排' : '安排时间场地'}}</text>
          </view>
        </view>
      </view>
    </block>

    <!-- 退赛 -->
    <view wx:if="{{!signing && (withdrawn.length || wdOwner || canWithdraw || myWd)}}" class="card wd">
      <view class="card-title">退赛<text class="sub">对阵生成后由发起人处理，不直接删除参加者</text></view>
      <view wx:for="{{withdrawn}}" wx:key="entrant" class="wd-row"><text class="wd-n">{{item.entrant}}</text><text class="wd-t">已退赛 · {{item.text}}</text></view>
      <block wx:if="{{wdOwner}}">
        <view wx:for="{{wdPending}}" wx:key="id" class="wd-row">
          <text class="wd-n">{{item.entrant}}</text><text class="wd-t">申请退赛{{item.reason ? '：' + item.reason : ''}}</text>
          <text class="wd-a" data-i="{{index}}" bindtap="rejectWithdraw">拒绝</text><text class="wd-a main" data-i="{{index}}" bindtap="approveWithdraw">同意</text>
        </view>
        <picker wx:if="{{wdCandidates.length}}" range="{{wdCandidates}}" bindchange="ownerWithdraw"><view class="wd-link">登记球员退赛 / 缺席</view></picker>
      </block>
      <block wx:else>
        <view wx:if="{{myWd && myWd.status === 'pending'}}" class="wd-t">你的退赛申请等待发起人处理</view>
        <view wx:elif="{{myWd && myWd.status === 'rejected'}}" class="wd-t">发起人拒绝了你的退赛申请{{myWd.note ? '：' + myWd.note : ''}}</view>
        <view wx:elif="{{canWithdraw}}" class="wd-link" bindtap="requestWithdraw">申请退赛</view>
      </block>
    </view>

    <!-- 单场安排（发起人） -->
    <view wx:if="{{slotEdit}}" class="sheet-mask" bindtap="slotCancel"></view>
    <view wx:if="{{slotEdit}}" class="sheet">
      <view class="sheet-t">安排这场比赛</view>
      <view class="sheet-s">{{slotEdit.title}}</view>
      <view class="sheet-row">
        <text class="label">日期</text>
        <picker mode="date" value="{{slotEdit.date || slotEdit.defDate}}" bindchange="slotDate"><view class="sheet-pick {{slotEdit.date ? '' : 'ph'}}">{{slotEdit.date || '选择日期'}} ›</view></picker>
      </view>
      <view class="sheet-row">
        <text class="label">时间</text>
        <picker mode="time" value="{{slotEdit.time || '09:00'}}" bindchange="slotTime"><view class="sheet-pick {{slotEdit.time ? '' : 'ph'}}">{{slotEdit.time || '选择时间'}} ›</view></picker>
      </view>
      <view class="sheet-row">
        <text class="label">场地编号</text>
        <picker range="{{courts}}" value="{{slotEdit.courtIndex}}" bindchange="slotCourt"><view class="sheet-pick {{slotEdit.court ? '' : 'ph'}}">{{courts[slotEdit.courtIndex]}} ›</view></picker>
      </view>
      <view class="sheet-note">没有安排的场次，沿用活动的日期、时间和场地。</view>
      <view class="sheet-acts">
        <view wx:if="{{slotEdit.had}}" class="sheet-a" bindtap="slotClear">清除安排</view>
        <view class="sheet-a" bindtap="slotCancel">取消</view>
        <view class="sheet-a main {{busy ? 'dis' : ''}}" bindtap="slotSave">保存</view>
      </view>
    </view>

    <view class="actions">
      <button class="share" open-type="share">{{signing ? '发给球友报名' : '发给球友'}}</button>
      <view wx:if="{{canManage}}" class="del" hover-class="del-hover" bindtap="remove">{{isOwner ? '删除活动' : '管理员删除'}}</view>
    </view>
  </block>
  <!-- 分享封面用的画布（不显示） -->
  <canvas type="2d" id="share-cv" class="share-cv"></canvas>
</view>
