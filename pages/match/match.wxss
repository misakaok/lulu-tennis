.muted { color: #84849E; font-size: 26rpx; text-align: center; padding: 40rpx 0; }
.st-tip { margin-bottom: 18rpx; padding: 16rpx 22rpx; border-radius: 16rpx; background: #fff8e6; color: #9a6a00; font-size: 24rpx; line-height: 1.6; }
.st-tip.bad { background: #f6eeee; color: #b34d4d; }

/* 记分牌 */
.hero { margin-bottom: 24rpx; padding: 30rpx 28rpx 32rpx; border-radius: 32rpx; color: #fff; background: #9594C1; box-shadow: 0 16rpx 36rpx rgba(110, 110, 163, 0.3); }
/* iPhone 推入页有约 300ms 滑入动画：高光、比分等页面滑稳后再出来 */
.hero.ani-sheen::after { animation-delay: 0.38s; }
/* 云端读完才出来的比分状态、修改记录：淡入，不是一下子冒出来（只动 opacity） */
@keyframes late-in { from { opacity: 0; } to { opacity: 1; } }
.late { animation: late-in 0.28s cubic-bezier(0.22, 1, 0.36, 1) both; }
/* 顶部 1rpx 内高光（背景图盖住了卡片自己的 inset 阴影，所以用 ::before 画；::after 留给 .ani-sheen） */
.hero::before { content: ''; position: absolute; left: 0; right: 0; top: 0; height: 1rpx; background: rgba(255, 255, 255, 0.35); pointer-events: none; z-index: 1; }

.hero-top { text-align: center; }
.hero-tag { display: inline-block; max-width: 100%; padding: 8rpx 24rpx; border-radius: 28rpx; background: rgba(255, 255, 255, 0.18); background-image: linear-gradient(180deg, rgba(255, 255, 255, 0.16), rgba(255, 255, 255, 0)); font-size: 24rpx; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; box-sizing: border-box; backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); border: 1rpx solid rgba(255, 255, 255, 0.36); box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.45), 0 6rpx 16rpx rgba(68, 68, 120, 0.12); }
.hero-meta { margin-top: 12rpx; font-size: 22rpx; color: rgba(255, 255, 255, 0.82); }
.hero-tags { display: flex; flex-wrap: wrap; justify-content: center; margin-top: 14rpx; }
.hero-hl { margin: 0 6rpx 6rpx; padding: 2rpx 18rpx; border-radius: 20rpx; font-size: 21rpx; font-weight: 600; background: rgba(255, 255, 255, 0.2); }
.hero-hl.upset { color: #6E6EA3; background: #fff; font-weight: 700; }
.hero-main { display: flex; align-items: flex-start; margin-top: 36rpx; }
.hs { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: center; }
.hs.l { opacity: 0.78; }
.hs-avs { display: flex; justify-content: center; margin-bottom: 14rpx; }
.hs-av-w { flex: none; }
.hs-av-w + .hs-av-w { margin-left: -28rpx; }
.hs-av { width: 96rpx; height: 96rpx; border-radius: 50%; border: 4rpx solid rgba(255, 255, 255, 0.9); display: flex; align-items: center; justify-content: center; font-size: 38rpx; font-weight: 800; color: #2E2E4A; flex: none; box-sizing: border-box; }
.hs-n { max-width: 100%; font-size: 28rpx; font-weight: 700; line-height: 1.45; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.hero .gd { color: rgba(255, 255, 255, 0.78); }
.hs-badge { margin-top: 12rpx; padding: 2rpx 20rpx; border-radius: 20rpx; font-size: 21rpx; font-weight: 700; color: rgba(255, 255, 255, 0.85); background: rgba(255, 255, 255, 0.16); }
.hs-badge.win { color: #2E3600; background: #C9E33A; }
.hero-mid { flex: none; width: 220rpx; padding-top: 14rpx; text-align: center; }
.hero-big { font-size: 84rpx; font-weight: 800; line-height: 1; letter-spacing: -0.03em; text-shadow: 0 2rpx 12rpx rgba(50, 50, 90, 0.35); } /* 比分压在白色网带上，加一点阴影 */
.hero-big .dim { opacity: 0.6; }
.hero-big .colon { margin: 0 10rpx; font-size: 60rpx; opacity: 0.6; position: relative; top: -8rpx; }
.hero-sub { margin-top: 14rpx; font-size: 21rpx; color: rgba(255, 255, 255, 0.78); }
.hero-sets { display: flex; justify-content: center; margin-top: 32rpx; padding-top: 24rpx; border-top: 1rpx solid rgba(255, 255, 255, 0.22); }
.hset { flex: 1; max-width: 200rpx; margin: 0 8rpx; padding: 14rpx 0; border-radius: 18rpx; background: rgba(56, 54, 108, 0.16); background-image: linear-gradient(180deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0)); text-align: center; backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); border: 1rpx solid rgba(255, 255, 255, 0.24); box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.28), 0 8rpx 20rpx rgba(48, 46, 96, 0.16); } /* 烟熏冷紫毛玻璃，和球员卡数据条同款 */
/* 每盘依次出现：毛玻璃块只平移、不缩放（安卓 XWeb 缩放带模糊的圆角块会闪） */
@keyframes hset-in { from { opacity: 0; transform: translateY(20rpx); } to { opacity: 1; transform: translateY(0); } }
.hset.ani-in { animation-name: hset-in; }
.hset-l { font-size: 20rpx; color: rgba(255, 255, 255, 0.75); }
.hset-v { margin-top: 4rpx; font-size: 34rpx; font-weight: 600; color: rgba(255, 255, 255, 0.7); }
.hset-v .on { font-weight: 800; color: #fff; }
.hset-c { margin: 0 8rpx; opacity: 0.6; }
.tb { font-size: 20rpx; vertical-align: super; }

/* 比分修改记录（时间线） */
.chg { position: relative; display: flex; padding-bottom: 26rpx; }
.chg:last-child { padding-bottom: 0; }
.chg::before { content: ''; position: absolute; left: 9rpx; top: 26rpx; bottom: -6rpx; width: 2rpx; background: #E6E6F2; }
.chg:last-child::before { display: none; }
.chg-dot { flex: none; width: 20rpx; height: 20rpx; margin: 8rpx 20rpx 0 0; border-radius: 50%; background: #fff; border: 5rpx solid #A3A3CB; box-sizing: border-box; }
.chg-b { flex: 1; min-width: 0; }
.chg-t { display: flex; justify-content: space-between; align-items: center; font-size: 25rpx; color: #4F4F7D; font-weight: 600; }
.chg-w { flex: 1; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.chg-d { flex: none; margin-left: 12rpx; font-size: 21rpx; color: #84849E; font-weight: 400; }
.chg-s { display: inline-block; margin-top: 10rpx; padding: 8rpx 18rpx; border-radius: 12rpx; background: #F7F7FB; font-size: 24rpx; color: #70708C; }
.chg-from { text-decoration: line-through; }
.chg-ar { margin: 0 12rpx; color: #BDBDCE; }
.chg-s .b { color: #2E2E4A; font-weight: 700; }

/* 这场的水平分（只给本人看） */
.why-none { font-size: 25rpx; color: #5C5C76; line-height: 1.6; margin-top: 10rpx; }
.why-head { display: flex; align-items: center; }
.why-ar { font-size: 40rpx; font-weight: 800; color: #84849E; margin-right: 12rpx; }
.why-ar.up { color: #6E6EA3; }
.why-ar.down { color: #b34d4d; }
.why-t { font-size: 30rpx; font-weight: 800; color: #2E2E4A; }
.why-prov { margin-left: 14rpx; }
.why-r { font-size: 26rpx; color: #33334D; line-height: 1.6; margin-top: 12rpx; }
.why-tier { font-size: 24rpx; color: #6E6EA3; margin-top: 8rpx; }
.why-note { font-size: 22rpx; color: #70708C; line-height: 1.6; margin-top: 6rpx; }
.why-more { display: flex; justify-content: flex-end; margin-top: 16rpx; }
.why-d { margin-top: 16rpx; padding: 18rpx 20rpx; background: #F4F4F9; border-radius: 20rpx; }
.why-row { display: flex; justify-content: space-between; align-items: center; font-size: 24rpx; padding: 8rpx 0; }
.why-row + .why-row { border-top: 1rpx solid #EBEBF3; } /* 分隔线只画在两行之间（见 tests/review-surface.test.js） */
.why-row:last-child { padding-bottom: 0; } /* 最后一行不再多出下边距 */
.why-k { color: #5C5C76; }
.why-v { color: #2E2E4A; font-weight: 700; }
.why-foot { font-size: 21rpx; color: #70708C; line-height: 1.6; margin-top: 10rpx; }
