.ce-row { display: flex; align-items: center; justify-content: space-between; padding: 8rpx 0 16rpx; }
.ce-lbl { margin: 14rpx 0 10rpx; font-size: 24rpx; color: #5C5C76; }
.ce-pick { min-width: 160rpx; text-align: center; padding: 14rpx 20rpx; border-radius: 16rpx; background: #F6F6FB; font-size: 26rpx; color: #1E1E32; }
.ce-pick.ph { color: #A5A5BA; }
.ce-note { margin-top: 14rpx; font-size: 22rpx; color: #8686A0; line-height: 1.6; }
.ce-slot { display: flex; align-items: center; padding: 16rpx 0; }
.ce-slot + .ce-slot { border-top: 1rpx solid #F2F2F8; } /* 分隔线只画在两行之间（见 tests/review-surface.test.js） */
.ce-slot:last-child { padding-bottom: 0; } /* 最后一行不再多出下边距 */
.ce-col { display: flex; flex-direction: column; align-items: center; }
.ce-slot-h { display: flex; align-items: baseline; justify-content: center; margin-bottom: 10rpx; }
.ce-tier { font-size: 26rpx; font-weight: 700; color: #6E6EA3; }
.ce-pts { margin-left: 12rpx; font-size: 22rpx; color: #8686A0; }
.ce-rm { margin-left: auto; }
.ce-cells { display: flex; }
.ce-cell { position: relative; }
.ce-cell + .ce-cell { margin-left: 60rpx; } /* 双打两格之间留出第一格的 ✕ */
.ce-x { position: absolute; left: 100%; top: 50%; transform: translateY(-50%); margin-left: 4rpx; padding: 8rpx; font-size: 22rpx; color: #A5A5BA; }
.ce-add { margin-top: 14rpx; }
.ce-err { font-size: 25rpx; color: #b7791f; line-height: 1.6; }
.ce-pv { display: flex; align-items: center; padding: 12rpx 0; font-size: 24rpx; color: #1E1E32; }
.ce-pv + .ce-pv { border-top: 1rpx solid #F2F2F8; } /* 分隔线只画在两行之间 */
.ce-pv:last-child { padding-bottom: 0; }
.ce-pv-h { color: #8686A0; font-size: 22rpx; }
.ce-pv-t { width: 120rpx; flex: none; color: #6E6EA3; font-weight: 700; }
.ce-pv-h .ce-pv-t { color: #8686A0; font-weight: 400; }
.ce-pv-n { flex: 1; min-width: 0; }
.ce-bn { font-size: 21rpx; color: #6E6EA3; }
.ce-pv-v { min-width: 80rpx; padding-left: 8rpx; flex: none; text-align: right; white-space: nowrap; }
.ce-pv-v.b { font-weight: 800; }
.ce-acts { display: flex; margin: 24rpx 0 40rpx; }
.ce-a { flex: 1; }
.ce-a + .ce-a { margin-left: 20rpx; }
.ce-del { margin: 0 0 48rpx; }
.seg.locked { opacity: 0.6; } /* 从活动结算：类别、单打 / 双打跟活动走 */
.cup-kinds { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); }
/* 选球员弹层 */
.sheet-mask { position: fixed; left: 0; right: 0; top: 0; bottom: 0; background: rgba(30, 30, 50, 0.45); z-index: 20; }
.sheet { position: fixed; left: 0; right: 0; bottom: 0; z-index: 21; background: #fff; border-radius: 32rpx 32rpx 0 0; padding: 32rpx 32rpx calc(24rpx + env(safe-area-inset-bottom)); }
.sh-h { display: flex; align-items: baseline; justify-content: space-between; }
.sh-t { font-size: 32rpx; font-weight: 800; color: #1E1E32; }
.sh-s { font-size: 24rpx; color: #8686A0; }
.sh-q { height: 72rpx; margin: 20rpx 0 12rpx; padding: 0 28rpx; border-radius: 36rpx; background: #F2F2F8; font-size: 27rpx; color: #1E1E32; }
.sh-ph { color: #A5A5BA; }
.sh-list { height: 50vh; }
.sh-chips { display: flex; flex-wrap: wrap; margin: 0 -8rpx; }
.sh-chip { display: flex; align-items: center; margin: 8rpx; padding: 8rpx 22rpx 8rpx 8rpx; border-radius: 34rpx; background: #F2F2F8; font-size: 26rpx; color: #3A3A52; }
.sh-chip.on { background: #6E6EA3; color: #fff; }
.sh-chip.on .gd, .sh-chip.on .sh-tag { color: #E6E6F5; }
.sh-g { margin-left: 12rpx; } /* 名字和性别分开一点（开头的空格在小程序里会被吞掉） */
.sh-chip.off { opacity: 0.45; }
.sh-av { margin-right: 10rpx; }
.sh-n { max-width: 260rpx; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.sh-tag { margin-left: 10rpx; font-size: 20rpx; color: #6E6EA3; }
.sh-none { text-align: center; padding: 40rpx 0; }
.sh-acts { display: flex; margin-top: 20rpx; }
.sh-a { flex: 1; }
.sh-a + .sh-a { margin-left: 20rpx; }
