.vs-card { background: linear-gradient(155deg, #a3a3cb, #8484b6); border-radius: 32rpx; padding: 32rpx 28rpx; color: #fff; margin-bottom: 24rpx; box-shadow: 0 14rpx 30rpx rgba(133, 133, 184, 0.35); }
.title { text-align: center; font-size: 32rpx; font-weight: 800; letter-spacing: 4rpx; }
.vs-row { display: flex; align-items: center; margin-top: 28rpx; }
.pl { flex: 1; display: flex; flex-direction: column; align-items: center; overflow: hidden; }
.av { width: 128rpx; height: 128rpx; border-radius: 50%; border: 5rpx solid rgba(255, 255, 255, 0.85); background: #fff; }
.av.init { display: flex; align-items: center; justify-content: center; font-size: 52rpx; font-weight: 800; color: #22223a; }
.nm { margin-top: 14rpx; font-size: 30rpx; font-weight: 700; max-width: 240rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.lv { font-size: 56rpx; font-weight: 900; line-height: 1.2; }
.tier { font-size: 22rpx; opacity: 0.9; }
.vs { font-size: 44rpx; font-weight: 900; font-style: italic; opacity: 0.9; }
.chance { margin-top: 28rpx; }
.bar { height: 14rpx; border-radius: 7rpx; background: rgba(255, 255, 255, 0.3); overflow: hidden; }
.fill { height: 100%; background: #fff; border-radius: 7rpx; }
.chance-t { display: flex; justify-content: space-between; font-size: 22rpx; margin-top: 10rpx; opacity: 0.95; }
.h2h { text-align: center; font-size: 22rpx; margin-top: 18rpx; opacity: 0.9; }

.warn { background: #fdf1f0; color: #a3423d; font-size: 26rpx; line-height: 1.6; }
.info { background: #f1f1f8; color: #4f4f7d; font-size: 26rpx; line-height: 1.6; }
.gain { margin-top: 8rpx; font-size: 24rpx; color: #6e6ea3; }

.btn-share { height: 96rpx; line-height: 96rpx; border-radius: 48rpx; color: #fff; font-size: 32rpx; font-weight: 600; background: linear-gradient(90deg, #8585b8, #a3a3cb); box-shadow: 0 12rpx 28rpx rgba(133, 133, 184, 0.3); margin-bottom: 20rpx; }
.btn-share::after { border: none; }
button.btn-share { display: flex !important; align-items: center; justify-content: center; padding: 0 !important; width: auto !important; line-height: normal !important; box-sizing: border-box; }
.ghost-btn { background: #fff; color: #6e6ea3; border: 2rpx solid #cfcfe6; box-shadow: none; }
.back { text-align: center; color: #8686a0; font-size: 26rpx; margin-top: 30rpx; }
.rep { margin-top: 6rpx; font-size: 22rpx; opacity: 0.9; }
