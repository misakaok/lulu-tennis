.rv-head { display: flex; flex-direction: column; align-items: center; }
.rv-av { width: 120rpx; height: 120rpx; border-radius: 50%; background: #f2f2f8; }
.rv-av.init { display: flex; align-items: center; justify-content: center; font-size: 48rpx; font-weight: 800; color: #22223a; }
.rv-name { margin-top: 14rpx; font-size: 34rpx; font-weight: 800; }
.rv-sub { margin-top: 8rpx; font-size: 22rpx; color: #8686A0; }
.rv-dim { padding: 16rpx 0; border-bottom: 1rpx solid #F2F2F8; }
.rv-t { font-size: 28rpx; font-weight: 700; }
.rv-d { font-size: 22rpx; color: #A5A5BA; font-weight: 400; margin-left: 12rpx; }
.rv-stars { display: flex; align-items: center; margin-top: 8rpx; }
.rv-star { font-size: 52rpx; color: #E3E3EF; margin-right: 14rpx; }
.rv-star.on { color: #f5b942; }
.rv-hint { font-size: 24rpx; color: #6E6EA3; }
.rv-text { margin-top: 20rpx; width: 100%; height: 180rpx; box-sizing: border-box; background: #F7F7FB; border-radius: 16rpx; padding: 18rpx; font-size: 26rpx; }
.rv-count { text-align: right; font-size: 20rpx; color: #B7B7CC; margin-top: 6rpx; }
.rv-foot { text-align: center; font-size: 22rpx; color: #A5A5BA; margin-top: 20rpx; }
