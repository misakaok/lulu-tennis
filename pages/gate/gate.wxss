.g-hero { margin: 20rpx 0 28rpx; padding: 50rpx 36rpx 40rpx; border-radius: 32rpx; color: #fff; text-align: center; background: linear-gradient(155deg, #A3A3CB 0%, #8484B6 100%); box-shadow: 0 12rpx 28rpx rgba(133, 133, 184, 0.3); }
.g-logo { font-size: 84rpx; }
.g-title { margin-top: 16rpx; font-size: 38rpx; font-weight: 900; }
.g-desc { margin-top: 12rpx; font-size: 25rpx; opacity: 0.95; line-height: 1.6; }
.g-reason { margin-top: 14rpx; font-size: 24rpx; background: rgba(255,255,255,0.2); border-radius: 14rpx; padding: 10rpx 16rpx; }
.g-in { height: 84rpx; background: #F7F7FB; border-radius: 16rpx; padding: 0 22rpx; font-size: 28rpx; }
.g-ta { margin-top: 16rpx; width: 100%; height: 150rpx; box-sizing: border-box; background: #F7F7FB; border-radius: 16rpx; padding: 16rpx 22rpx; font-size: 26rpx; }
.g-wait { text-align: center; font-size: 26rpx; color: #6E6EA3; padding: 30rpx 0; }
.g-foot { text-align: center; font-size: 21rpx; color: #A5A5BA; margin-top: 30rpx; }
.g-id { text-align: center; font-size: 21rpx; color: #6E6EA3; margin-top: 16rpx; }
