<view class="page">
  <view class="g-hero">
    <view class="g-logo">🎾</view>
    <view class="g-title">{{loading ? '正在确认身份…' : title}}</view>
    <view class="g-desc">{{desc}}</view>
    <view wx:if="{{reason}}" class="g-reason">原因：{{reason}}</view>
  </view>

  <block wx:if="{{!loading}}">
    <view wx:if="{{status === 'active'}}" class="btn-primary" hover-class="tap-on" bindtap="enter">进入小程序</view>

    <block wx:elif="{{status !== 'pending' || invite || codeMode}}">
      <view class="card">
        <view class="card-title">{{invite || codeMode ? '接受邀请' : (status === 'none' ? '申请加入' : '重新申请')}}</view>
        <input wx:if="{{codeMode && !invite}}" class="g-in g-code" value="{{code}}" maxlength="32" placeholder="邀请码（管理员给的 12 位字母数字）" bindinput="onCode" />
        <input class="g-in" value="{{name}}" maxlength="20" placeholder="你的称呼（球友认识你的名字）" bindinput="onName" />
      </view>
      <view wx:if="{{invite || codeMode}}" class="btn-primary {{busy ? 'disabled' : ''}}" hover-class="tap-on" bindtap="accept">{{busy ? '加入中…' : '接受邀请，加入球友圈'}}</view>
      <view wx:else class="btn-primary {{busy ? 'disabled' : ''}}" hover-class="tap-on" bindtap="apply">{{busy ? '提交中…' : '提交申请'}}</view>
      <view wx:if="{{!invite}}" class="g-switch" bindtap="toggleCode">{{codeMode ? (status === 'pending' ? '没有邀请码，继续等待审核' : '没有邀请码，改为提交申请') : '我有邀请码'}}</view>
    </block>

    <!-- 已提交申请、还在等审核：有邀请码也可以直接加入，不用等管理员 -->
    <block wx:else>
      <view class="g-wait">⏳ 已提交，管理员审核后下拉刷新即可</view>
      <view class="g-switch" bindtap="toggleCode">我有邀请码，直接加入</view>
    </block>
  </block>
  <view class="g-foot">活动、报名、战绩和排名只对正式成员开放</view>
  <view wx:if="{{myId}}" class="g-id" bindtap="copyMyId">我的用户 ID：尾号 {{myIdTail}} · 点击复制</view>
</view>
