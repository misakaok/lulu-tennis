<!-- 记分牌：已完成的各盘 + 本盘局分 + 本局小分（抢七用数字） -->
<template name="board">
  <view class="bd">
    <view class="bd-row bd-head">
      <text class="bd-side"></text>
      <text wx:for="{{v.cols}}" wx:key="k" class="bd-g">{{item.cur ? '本盘' : '第' + (index + 1) + '盘'}}</text>
      <text wx:if="{{!v.done}}" class="bd-p">{{v.tb ? '抢七' : '本局'}}</text>
    </view>
    <view class="bd-row">
      <text class="bd-side">{{names.a}}</text>
      <view wx:for="{{v.cols}}" wx:key="k" class="bd-g {{item.cur ? 'cur' : ''}} {{item.aw ? 'w' : ''}}">{{item.a}}<text wx:if="{{item.tbLo !== '' && item.aw === false}}" class="bd-tb">{{item.tbLo}}</text></view>
      <view wx:if="{{!v.done}}" class="bd-p num">{{v.callA}}</view>
    </view>
    <view class="bd-row">
      <text class="bd-side">{{names.b}}</text>
      <view wx:for="{{v.cols}}" wx:key="k" class="bd-g {{item.cur ? 'cur' : ''}} {{item.bw ? 'w' : ''}}">{{item.b}}<text wx:if="{{item.tbLo !== '' && item.bw === false}}" class="bd-tb">{{item.tbLo}}</text></view>
      <view wx:if="{{!v.done}}" class="bd-p num">{{v.callB}}</view>
    </view>
  </view>
</template>

<view wx:if="{{authError}}" class="page muted">{{authError}}</view>
<view wx:else class="page">

  <!-- 选规则 -->
  <block wx:if="{{mode === 'setup'}}">
    <view class="hero">
      <view class="hero-main">
        <view class="hero-k">场边记分</view>
        <view class="hero-t">A 方 <text class="hero-x">vs</text> B 方</view>
        <view class="hero-s">逐分记分，只保存在这台手机上</view>
      </view>
      <image class="hero-art" src="/images/art-ball.png" mode="aspectFit" />
    </view>
    <view wx:if="{{hasDraft}}" class="card draft">
      <text class="draft-t">本机还有一场记分</text>
      <view class="btn-line mini" hover-class="tap-on" bindtap="backToDraft">回到上一场</view>
    </view>
    <view class="card">
      <view class="card-title">规则</view>
      <view class="field">
        <text class="label">每盘局数</text>
        <view class="seg">
          <view class="seg-item {{cfg.setGames === 4 ? 'on' : ''}}" data-k="setGames" data-v="4" bindtap="setOpt">4 局制（3:3 抢七）</view>
          <view class="seg-item {{cfg.setGames === 6 ? 'on' : ''}}" data-k="setGames" data-v="6" bindtap="setOpt">6 局制（6:6 抢七）</view>
        </view>
      </view>
      <view class="field">
        <text class="label">金球 / 占先</text>
        <view class="seg">
          <view class="seg-item {{cfg.noAd ? 'on' : ''}}" data-k="noAd" data-v="1" bindtap="setOpt">金球</view>
          <view class="seg-item {{cfg.noAd ? '' : 'on'}}" data-k="noAd" data-v="0" bindtap="setOpt">占先</view>
        </view>
      </view>
      <view class="field">
        <text class="label">盘数</text>
        <view class="seg">
          <view class="seg-item {{cfg.bestOf === 1 ? 'on' : ''}}" data-k="bestOf" data-v="1" bindtap="setOpt">一盘</view>
          <view class="seg-item {{cfg.bestOf === 3 ? 'on' : ''}}" data-k="bestOf" data-v="3" bindtap="setOpt">三盘两胜</view>
        </view>
      </view>
      <view class="rules-tip">{{cfg.noAd ? '金球：40:40 时下一分定局；抢七先到 7 分即赢（7:6 结束）' : '占先：40:40 后要连赢 2 分；抢七先到 7 分且净胜 2 分'}}{{cfg.setGames === 6 ? '；6 局制可以 7:5' : ''}}</view>
    </view>
    <view class="btn-primary" hover-class="tap-on" bindtap="startNew">开始记分</view>
    <view class="note">球员在带入日常录分时再选，这里只记 A、B 双方</view>
  </block>

  <!-- 有草稿：继续还是新一场 -->
  <block wx:elif="{{mode === 'resume'}}">
    <view class="sb">
      <view class="sb-k">{{v.done ? '上一场已完赛' : '上一场还没打完'}}{{ev ? ' · ' + evTitle : ''}} · {{v.rulesText}}</view>
      <template is="board" data="{{v, names}}" />
      <view wx:if="{{v.done}}" class="sb-res">{{v.resultText}}</view>
    </view>
    <view class="btn-primary" hover-class="tap-on" bindtap="resume">继续记分</view>
    <view class="btn-line gap" hover-class="tap-on" bindtap="goSetup">开始新一场</view>
  </block>

  <!-- 记分中 -->
  <block wx:else>
    <view class="sb">
      <view class="sb-k">{{ev ? evTitle + ' · ' : ''}}{{v.rulesText}}{{v.done ? '' : ' · 第 ' + v.setNo + ' 盘'}}</view>
      <template is="board" data="{{v, names}}" />
      <view wx:if="{{v.done}}" class="sb-res"><text class="ui-tag lime">完赛</text> {{v.resultText}}</view>
      <view wx:elif="{{v.callText || v.pointA || v.pointB}}" class="sb-call">
        <text wx:if="{{v.callText}}">{{v.callText}}</text>
        <text wx:if="{{v.pointA}}" class="sb-pt">{{names.a}} {{v.pointA}}</text>
        <text wx:if="{{v.pointB}}" class="sb-pt">{{names.b}} {{v.pointB}}</text>
      </view>
      <view wx:if="{{v.tb && !v.done}}" class="sb-tip">{{v.tbText}}</view>
    </view>

    <view class="pts">
      <view class="pt a {{v.done ? 'dis' : ''}}" hover-class="tap-on" data-side="a" bindtap="point">
        <view class="pt-k">{{names.a}}得分</view>
        <view class="pt-n">+1</view>
      </view>
      <view class="pt b {{v.done ? 'dis' : ''}}" hover-class="tap-on" data-side="b" bindtap="point">
        <view class="pt-k">{{names.b}}得分</view>
        <view class="pt-n">+1</view>
      </view>
    </view>

    <view wx:if="{{v.done}}" class="card fin">
      <view class="fin-t">{{v.resultText}}</view>
      <view class="fin-s">{{v.setsText}}</view>
      <view class="btn-primary" hover-class="tap-on" bindtap="handoff">{{ev ? '带入这一场录分' : '带入日常录分'}}</view>
      <view wx:if="{{ev}}" class="fin-n">回到这一场的录分页，局分已经填好，核对后点「提交比分」才会保存。点错了可以先撤销上一分</view>
      <view wx:else class="fin-n">带入后选好球员、核对比分再保存；日常比赛只能由参加的正式成员记录，在录分页里你固定在 A 方。点错了可以先撤销上一分</view>
    </view>

    <view class="ops">
      <view class="btn-line op {{v.canUndo ? '' : 'disabled'}}" hover-class="tap-on" bindtap="undo">撤销上一分</view>
      <view class="btn-line op" hover-class="tap-on" bindtap="goSetup">新一场</view>
    </view>
    <view class="note">已记 {{v.count}} 分 · 自动保存在本机，离开后回来可以继续</view>
  </block>
</view>
