<!-- 顶部大卡片：照片、昵称、性别、网球等级（比赛等级 / 自评分开）、简介 -->
<view class="pcard {{view.profile ? '' : 'pcard-empty'}}" bindtap="edit">
  <view class="court"><view class="c-line l1"></view><view class="c-line l2"></view><view class="c-line l3"></view></view>

  <view class="pc-top">
    <view class="pc-photo-wrap"><av-img class="pc-photo" src="{{view.profile ? view.profile.avatar : ''}}" /></view>
    <view class="pc-main">
      <block wx:if="{{view.profile}}">
        <view class="pc-name">{{view.profile.name}}</view>
        <view class="pc-tags">
          <text class="pc-tag">{{view.profile.gender}}</text>
          <text class="pc-tag">{{view.level.tier}}</text>
          <text wx:if="{{view.level.provisional}}" class="pc-tag hl">定级中 {{view.level.played}}/{{view.level.need}}</text>
        </view>
        <view wx:if="{{follow}}" class="pc-follow" catchtap="openFollows">{{follow.self ? '关注 ' + follow.following + ' · 粉丝 ' + follow.followers + ' ›' : '粉丝 ' + follow.followers}}</view>
      </block>
      <block wx:elif="{{isSelf || !loaded}}">
        <view class="pc-name">未设置资料</view>
        <view class="pc-tags"><text class="pc-tag">完善后可报名、出现在排行榜</text></view>
      </block>
      <block wx:else>
        <view class="pc-name">球员未设置资料</view>
        <view class="pc-tags"><text class="pc-tag">这位球员还没有完善资料</text></view>
      </block>
    </view>
    <view wx:if="{{isSelf}}" class="pc-edit" catchtap="edit">{{view.profile ? '编辑资料' : '完善资料'}}</view>
  </view>

  <block wx:if="{{view.profile}}">
    <view class="pc-level">
      <view>
        <view class="pc-lv-lbl"><view class="ball-dot"></view>比赛等级</view>
        <view class="pc-lv {{view.level.match === '暂无' ? 'none' : ''}}">{{view.level.match}}</view>
      </view>
      <view class="pc-lv-side">
        <view class="pc-self">自评等级 <text class="b">{{view.level.self}}</text></view>
        <view wx:if="{{view.level.last}}" class="pc-last {{view.level.up ? 'up' : ''}} {{view.level.down ? 'down' : ''}}">上一场 {{view.level.last}}</view>
        <view wx:elif="{{view.level.match === '暂无'}}" class="pc-lv-note">打完正式比赛后自动计算</view>
      </view>
    </view>
    <view wx:if="{{bio}}" class="pc-bio">“{{bio}}”</view>
  </block>
  <view wx:elif="{{isSelf}}" class="pc-cta">完善球员资料 ›</view>
</view>

<block wx:if="{{view.profile}}">
  <!-- 数据卡片：全部由正式战绩自动计算，不能手动修改 -->
  <view class="stats4">
    <view class="s4"><text class="n {{view.stats.rank === '暂无' ? 'none' : ''}}">{{view.stats.rank}}</text><text class="l">排名</text></view>
    <view class="s4"><text class="n {{view.stats.matches === '暂无' ? 'none' : ''}}">{{view.stats.matches}}</text><text class="l">比赛场数</text></view>
    <view class="s4"><text class="n sm {{view.stats.wl === '暂无' ? 'none' : ''}}">{{view.stats.wl}}</text><text class="l">胜负</text></view>
    <view class="s4"><text class="n {{view.stats.rate === '暂无' ? 'none' : ''}}">{{view.stats.rate}}</text><text class="l">胜率</text></view>
  </view>
  <view class="foot-note">{{view.ambiguous ? '这个昵称和其他账号重复，统计暂不可用' : '数据根据正式战绩自动计算（日常比赛需对手确认）'}}</view>

  <!-- 别人的主页：关注 / 发起挑战 / 评价（评价必须关联已确认的交手比赛） -->
  <view wx:if="{{loaded && !isSelf}}" class="acts">
    <view wx:if="{{follow}}" class="act {{follow.on ? 'on' : ''}} {{busy ? 'dis' : ''}}" bindtap="toggleFollow">{{follow.on ? '已关注' : '＋ 关注'}}</view>
    <view class="act" bindtap="challenge">发起挑战</view>
    <view class="act main {{busy ? 'dis' : ''}}" bindtap="reviewTa">评价 TA</view>
  </view>

  <!-- 近期比赛 -->
  <view class="card">
    <view class="card-title row-t"><text>近期比赛</text><text wx:if="{{total}}" class="more" bindtap="allHistory">全部 {{total}} 场 ›</text></view>
    <view wx:if="{{!recent.length}}" class="muted">还没有正式比赛记录</view>
    <view wx:for="{{recent}}" wx:key="id" class="mr" data-id="{{item.id}}" bindtap="openMatch">
      <view class="mr-l">
        <view class="mr-top"><text class="mr-date">{{item.md}}</text><text class="mr-ev {{item.isEvent ? 'ev' : ''}}">{{item.event}}</text></view>
        <view class="mr-opp">vs {{item.opp}}<text wx:if="{{item.partner}}" class="mr-pt">（搭档 {{item.partner}}）</text></view>
      </view>
      <view class="mr-r">
        <text wx:if="{{item.outcomeTag}}" class="mr-res wo">{{item.outcomeTag}}</text>
        <text wx:else class="mr-res {{item.win ? 'w' : 'l'}}">{{item.win ? '胜' : '负'}}</text>
        <text class="mr-sc">{{item.score}}</text>
        <text wx:if="{{item.delta}}" class="mr-d {{item.up ? 'up' : ''}} {{item.down ? 'down' : ''}}">{{item.delta}}</text>
      </view>
    </view>
  </view>

  <!-- 赛季战绩：按比赛日期的自然年划分，和上面的生涯数据同一个口径 -->
  <view wx:if="{{view.career.seasons.length}}" class="card">
    <view class="card-title">赛季战绩<text class="sub">按自然年 · 等级分不分赛季</text></view>
    <view class="ss-row ss-head"><text class="ss-s">赛季</text><text class="ss-c">场数</text><text class="ss-c">胜-负</text><text class="ss-c">胜率</text><text class="ss-c">冠军</text></view>
    <view wx:for="{{view.career.seasons}}" wx:key="season" class="ss-row {{item.now ? 'now' : ''}}">
      <text class="ss-s">{{item.season}}<text wx:if="{{item.now}}" class="ss-now">本赛季</text></text>
      <text class="ss-c">{{item.played}}</text><text class="ss-c b">{{item.wl}}</text><text class="ss-c">{{item.rate}}</text>
      <text class="ss-c">{{item.titles ? '🏆 ' + item.titles : '-'}}</text>
    </view>
  </view>

  <!-- 生涯成就：由正式战绩自动计算 -->
  <view wx:if="{{view.career.has}}" class="card">
    <view class="card-title row-t"><text>生涯成就<text class="sub">已达成 {{view.career.got}} / {{view.career.total}}</text></text><text class="more" bindtap="toggleBadges">{{allBadges ? '收起' : '全部徽章'}} ›</text></view>
    <view class="cr-grid">
      <view wx:for="{{view.career.cells}}" wx:key="l" class="cr-cell"><text class="n {{item.n === '暂无' ? 'none' : ''}}">{{item.n}}</text><text class="l">{{item.l}}</text></view>
    </view>
    <view class="bd-wrap">
      <block wx:for="{{view.career.badges}}" wx:key="id">
        <view wx:if="{{item.got || allBadges}}" class="bd {{item.got ? '' : 'off'}}" data-i="{{index}}" bindtap="badgeTip">
          <text class="bd-ic">{{item.icon}}</text><text class="bd-n">{{item.name}}</text><text wx:if="{{!item.got}}" class="bd-p">{{item.progress}}</text>
        </view>
      </block>
      <view wx:if="{{!view.career.got && !allBadges}}" class="muted">还没有达成的徽章，点「全部徽章」看看怎么拿</view>
    </view>
    <view wx:for="{{view.career.titles}}" wx:key="index" class="cr-line"><text class="cr-k">🏆 冠军</text><text class="cr-v">{{item.title}}<text class="cr-d">{{item.date}}</text></text></view>
    <view wx:for="{{view.career.lines}}" wx:key="k" class="cr-line"><text class="cr-k">{{item.k}}</text><text class="cr-v">{{item.v}}</text></view>
  </view>

  <!-- 对手评价（匿名，和竞技等级分开） -->
  <view wx:if="{{rep}}" class="card">
    <view class="card-title">对手评价<text class="sub">匿名 · 不影响等级和排名</text></view>
    <view wx:if="{{!rep.count}}" class="muted">还没有对手评价</view>
    <block wx:else>
      <view class="rep-top"><text class="rep-big">{{rep.overall}}</text><text class="rep-cnt">综合评分 · {{rep.count}} 条评价{{rep.few ? '（较少，仅供参考）' : ''}}</text></view>
      <view wx:for="{{rep.dims}}" wx:key="k" class="rep-dim">
        <text class="rep-t">{{item.t}}</text>
        <view class="rep-bar"><view class="rep-fill" style="width:{{item.w}}%"></view></view>
        <text class="rep-v">{{item.v}}</text>
      </view>
      <view wx:for="{{rep.recent}}" wx:key="index" class="rep-txt">“{{item.text}}”<text class="rep-d">{{item.date}}</text></view>
    </block>
  </view>
</block>
