<!-- 球员卡（卡面不写标题）：头像 / 首字圆、昵称、比赛等级最突出；下方排名、场数、胜率。全部由正式战绩自动计算，只在小程序里展示 -->
<view class="pcard bg-host ani-sheen {{view.profile ? '' : 'pcard-empty'}}">
  <image class="bg-img" src="/images/bg-card.jpg" mode="aspectFill" />
  <view class="court"><view class="c-line l1"></view><view class="c-line l2"></view><view class="c-line l3"></view></view>

  <view class="pc-top">
    <view class="pc-photo-wrap"><pl-av wx:if="{{view.profile}}" class="pc-photo init" uid="{{view.profile.uid}}" name="{{view.profile.name}}" preview /><view wx:else class="pc-photo init" style="background:#C9C9DE"></view></view>
    <view class="pc-main">
      <!-- 昵称和右侧胶囊同一行：本人显示「编辑资料」，他人主页补球风主标签 / 球风数据入口，长昵称自动省略 -->
      <view class="pc-head">
        <view wx:if="{{view.profile}}" class="pc-name">{{view.profile.name}}</view>
        <view wx:elif="{{isSelf || !loaded}}" class="pc-name">未设置资料</view>
        <view wx:else class="pc-name">球员未设置资料</view>
        <view wx:if="{{isSelf}}" class="pc-edit" hover-class="tap-on" catchtap="edit">{{view.profile ? '编辑资料' : '完善资料'}}</view>
        <view wx:elif="{{view.profile && report}}" class="pc-style {{report.unlocked ? 'on' : ''}}" hover-class="tap-on" catchtap="openReport">{{report.unlocked ? report.tag : '球风数据 ›'}}</view>
      </view>
      <block wx:if="{{view.profile}}">
        <view class="pc-tags">
          <text class="pc-tag">{{view.profile.gender}}</text>
          <text wx:if="{{view.level.tier}}" class="pc-tag">{{view.level.tier}}</text>
          <text wx:if="{{view.level.provisional}}" class="pc-tag hl">定级中 {{view.level.played}}/{{view.level.need}}</text>
        </view>
        <view wx:if="{{form.length}}" class="pc-form">
          <text class="pc-fl">近 {{form.length}} 场</text>
          <view wx:for="{{form}}" wx:key="i" class="pc-fd {{item.w ? 'w' : ''}}">{{item.w ? '胜' : '负'}}</view>
        </view>
      </block>
      <block wx:elif="{{isSelf || !loaded}}">
        <view class="pc-tags"><text class="pc-tag">完善后可报名、出现在排行榜</text></view>
      </block>
      <block wx:else>
        <view class="pc-tags"><text class="pc-tag">这位球员还没有完善资料</text></view>
      </block>
    </view>
  </view>

  <block wx:if="{{view.profile}}">
    <!-- 比赛等级（正式比赛算出）和自评等级（资料里填的）分开标注；没有的写「待定级」 -->
    <view class="pc-level">
      <view>
        <view class="pc-lv-lbl">比赛等级</view>
        <view class="pc-lv num {{view.level.match === '待定级' ? 'none' : ''}}">{{view.level.match}}</view>
      </view>
      <view class="pc-lv-side">
        <view class="pc-self">自评等级 <text class="b num {{view.level.self === '待定级' ? 'none' : ''}}">{{view.level.self}}</text></view>
        <view wx:if="{{view.level.last}}" class="pc-last {{view.level.up ? 'up' : ''}} {{view.level.down ? 'down' : ''}}">上一场 {{view.level.last}}</view>
        <view wx:elif="{{view.level.match === '待定级'}}" class="pc-lv-note">打完正式比赛后自动定级</view>
      </view>
    </view>
    <view class="pc-stats">
      <view class="pcs"><text class="n num {{view.stats.rank === '暂无' || view.stats.rank === '未公开' ? 'none' : ''}}">{{view.stats.rank}}</text><text class="l">排名</text></view>
      <view class="pcs"><text class="n num {{view.stats.matches === '暂无' ? 'none' : ''}}">{{view.stats.matches}}</text><text class="l">场数</text></view>
      <view class="pcs"><text class="n num {{view.stats.rate === '暂无' ? 'none' : ''}}">{{view.stats.rate}}</text><text class="l">胜率</text></view>
    </view>
  </block>
  <view wx:elif="{{isSelf}}" class="pc-cta">完善球员资料 ›</view>
</view>

<block wx:if="{{view.profile}}">
  <view wx:if="{{view.ambiguous}}" class="foot-note">这个昵称和其他账号重复，统计暂不可用</view>
  <view wx:if="{{isSelf && !view.profile.shown}}" class="foot-note">没有开启公开展示：排行榜里不显示你，排名显示「未公开」，可以在「编辑资料」里开启</view>

  <!-- 我和 TA 的交手记录（只在别人的主页显示） -->
  <view wx:if="{{loaded && !isSelf && h2h}}" class="card">
    <view class="card-title row-t"><text>我和 TA 的交手</text><text wx:if="{{h2h.played}}" class="h2h-sum">{{h2h.played}} 场 · 我 {{h2h.win}} 胜 {{h2h.lose}} 负</text></view>
    <view wx:if="{{!h2h.total}}" class="muted">还没有交手过</view>
    <view wx:for="{{h2h.rows}}" wx:key="id" class="mr" hover-class="tap-row-on" data-id="{{item.id}}" bindtap="openMatch">
      <view class="mr-top"><text class="mr-date">{{item.md}}</text><text class="mr-ev {{item.isEvent ? 'ev' : ''}}">{{item.event}}</text></view>
      <view class="mr-main">
        <view class="mr-opp">vs {{item.opp}}<text wx:if="{{item.partner}}" class="mr-pt">（搭档 {{item.partner}}）</text></view>
        <view class="mr-r">
          <text wx:if="{{item.outcomeTag}}" class="mr-res wo">{{item.outcomeTag}}</text>
          <text wx:else class="mr-res {{item.win ? 'w' : 'l'}}">{{item.win ? '我胜' : '我负'}}</text>
          <text class="mr-sc">{{item.score}}</text>
        </view>
      </view>
      <view wx:if="{{item.tags.length}}" class="mr-tags"><text wx:for="{{item.tags}}" wx:key="k" wx:for-item="t" class="ui-tag {{t.cls}} mr-tag">{{t.t}}</text></view>
    </view>
    <view wx:if="{{h2h.total > h2h.rows.length}}" class="h2h-more">只显示最近 {{h2h.rows.length}} 场，共 {{h2h.total}} 场</view>
    <!-- 「如果和 TA 打一场」水平分模拟 -->
    <view wx:if="{{simRes}}" class="sim-tog" bindtap="toggleSim">
      <text class="sim-tog-t">如果和 TA 打一场，水平分会怎么变？</text>
      <text class="sim-tog-a">{{simOpen ? '收起' : '试算 ›'}}</text>
    </view>
    <view wx:if="{{simOpen && simRes}}" class="sim-box">
      <view class="sim-bar">
        <text class="sim-who">假设比分（我 : TA）</text>
        <view class="sim-modes">
          <text class="sim-mode {{simGames === 4 ? 'sim-on' : ''}}" data-g="4" bindtap="setSimGames">4 局</text>
          <text class="sim-mode {{simGames === 6 ? 'sim-on' : ''}}" data-g="6" bindtap="setSimGames">6 局</text>
        </view>
      </view>
      <view class="sim-chips">
        <view wx:for="{{simPresets}}" wx:key="label" class="sim-chip num {{simIdx === index ? 'sim-on' : ''}}" data-i="{{index}}" bindtap="pickSim">{{item.label}}</view>
      </view>
      <view class="sim-res sim-{{simRes.dir}}">
        <view class="sim-res-top">
          <text class="sim-res-t">{{simRes.arrow ? simRes.arrow + ' ' : ''}}{{simRes.title}}</text>
          <text class="sim-res-tier {{simRes.tierUp ? 'sim-tup' : ''}} {{simRes.tierDown ? 'sim-tdown' : ''}}">{{simRes.tierText}}</text>
        </view>
        <view class="sim-res-s">{{simRes.summary}}</view>
        <view class="sim-res-meta">模拟得局 {{simRes.shareText}} · 赛前预期 {{simRes.expectedText}}{{simRes.provText ? ' · ' + simRes.provText : ''}}</view>
      </view>
    </view>
  </view>

  <!-- 球风与年度数据入口卡：五维球风、等级走势、打球热力图、关键分统计、苦主 / 福星与双打搭档收在二级页 pages/report，保持主页清爽 -->
  <view wx:if="{{report}}" class="card rp-card" hover-class="tap-on" bindtap="openReport">
    <view class="rp-ic"></view>
    <view class="rp-m">
      <view class="rp-t">球风与年度数据<text wx:if="{{report.tag}}" class="rp-tag {{report.unlocked ? 'rp-on' : ''}}">{{report.tag}}</text></view>
      <view class="rp-s">{{report.sub}}</view>
    </view>
    <text class="rp-go">›</text>
  </view>

  <!-- 近期比赛（「我的」页不显示） -->
  <view wx:if="{{!mine}}" class="card">
    <view class="card-title row-t"><text>近期比赛</text><text wx:if="{{total}}" class="more" bindtap="allHistory">全部 {{total}} 场 ›</text></view>
    <view wx:if="{{!recent.length}}" class="muted">还没有正式比赛记录</view>
    <view wx:for="{{recent}}" wx:key="id" class="mr ani-in" style="animation-delay:{{index * 50}}ms" hover-class="tap-row-on" data-id="{{item.id}}" bindtap="openMatch">
      <view class="mr-top"><text class="mr-date">{{item.md}}</text><text class="mr-ev {{item.isEvent ? 'ev' : ''}}">{{item.event}}</text></view>
      <view class="mr-main">
        <view class="mr-opp">vs {{item.opp}}<text wx:if="{{item.partner}}" class="mr-pt">（搭档 {{item.partner}}）</text></view>
        <view class="mr-r">
          <text wx:if="{{item.outcomeTag}}" class="mr-res wo">{{item.outcomeTag}}</text>
          <text wx:else class="mr-res {{item.win ? 'w' : 'l'}}">{{item.win ? '胜' : '负'}}</text>
          <text class="mr-sc">{{item.score}}</text><text wx:if="{{item.delta}}" class="mr-d {{item.up ? 'up' : ''}} {{item.down ? 'down' : ''}}">{{item.delta}}</text>
        </view>
      </view>
      <view wx:if="{{item.tags.length}}" class="mr-tags"><text wx:for="{{item.tags}}" wx:key="k" wx:for-item="t" class="ui-tag {{t.cls}} mr-tag">{{t.t}}</text></view>
    </view>
  </view>

  <!-- 生涯成就：由正式战绩自动计算 -->
  <view wx:if="{{view.career.has}}" class="card cr">
    <view class="cr-head">
      <text class="cr-title">生涯成就</text>
      <view class="cr-cnt"><text class="l">徽章</text><text class="b">{{view.career.got}}</text><text class="t">/ {{view.career.total}}</text></view>
    </view>
    <view class="cr-prog"><view class="cr-prog-in ani-grow-x" style="width:{{view.career.pct}}%"></view></view>

    <view class="cr-nums">
      <view wx:for="{{view.career.cells}}" wx:key="l" class="cn {{item.cls}}"><text class="n num {{item.n === '暂无' ? 'none' : ''}}">{{item.n}}</text><text class="l">{{item.l}}</text></view>
    </view>

    <view class="cr-sec"><text>徽章</text><text class="more" bindtap="toggleBadges">{{allBadges ? '只看已达成' : '全部 ' + view.career.total + ' 个'}} ›</text></view>
    <view class="bd-grid">
      <block wx:for="{{view.career.badges}}" wx:key="id">
        <view wx:if="{{item.got || allBadges}}" class="bd {{item.got ? 'got ani-in' : 'off'}}" style="{{item.got ? 'animation-delay:' + (index < 8 ? index * 45 : 360) + 'ms' : ''}}" hover-class="tap-on" data-i="{{index}}" bindtap="badgeTip">
          <view class="bd-in">
            <view class="bd-ic"><image class="bd-img" src="/images/badges/{{item.id}}.png" mode="aspectFit" /></view>
            <text class="bd-n">{{item.name}}</text>
            <view wx:if="{{!item.got}}" class="bd-bar"><view class="bd-bar-in" style="width:{{item.pct}}%"></view></view>
            <text wx:if="{{!item.got}}" class="bd-p">{{item.progress}}</text>
          </view>
        </view>
      </block>
      <view wx:if="{{!view.career.got && !allBadges}}" class="bd-none">还没有达成的徽章，点「全部」看看怎么拿</view>
    </view>

    <view wx:if="{{view.career.titles.length || (mine && total)}}" class="cr-list">
      <view wx:for="{{view.career.titles}}" wx:key="index" class="cr-line"><view class="cr-k"><text class="ui-tag lime">冠军</text></view><text class="cr-v">{{item.title}}</text><text class="cr-d">{{item.date}}</text></view>
      <view wx:if="{{mine && total}}" class="cr-line cr-all" hover-class="tap-row-on" bindtap="allHistory"><text class="cr-k">全部比赛</text><text class="cr-v">{{total}} 场正式比赛</text><text class="cr-go">›</text></view>
    </view>
  </view>

  <!-- 还没有正式比赛（只在「我的」）：照样摆出徽章（都没达成），告诉本人第一个怎么拿；默认只露前两行。本机有缓存就先显示（cached），不等云端 -->
  <view wx:if="{{mine && (loaded || cached) && !view.career.has}}" class="card cr">
    <view class="cr-head">
      <text class="cr-title">生涯成就</text>
      <view class="cr-cnt"><text class="l">徽章</text><text class="b">0</text><text class="t">/ {{view.career.total}}</text></view>
    </view>
    <view class="cr-tip">打完第一场正式比赛，就能拿到「初登场」</view>
    <view class="bd-grid cr-first">
      <block wx:for="{{view.career.badges}}" wx:key="id">
        <view wx:if="{{index < 8 || allBadges}}" class="bd off" hover-class="tap-on" data-i="{{index}}" bindtap="badgeTip">
          <view class="bd-in">
            <view class="bd-ic"><image class="bd-img" src="/images/badges/{{item.id}}.png" mode="aspectFit" /></view>
            <text class="bd-n">{{item.name}}</text>
          </view>
        </view>
      </block>
    </view>
    <view class="cr-more"><view class="btn-line mini" hover-class="tap-on" bindtap="toggleBadges">{{allBadges ? '收起' : '看全部 ' + view.career.total + ' 个徽章'}}</view></view>
  </view>
</block>
