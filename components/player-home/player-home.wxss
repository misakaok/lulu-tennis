/* 球员卡 */
.pcard {
  border-radius: 36rpx; padding: 32rpx 32rpx 28rpx; color: #fff;
  background: #9594C1; /* 背景图 images/bg-card.jpg（纯场地纹理）还没显示时的底色 */
  box-shadow: 0 18rpx 40rpx rgba(133, 133, 184, 0.35);
}
.pcard.pcard-empty { padding-bottom: 36rpx; }
/* 球员主页是推入页：等滑入动画（约 300ms）结束再扫高光 */
.pcard.ani-sheen::after { animation-delay: 0.35s; }
/* 整张卡的对角微光（左上亮、右下压一点冷紫）+ 圆角顶边 1rpx 内高光：背景图盖住了卡片自己的 inset 阴影，所以用 ::before 画；
   ::after 留给 .ani-sheen。z-index 0 叠在 .bg-img（-1）上面、其余内容下面 */
.pcard::before {
  content: ''; position: absolute; left: 0; right: 0; top: 0; bottom: 0;
  border-radius: inherit; pointer-events: none; z-index: 0;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.14) 0%, rgba(255, 255, 255, 0) 45%, rgba(56, 54, 108, 0.18) 100%);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.42);
}

/* 球场线 + 网球：运动感装饰 */
/* 斜放的球场线只作底纹：往右下退一点、压淡，不抢文字 */
.court { position: absolute; right: -140rpx; top: -10rpx; width: 460rpx; height: 560rpx; transform: rotate(-24deg); border: 3rpx solid rgba(255,255,255,0.10); border-radius: 8rpx; }
.c-line { position: absolute; background: rgba(255,255,255,0.08); }
.c-line.l1 { left: 0; right: 0; top: 50%; height: 3rpx; }
.c-line.l2 { top: 0; bottom: 0; left: 50%; width: 3rpx; }
.c-line.l3 { left: 14%; right: 14%; top: 22%; bottom: 22%; background: none; border: 3rpx solid rgba(255,255,255,0.08); }
.pc-top { position: relative; display: flex; align-items: flex-start; }
.pc-photo-wrap { flex: none; padding: 6rpx; border-radius: 34rpx; background: rgba(255,255,255,0.9); }
.pc-photo { width: 168rpx; height: 168rpx; border-radius: 28rpx; display: block; background: #ECECF6; }
.pc-photo.init { display: flex; align-items: center; justify-content: center; color: #fff; font-size: 76rpx; font-weight: 800; }
.pc-main { flex: 1; min-width: 0; margin-left: 26rpx; }
.pc-head { display: flex; align-items: center; justify-content: space-between; }
.pc-name { flex: 1; min-width: 0; margin-right: 16rpx; font-size: 44rpx; font-weight: 900; letter-spacing: 1rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.pc-tags { margin-top: 12rpx; display: flex; flex-wrap: wrap; }
.pc-tag { font-size: 21rpx; background: rgba(255,255,255,0.2); border-radius: 18rpx; padding: 4rpx 14rpx; margin: 0 10rpx 8rpx 0; }
.pc-tag.hl { background: #fff; color: #6E6EA3; font-weight: 700; }
/* 轻透磨砂小胶囊；过渡写在元素本身上，松手也回弹 */
.pc-edit {
  flex: none; padding: 8rpx 22rpx; border-radius: 28rpx; font-size: 22rpx; font-weight: 600; color: #fff;
  background: rgba(255, 255, 255, 0.18); border: 1rpx solid rgba(255, 255, 255, 0.34);
  backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
  transition: transform 0.16s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.16s ease;
}
.pc-level { position: relative; display: flex; align-items: flex-end; justify-content: space-between; margin-top: 26rpx; }
.pc-lv-lbl { font-size: 22rpx; opacity: 0.9; letter-spacing: 2rpx; }
.pc-lv { font-size: 108rpx; font-weight: 900; line-height: 0.96; letter-spacing: -0.03em; text-shadow: 0 6rpx 18rpx rgba(54, 52, 104, 0.26); } /* 正体记分牌数字，和卡上其他数字一致 */
.pc-lv-side { text-align: right; padding-bottom: 10rpx; }
.pc-lv-note { font-size: 21rpx; opacity: 0.9; }
/* 上一场涨 / 跌：小胶囊；涨分点亮网球黄绿，跌分柔和暖红 */
.pc-last { display: inline-flex; align-items: center; margin-top: 8rpx; padding: 4rpx 18rpx; border-radius: 22rpx; font-size: 22rpx; font-weight: 800; background: rgba(56, 54, 108, 0.24); color: rgba(255, 255, 255, 0.92); }
.pc-stats { position: relative; display: flex; margin-top: 24rpx; background: rgba(56, 54, 108, 0.22); background-image: linear-gradient(180deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0)); border-radius: 22rpx; padding: 18rpx 0; backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); border: 1rpx solid rgba(255, 255, 255, 0.24); box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.28), 0 8rpx 20rpx rgba(48, 46, 96, 0.16); } /* 烟熏冷紫毛玻璃：不支持模糊的机型只剩半透明冷紫底，白字照样清楚 */
.pcs { flex: 1; display: flex; flex-direction: column; align-items: center; }
.pcs + .pcs { border-left: 1rpx solid rgba(255, 255, 255, 0.16); }
.pcs .n { height: 54rpx; line-height: 54rpx; font-size: 38rpx; font-weight: 900; white-space: nowrap; font-variant-numeric: tabular-nums; }
.pcs .n.none { font-size: 26rpx; font-weight: 600; opacity: 0.8; }
.pcs .l { font-size: 21rpx; opacity: 0.9; margin-top: 4rpx; }
.pc-cta { position: relative; margin-top: 30rpx; height: 84rpx; line-height: 84rpx; text-align: center; border-radius: 42rpx; background: #fff; color: #6E6EA3; font-weight: 800; font-size: 30rpx; }
.last.up { color: #E6FFD9; }
.pc-last.up { background: #C9E33A; color: #2E3600; box-shadow: 0 4rpx 14rpx rgba(201, 227, 58, 0.30); }
.pc-last.down { background: rgba(255, 218, 218, 0.22); color: #FFE8E8; border: 1rpx solid rgba(255, 210, 210, 0.35); }

.pc-lv.none { font-size: 56rpx; opacity: 0.85; margin-top: 16rpx; line-height: 1.1; }
.pc-self { font-size: 22rpx; opacity: 0.95; margin-bottom: 6rpx; }
.pc-self .b { font-size: 30rpx; font-weight: 900; margin-left: 6rpx; }
.pc-self .b.none { font-size: 24rpx; font-weight: 600; opacity: 0.85; }
.foot-note { text-align: center; font-size: 21rpx; color: #84849E; margin: 12rpx 0 20rpx; }
.acts { display: flex; margin-bottom: 20rpx; }
.act { flex: 1; height: 80rpx; line-height: 80rpx; text-align: center; border-radius: 40rpx; margin: 0 8rpx; font-size: 28rpx; font-weight: 700; color: #6E6EA3; background: #fff; border: 2rpx solid #CFCFE6; }
.act.main { color: #fff; border-color: transparent; background: linear-gradient(90deg, #8484B6, #A3A3CB); }
/* 近期比赛 */
.row-t { display: flex; justify-content: space-between; align-items: center; }
.more { font-size: 24rpx; color: #6E6EA3; font-weight: 500; }
.muted { color: #84849E; font-size: 24rpx; }
/* 每行三层：日期 + 名称 → 对手（左）和胜负、比分（右）同一行居中对齐 → 亮点标签 */
.mr { padding: 20rpx 0; }
.mr + .mr { border-top: 1rpx solid #F2F2F8; } /* 分隔线只画在两行之间，第一行上面不画（见 tests/review-surface.test.js） */
.mr:last-child { padding-bottom: 0; } /* 卡片最后一行：下边距不叠在卡片内边距上（否则底部比顶部多出一截留白） */
.mr-top { display: flex; align-items: center; font-size: 21rpx; line-height: 1.4; color: #84849E; }
.mr-main { display: flex; align-items: center; margin-top: 12rpx; }
.mr-date { margin-right: 12rpx; }
.mr-ev { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.mr-ev.ev { color: #6E6EA3; font-weight: 600; }
.mr-opp { flex: 1; min-width: 0; font-size: 27rpx; line-height: 40rpx; font-weight: 600; color: #2E2E4A; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.mr-pt { font-size: 21rpx; color: #84849E; font-weight: 400; }
.mr-r { flex: none; display: flex; align-items: center; margin-left: 16rpx; }
.mr-res { height: 36rpx; line-height: 36rpx; min-width: 52rpx; box-sizing: border-box; text-align: center; font-size: 20rpx; font-weight: 800; border-radius: 8rpx; padding: 0 10rpx; }
.mr-res.w { background: #e7f6ec; color: #2f8a52; }
.mr-res.l { background: #f6eeee; color: #b34d4d; }
.mr-sc { margin-left: 12rpx; font-size: 26rpx; line-height: 36rpx; color: #4F4F7D; font-weight: 700; }
.mr-d { margin-left: 8rpx; font-size: 24rpx; line-height: 36rpx; color: #70708C; font-weight: 700; }
.mr-d.up { color: #2f8a52; }
.mr-d.down { color: #b34d4d; }
.pc-lv-lbl { display: flex; align-items: center; margin-bottom: 4rpx; }
.ball-dot { width: 26rpx; height: 26rpx; border-radius: 50%; margin-right: 10rpx; background: radial-gradient(circle at 35% 35%, #F3F9B8, #D5E66B); box-shadow: 0 3rpx 8rpx rgba(0,0,0,0.12); }
.mr-res.wo { background: #fff8e6; color: #b7791f; }

/* 赛季战绩 */
.ss-row { display: flex; align-items: center; height: 68rpx; border-top: 1rpx solid #F2F2F8; font-size: 25rpx; color: #3A3A52; }
.ss-row.ss-head { border-top: 0; height: 44rpx; font-size: 21rpx; color: #84849E; }
.ss-s { flex: 1.6; display: flex; align-items: center; }
.ss-c { flex: 1; text-align: center; }
.ss-c.b { font-weight: 700; }
/* 生涯成就：标题 + 徽章进度条 → 3 × 2 数字格 → 4 列徽章 → 记录列表 */
.cr-head { display: flex; align-items: baseline; justify-content: space-between; }
.cr-title { font-size: 32rpx; font-weight: 800; color: #2E2E4A; }
/* 徽章进度「徽章 3 / 21」：两个数字同一字号、按基线对齐，已达成的加粗紫色，总数灰色 */
.cr-cnt { display: flex; align-items: baseline; color: #70708C; font-variant-numeric: tabular-nums; }
.cr-cnt .l { font-size: 22rpx; margin-right: 10rpx; }
.cr-cnt .b { font-size: 28rpx; font-weight: 800; color: #6E6EA3; }
.cr-cnt .t { font-size: 28rpx; font-weight: 600; margin-left: 6rpx; }
.cr-prog { height: 10rpx; margin-top: 16rpx; border-radius: 5rpx; background: #EFEFF6; overflow: hidden; }
.cr-prog-in { height: 100%; border-radius: 5rpx; background: #A3A3CB; }
.cr-nums { display: flex; flex-wrap: wrap; margin-top: 26rpx; border-radius: 22rpx; background: #F8F8FC; }
.cn { width: 33.33%; box-sizing: border-box; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 22rpx 0 20rpx; }
.cn.bl { border-left: 1rpx solid #E9E9F2; }
.cn.bt { border-top: 1rpx solid #E9E9F2; }
/* 数字放在同样高的一行里：「暂无」字小也不错位 */
.cn .n { height: 56rpx; line-height: 56rpx; font-size: 40rpx; font-weight: 900; color: #4F4F7D; white-space: nowrap; }
.cn .n.none { font-size: 26rpx; font-weight: 500; color: #C5C5DA; }
.cn.hot .n { padding: 0 22rpx; border-radius: 28rpx; background: #C9E33A; color: #2E3600; }
.cn .l { margin-top: 6rpx; font-size: 21rpx; line-height: 1.3; color: #70708C; }
.cr-sec { display: flex; align-items: center; justify-content: space-between; margin: 32rpx 0 14rpx; font-size: 26rpx; font-weight: 800; color: #2E2E4A; }
.bd-grid { display: flex; flex-wrap: wrap; margin: 0 -6rpx; }
.bd { width: 25%; box-sizing: border-box; padding: 6rpx; }
.bd-in { height: 100%; box-sizing: border-box; display: flex; flex-direction: column; align-items: center; padding: 18rpx 6rpx 14rpx; border-radius: 22rpx; background: #F8F8FC; }
.bd.got .bd-in { background: #EFEFF7; }
.bd-ic { width: 76rpx; height: 76rpx; } /* 图标本身就是圆形章牌，不再套白色小圆 */
.bd-img { display: block; width: 76rpx; height: 76rpx; }
.bd.off .bd-img { opacity: 0.4; filter: grayscale(1); } /* 没达成：灰色变淡 */
.bd-n { margin-top: 12rpx; font-size: 22rpx; line-height: 1.3; font-weight: 700; color: #4F4F7D; white-space: nowrap; }
.bd.off .bd-n { color: #A5A5BA; font-weight: 500; }
.bd-bar { width: 72%; height: 6rpx; margin-top: 10rpx; border-radius: 3rpx; background: #E6E6F0; overflow: hidden; }
.bd-bar-in { height: 100%; border-radius: 3rpx; background: #B9B9DA; }
.bd-p { margin-top: 4rpx; font-size: 19rpx; line-height: 1.3; color: #84849E; }
.bd-none { width: 100%; padding: 6rpx; font-size: 23rpx; color: #84849E; }
.cr-tip { margin-top: 10rpx; font-size: 24rpx; color: #70708C; }
.cr-first { margin-top: 22rpx; }
.cr-more { margin-top: 18rpx; text-align: center; }
.cr-list { margin-top: 22rpx; margin-bottom: -20rpx; } /* 最后一行行高里文字下方已经有约 22rpx 空白，抵掉一部分卡片内边距，底部留白和顶部差不多 */
.cr-line { display: flex; align-items: center; min-height: 80rpx; border-top: 1rpx solid #F2F2F8; font-size: 25rpx; line-height: 1.4; }
/* 标签列固定宽度、左对齐：单打 / 首场比赛 / 全部比赛等每行的标签和内容上下对齐 */
.cr-k { width: 160rpx; flex: none; text-align: left; color: #70708C; }
.cr-v { flex: 1; min-width: 0; text-align: left; color: #2E2E4A; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.cr-d { flex: none; margin-left: 12rpx; font-size: 21rpx; color: #84849E; }
.cr-line.cr-all .cr-v { color: #6E6EA3; }
.cr-go { flex: none; margin-left: 12rpx; font-size: 32rpx; color: #C5C5DA; }

/* 交手记录、等级走势 */
.h2h-sum { font-size: 22rpx; color: #6E6EA3; font-weight: 600; }
.h2h-more { margin-top: 12rpx; font-size: 21rpx; color: #84849E; text-align: center; }
.tr-box { display: flex; height: 180rpx; }
.tr-y { flex: none; width: 64rpx; display: flex; flex-direction: column; justify-content: space-between; font-size: 20rpx; color: #84849E; }
.tr-bars { flex: 1; display: flex; align-items: flex-end; border-bottom: 2rpx solid #ECECF5; }
.tr-col { flex: 1; height: 100%; display: flex; align-items: flex-end; justify-content: center; }
.tr-bar { width: 62%; max-width: 22rpx; min-height: 6rpx; border-radius: 6rpx 6rpx 0 0; background: #C9C9DE; }
.tr-bar.up { background: #6FBF8B; }
.tr-bar.down { background: #E29A9A; }
.tr-x { display: flex; justify-content: space-between; margin: 10rpx 0 0 64rpx; font-size: 20rpx; color: #84849E; }

.pt-n { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.mr-tags { display: flex; flex-wrap: wrap; margin-top: 10rpx; }
.mr-tag { margin: 0 8rpx 4rpx 0; padding: 0 12rpx; font-size: 20rpx; }

/* 苦主 / 福星 / 最佳拍档 */
.rl-row { display: flex; background: #F8F8FC; border-radius: 20rpx; padding: 20rpx 0; }
.rl { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: center; padding: 0 8rpx; }
.rl-l { font-size: 21rpx; color: #70708C; }
.rl-av { width: 76rpx; height: 76rpx; margin: 12rpx 0 10rpx; border-radius: 50%; color: #fff; font-size: 32rpx; font-weight: 800; display: flex; align-items: center; justify-content: center; }
.rl-av.none { background: #E6E6F0; color: #B7B7CC; }
.rl-n { max-width: 100%; font-size: 25rpx; font-weight: 700; color: #2E2E4A; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.rl-n.none { color: #C5C5DA; font-weight: 500; }
.rl-r { margin-top: 2rpx; font-size: 21rpx; color: #70708C; }
