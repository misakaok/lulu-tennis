/* 全部用相对整个方框的百分比定位，方框多大都按比例缩放；整支拍略微倾斜 */
.rka { position: relative; overflow: hidden; flex: none; background: #EFEFF6; }
.rka-r { position: absolute; left: 0; top: 0; width: 100%; height: 100%; transform: translateX(4%) rotate(-20deg) scale(0.95); }
.rka-r > view { position: absolute; box-shadow: 0 0 0 1px rgba(30, 30, 50, 0.16); }
/* 拍框：主色，下半部一圈点缀色带；里面是拍线 */
.rka-head { left: 25%; top: 3%; width: 50%; height: 54%; border-radius: 50%; background: linear-gradient(180deg, var(--f) 0, var(--f) 62%, var(--a) 62%, var(--a) 74%, var(--f) 74%); }
.rka-head .rka-bed { position: absolute; left: 9%; right: 9%; top: 7.5%; bottom: 7.5%; border-radius: 50%; background-color: #FAFAFC; background-image: linear-gradient(90deg, rgba(120, 120, 150, 0.45) 1px, transparent 1px), linear-gradient(0deg, rgba(120, 120, 150, 0.45) 1px, transparent 1px); background-size: 11% 8%; background-position: center; box-shadow: inset 0 0 0 1px rgba(30, 30, 50, 0.1); }
/* 拍喉：两根斜杆从拍框底部收到拍杆 */
.rka-arm { top: 51%; width: 4.2%; height: 17.5%; background: var(--f); transform-origin: 50% 0; }
.rka-arm.l { left: 37.3%; transform: rotate(-29deg); }
.rka-arm.r { left: 58.5%; transform: rotate(29deg); }
.rka-shaft { left: 46%; top: 65.5%; width: 8%; height: 9%; background: var(--f); }
.rka-collar { left: 45.5%; top: 66%; width: 9%; height: 2.6%; background: var(--a); }
/* 手柄：缠了手胶的斜纹；拍尾点缀色 */
.rka-grip { left: 45%; top: 74%; width: 10%; height: 21%; border-radius: 12% / 3%; background-color: var(--g); background-image: repeating-linear-gradient(155deg, rgba(255, 255, 255, 0.16) 0, rgba(255, 255, 255, 0.16) 5%, transparent 5%, transparent 11%); }
.rka-cap { left: 44.5%; top: 94.5%; width: 11%; height: 3.2%; border-radius: 30%; background: var(--a); }
