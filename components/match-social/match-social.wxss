.ms-muted { font-size: 24rpx; color: #A5A5BA; padding: 6rpx 0; }
.ms-btn { margin-top: 20rpx; }
.ms-t2 { margin-top: 30rpx; }
.ms-t2 .sub { font-size: 22rpx; color: #8686A0; font-weight: 400; margin-left: 12rpx; }
.ms-opp { display: flex; align-items: center; height: 80rpx; border-top: 1rpx solid #F2F2F8; }
.ms-name { flex: 1; font-size: 28rpx; font-weight: 600; }
.ms-done { font-size: 24rpx; color: #6E6EA3; }
.ms-go { font-size: 26rpx; color: #fff; background: #6E6EA3; border-radius: 28rpx; padding: 10rpx 26rpx; font-weight: 700; }
.ms-wait { font-size: 22rpx; color: #B7B7CC; }
.ms-req { margin-top: 24rpx; padding: 18rpx 20rpx; border-radius: 16rpx; background: #fff8e6; }
.ms-req-t { font-size: 26rpx; font-weight: 800; color: #9a6a00; }
.ms-req-s { margin-top: 8rpx; font-size: 26rpx; color: #4F4F7D; }
.ms-req-s .b { font-weight: 800; }
.ms-req-r { margin-top: 6rpx; font-size: 23rpx; color: #5C5C76; }
.ms-req-n { margin-top: 6rpx; font-size: 21rpx; color: #A5A5BA; }
.ms-req-acts { display: flex; flex-wrap: wrap; margin-top: 14rpx; }
.ms-a { padding: 10rpx 22rpx; margin: 0 12rpx 10rpx 0; border-radius: 28rpx; font-size: 24rpx; font-weight: 700; color: #6E6EA3; background: #fff; border: 2rpx solid #CFCFE6; }
.ms-a.main { color: #fff; background: #6E6EA3; border-color: #6E6EA3; }

/* 状态条 */
.ms-banner { display: flex; align-items: center; padding: 20rpx 22rpx; border-radius: 20rpx; background: #F7F7FB; }
.ms-ic { flex: none; width: 52rpx; height: 52rpx; margin-right: 18rpx; border-radius: 50%; background: #D6D6E6; color: #fff; font-size: 30rpx; font-weight: 800; display: flex; align-items: center; justify-content: center; }
.ms-banner.ok { background: #F1F1F9; }
.ms-banner.ok .ms-ic { background: linear-gradient(135deg, #A3A3CB, #8484B6); }
.ms-bt { flex: 1; min-width: 0; }
.ms-b1 { font-size: 28rpx; font-weight: 700; color: #4F4F7D; }
.ms-b2 { margin-top: 4rpx; font-size: 22rpx; color: #8686A0; line-height: 1.5; }
.ms-sides { display: flex; margin: 16rpx -8rpx 0; }
.ms-side { flex: 1; min-width: 0; margin: 0 8rpx; padding: 14rpx 18rpx; border-radius: 16rpx; border: 2rpx dashed #DCDCEA; box-sizing: border-box; }
.ms-side.ok { border: 2rpx solid #CFCFE6; background: #FAFAFD; }
.ms-sl { font-size: 20rpx; color: #A5A5BA; }
.ms-sv { margin-top: 2rpx; font-size: 24rpx; color: #A5A5BA; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.ms-side.ok .ms-sv { color: #4F4F7D; font-weight: 600; }
/* 操作按钮 */
.ms-acts { display: flex; flex-wrap: wrap; margin: 12rpx -8rpx 0; }
.ms-act, .ms-revoke { flex: 1; min-width: 180rpx; margin: 12rpx 8rpx 0; height: 76rpx; line-height: 72rpx; text-align: center; border-radius: 38rpx; border: 2rpx solid #CFCFE6; font-size: 26rpx; font-weight: 600; color: #6E6EA3; box-sizing: border-box; white-space: nowrap; }
.ms-revoke { color: #B34D4D; border-color: #EBD3D3; }
