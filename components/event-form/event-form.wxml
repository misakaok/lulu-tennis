<view class="ef-row">
  <text class="label">比赛日期</text>
  <picker mode="date" value="{{v.date}}" start="{{today}}" bindchange="onDate">
    <view class="ef-pick">{{v.date}} <text class="ef-arrow">›</text></view>
  </picker>
</view>
<view class="ef-row">
  <text class="label">开始时间</text>
  <picker mode="time" value="{{v.startTime || '09:00'}}" bindchange="onTime">
    <view class="ef-pick {{v.startTime ? '' : 'ph'}}">{{v.startTime || '选择时间'}} <text class="ef-arrow">›</text></view>
  </picker>
</view>
<view class="ef-row">
  <text class="label">场地名称</text>
  <input class="ef-in" value="{{v.venue}}" data-k="venue" bindinput="onInput" maxlength="30" placeholder="例如：XX 网球中心 3 号场" />
</view>
<view class="ef-row">
  <text class="label">地图定位</text>
  <view class="ef-loc" bindtap="pickLocation">{{locText ? '📍 ' + locText : '在地图上选择'}} <text class="ef-arrow">›</text></view>
  <text wx:if="{{locText}}" class="ef-clear" bindtap="clearLocation">清除</text>
</view>

<view class="ef-sub">联系人</view>
<view class="ef-row">
  <text class="label">姓名</text>
  <input class="ef-in" value="{{v.contact.name}}" data-k="contact.name" bindinput="onInput" maxlength="20" placeholder="选填" />
</view>
<view class="ef-row">
  <text class="label">电话</text>
  <input class="ef-in" type="number" value="{{v.contact.phone}}" data-k="contact.phone" bindinput="onInput" maxlength="20" placeholder="选填" />
</view>
<view class="ef-row">
  <text class="label">微信号</text>
  <input class="ef-in" value="{{v.contact.wechat}}" data-k="contact.wechat" bindinput="onInput" maxlength="40" placeholder="选填" />
</view>
<view class="ef-row top">
  <text class="label">谁能看到</text>
  <view class="ef-vis">
    <view class="ef-v {{v.contact.visibility === 'participants' ? 'on' : ''}}" data-v="participants" bindtap="setVis">仅报名者和参赛者</view>
    <view class="ef-v {{v.contact.visibility === 'all' ? 'on' : ''}}" data-v="all" bindtap="setVis">所有能打开赛事的人</view>
  </view>
</view>
<view class="ef-note">联系方式只对上面选择的范围展示；{{v.contact.visibility === 'all' ? '选「所有人」后，拿到分享链接的人都能看到电话和微信号' : '没报名的人只能看到姓氏，看不到电话和微信号'}}。不填则不展示。</view>
