<view class="ms-mask" bindtap="close" catchtouchmove="noop"></view>
<view class="ms">
  <view class="ms-h"><text class="ms-t">{{title}}</text><text class="ms-s">{{sub}}</text></view>
  <input class="ms-q" placeholder="搜索球员" placeholder-class="ms-ph" value="{{q}}" bindinput="onQ" confirm-type="search" />
  <scroll-view scroll-y class="ms-list">
    <view class="ms-chips">
      <view wx:for="{{shown}}" wx:key="uid" class="ms-chip {{item.on ? 'on' : ''}} {{item.off ? 'off' : ''}}" hover-class="tap-on" data-uid="{{item.uid}}" bindtap="tap">
        <pl-av class="avatar sm ms-av" uid="{{item.uid}}" name="{{item.name}}" />
        <text class="ms-n">{{item.name}}</text><text wx:if="{{item.g}}" class="gd ms-g">{{item.g}}</text>
        <text wx:if="{{item.tag}}" class="ms-tag">{{item.tag}}</text>
      </view>
    </view>
    <view wx:if="{{!shown.length}}" class="ms-none">{{q ? '没有找到「' + q + '」' : empty}}</view>
  </scroll-view>
  <view class="ms-acts">
    <view class="btn-line ms-a" hover-class="tap-on" bindtap="close">取消</view>
    <view wx:if="{{multi}}" class="btn-primary ms-a" hover-class="tap-on" bindtap="confirm">确定</view>
    <view wx:elif="{{extra}}" class="btn-line ms-a" hover-class="tap-on" bindtap="more">{{extra}}</view>
  </view>
</view>
