{
  "pages": [
    "pages/draw/draw",
    "pages/index/index",
    "pages/rank/rank",
    "pages/me/me",
    "pages/draw-view/draw-view",
    "pages/challenge/challenge",
    "pages/player/player",
    "pages/gate/gate",
    "pages/racket/racket"
  ],
  "subpackages": [
    {
      "root": "pkg-tools",
      "name": "tools",
      "pages": [
        "report/report",
        "racket-view/racket-view",
        "racket-edit/racket-edit",
        "racket-log/racket-log",
        "racket-tune/racket-tune",
        "racket-lab/racket-lab",
        "aa/aa",
        "mixer/mixer"
      ]
    },
    {
      "root": "pkg-manage",
      "name": "manage",
      "pages": [
        "draw-new/draw-new",
        "event-edit/event-edit",
        "cup-edit/cup-edit",
        "cup-mine/cup-mine",
        "members/members",
        "growth/growth",
        "growth-edit/growth-edit",
        "history/history",
        "correct/correct",
        "match/match",
        "score/score",
        "add/add",
        "profile/profile",
        "scorer/scorer"
      ]
    }
  ],
  "preloadRule": {
    "pages/draw/draw": {
      "network": "all",
      "packages": [
        "pkg-tools",
        "pkg-manage"
      ]
    },
    "pages/draw-view/draw-view": {
      "network": "all",
      "packages": [
        "pkg-tools",
        "pkg-manage"
      ]
    },
    "pages/index/index": {
      "network": "all",
      "packages": [
        "pkg-tools",
        "pkg-manage"
      ]
    },
    "pages/rank/rank": {
      "network": "all",
      "packages": [
        "pkg-tools",
        "pkg-manage"
      ]
    },
    "pages/racket/racket": {
      "network": "all",
      "packages": [
        "pkg-tools",
        "pkg-manage"
      ]
    },
    "pages/me/me": {
      "network": "all",
      "packages": [
        "pkg-tools",
        "pkg-manage"
      ]
    },
    "pages/gate/gate": {
      "network": "all",
      "packages": [
        "pkg-manage"
      ]
    }
  },
  "window": {
    "navigationBarBackgroundColor": "#A3A3CB",
    "navigationBarTextStyle": "white",
    "navigationBarTitleText": "LULU 网球",
    "backgroundColor": "#F0F0F7",
    "backgroundTextStyle": "dark"
  },
  "tabBar": {
    "color": "#8C8CA3",
    "selectedColor": "#6E6EA3",
    "backgroundColor": "#ffffff",
    "borderStyle": "white",
    "list": [
      {
        "pagePath": "pages/draw/draw",
        "text": "活动",
        "iconPath": "images/tab/draw.png",
        "selectedIconPath": "images/tab/draw-on.png"
      },
      {
        "pagePath": "pages/index/index",
        "text": "战绩",
        "iconPath": "images/tab/record.png",
        "selectedIconPath": "images/tab/record-on.png"
      },
      {
        "pagePath": "pages/rank/rank",
        "text": "排行",
        "iconPath": "images/tab/rank.png",
        "selectedIconPath": "images/tab/rank-on.png"
      },
      {
        "pagePath": "pages/racket/racket",
        "text": "球拍",
        "iconPath": "images/tab/racket.png",
        "selectedIconPath": "images/tab/racket-on.png"
      },
      {
        "pagePath": "pages/me/me",
        "text": "我的",
        "iconPath": "images/tab/me.png",
        "selectedIconPath": "images/tab/me-on.png"
      }
    ]
  },
  "style": "v2",
  "sitemapLocation": "sitemap.json",
  "lazyCodeLoading": "requiredComponents",
  "usingComponents": {
    "pl-av": "/components/pl-av/pl-av"
  },
  "requiredPrivateInfos": [
    "chooseLocation"
  ]
}
